# NieR (2026-11-04): Renut's Direct3D-level renderer (github.com/masterspike52/reNut, GPL-3.0, through banjo-nx,
# sa2-nx and mgr-nx-deko; THIRD_PARTY_NOTICES.md), retargeted to NieR's Direct3D (src/renut_engine, addresses and
# device layout from work/renut-tools/nier_hook_map.md). PC only. Chosen at boot with nier_renderer = "renut";
# "xenos" (the default) keeps the emulated GPU.
#
# From mgr-nx-deko's cmake/mgr_renut_gpu.cmake: Renut's gpu.cmake with its dependencies where it looks for them
# (thirdparty/plume, thirdparty/reblue-XenosRecomp, thirdparty/imgui, cmake/collect_captured_shaders.cmake).
#
# An OBJECT library, not a static one: its hooks replace the generated code's weak sub_X definitions, and a static
# archive's members are only pulled in for undefined symbols, so the hooks would silently not be linked.

# NieR's shaders are game data, on the player's machine only (never in the repo). NIER_RENUT_SHADER_DIR: a folder of
# shader containers (.bin, as Renut captures them: renut_shader_capture_dir, by default shader_capture/ beside the
# executable); the build translates them with XenosRecomp into the cache (gpu.cmake, renut_xenos_shader_cache) and adds
# the build directory's new captures to it. Unset: an empty cache (src/renut_compat/shader_cache_empty.cpp), enough to
# build and start Renut, which then captures every shader the game creates.
set(NIER_RENUT_SHADER_DIR "" CACHE PATH "NieR's shader containers for Renut's cache (outside the repo); empty = none")
# Without a shader folder: the player's copy of the game (an .iso or the extracted folder) to extract them from.
set(NIER_GAME_PATH "" CACHE PATH "The player's NieR (Xbox 360) .iso or extracted folder, for Renut's shaders")
# Android (2026-11-07): XenosRecomp is a host tool and the cross build cannot run it, so the phone build takes the cache
# a PC build already generated (its renut_gpu/shader_cache.cpp: DXIL and SPIR-V, the phone reads the SPIR-V).
set(NIER_RENUT_SHADER_CACHE_CPP "" CACHE FILEPATH "A shader_cache.cpp generated by another (PC) build; empty = none")
if(NIER_RENUT_SHADER_CACHE_CPP)
    function(banjo_renut_shader_cache_override TARGET)
        target_sources(${TARGET} PRIVATE "${NIER_RENUT_SHADER_CACHE_CPP}")
        set_source_files_properties("${NIER_RENUT_SHADER_CACHE_CPP}" PROPERTIES SKIP_PRECOMPILE_HEADERS ON)
    endfunction()
elseif(NIER_RENUT_SHADER_DIR AND NOT ANDROID)
    set(RENUT_SHADER_DUMP_DIR "${NIER_RENUT_SHADER_DIR}" CACHE PATH "" FORCE)
    # banjo-nx's early alpha pass needs its tools/renut_early_alpha.py, not carried here.
    set(BANJO_RENUT_EARLY_ALPHA OFF CACHE BOOL "" FORCE)
elseif(NIER_GAME_PATH AND NOT ANDROID)
    # NieR (2026-11-14): the player's own copy (.iso or extracted folder): tools/shader_extract pulls the shaders of
    # its default.xex into the build directory, and Renut's captures while playing add the rest at the next build
    # (gpu.cmake, step 2). See tools/shader_extract/shader_extract.cpp for why the archives' shaders are not taken.
    set(RENUT_SHADER_DUMP_DIR "${CMAKE_BINARY_DIR}/game_shaders" CACHE PATH "" FORCE)
    set(BANJO_RENUT_EARLY_ALPHA OFF CACHE BOOL "" FORCE)
    set(NIER_SHADER_EXTRACT ON)
else()
    function(banjo_renut_shader_cache_override TARGET)
        target_sources(${TARGET} PRIVATE "${CMAKE_SOURCE_DIR}/src/renut_compat/shader_cache_empty.cpp")
    endfunction()
endif()

# Renut's XenosRecomp is built as an ExternalProject (gpu.cmake), with this build's host toolchain.
set(BANJO_RENUT_XENOS_RECOMP_ARGS "")
foreach(_nier_var CMAKE_C_COMPILER_TARGET CMAKE_CXX_COMPILER_TARGET CMAKE_LINKER_TYPE CMAKE_C_FLAGS CMAKE_CXX_FLAGS
                  CMAKE_AR CMAKE_RC_COMPILER CMAKE_MT)
    if(DEFINED ${_nier_var} AND NOT "${${_nier_var}}" STREQUAL "")
        list(APPEND BANJO_RENUT_XENOS_RECOMP_ARGS "-D${_nier_var}=${${_nier_var}}")
    endif()
endforeach()

# Renut's SDK exports o1heap as rex::o1heap.
if(TARGET o1heap AND NOT TARGET rex::o1heap)
    add_library(rex::o1heap ALIAS o1heap)
endif()

if(NOT Python3_EXECUTABLE)
    find_package(Python3 COMPONENTS Interpreter REQUIRED)
endif()
if(NOT PYTHON_EXECUTABLE)
    set(PYTHON_EXECUTABLE "${Python3_EXECUTABLE}")
endif()

include("${CMAKE_SOURCE_DIR}/src/renut_engine/gpu/gpu.cmake")

add_library(nier_renut_gpu OBJECT
    "${CMAKE_SOURCE_DIR}/src/renut_engine/gpu/banjo_renut_select.cpp"
    "${CMAKE_SOURCE_DIR}/src/renut_engine/gpu/banjo_renut_tuning.cpp"
    "${CMAKE_SOURCE_DIR}/src/renut_engine/gpu/banjo_renut_checks.cpp"
    "${CMAKE_SOURCE_DIR}/src/renut_engine/gpu/banjo_renut_record.cpp"
    "${CMAKE_SOURCE_DIR}/src/renut_engine/display_sync.cpp"
    "${CMAKE_SOURCE_DIR}/src/renut_engine/perf/frame_stats.cpp"
    "${CMAKE_SOURCE_DIR}/src/renut_engine/sa2_compat/frame_latency.cpp"
    "${CMAKE_SOURCE_DIR}/src/renut_engine/sa2_compat/sa2_compat.cpp"
    "${CMAKE_SOURCE_DIR}/src/renut_engine/gpu/sa2_renut_pacing.cpp"
    # NieR: the SA2 app pieces Renut calls, and the hooks it shares with the app.
    "${CMAKE_SOURCE_DIR}/src/renut_compat/nier_renut_compat.cpp"
    "${CMAKE_SOURCE_DIR}/src/renut_compat/nier_renut_hooks.cpp")
target_include_directories(nier_renut_gpu PRIVATE
    "${CMAKE_SOURCE_DIR}"
    "${CMAKE_SOURCE_DIR}/src"
    "${CMAKE_SOURCE_DIR}/src/renut_compat"
    "${CMAKE_SOURCE_DIR}/src/renut_engine/sa2_compat"
    "${REXGLUE_ENTRYPOINT_INCLUDE_DIR}"
    "${REXSDK_DIR}/src/core")
target_link_libraries(nier_renut_gpu PRIVATE rex::runtime)
if(ANDROID AND REXSDK_DIR)
    # As for nier itself (CMakeLists.txt): the SDK's source tree doesn't export ImGui's headers.
    target_include_directories(nier_renut_gpu PRIVATE "${REXSDK_DIR}/thirdparty/imgui")
endif()
if(COMMAND rexglue_apply_target_settings)
    rexglue_apply_target_settings(nier_renut_gpu)
endif()
renut_gpu_setup(nier_renut_gpu)
target_compile_definitions(nier_renut_gpu PRIVATE NIER_RENUT_RENDERER=1 MGR_RENUT_RENDERER=1 SA2_RENUT_RENDERER=1)
if(CMAKE_CXX_COMPILER_ID MATCHES "GNU|Clang")
    target_compile_options(nier_renut_gpu PRIVATE -ffp-contract=off -fno-strict-aliasing)
endif()
# Bring-up: line tables for Renut's code and a PDB, so a crash address resolves (llvm-symbolizer).
if(WIN32 AND CMAKE_CXX_COMPILER_ID MATCHES "Clang")
    target_compile_options(nier_renut_gpu PRIVATE -gline-tables-only -gcodeview)
    target_link_options(nier PRIVATE "LINKER:/DEBUG")
endif()

target_link_libraries(nier PRIVATE nier_renut_gpu)

# NieR (2026-11-15, Android): Turnip, Mesa's open Adreno driver, loaded through libadrenotools (BSD-2;
# thirdparty/libadrenotools, git clone --recurse-submodules github.com/bylaws/libadrenotools). Its hook libraries
# (libhook_impl, libmain_hook, libfile_redirect_hook, libgsl_alloc_hook) go into the APK beside libmain.so
# (android/build-apk.ps1). Optional: without the folder the system driver is the only one.
if(ANDROID AND EXISTS "${CMAKE_SOURCE_DIR}/thirdparty/libadrenotools/CMakeLists.txt")
    add_subdirectory("${CMAKE_SOURCE_DIR}/thirdparty/libadrenotools" "${CMAKE_BINARY_DIR}/libadrenotools")
    target_sources(nier PRIVATE "${CMAKE_SOURCE_DIR}/src/renut_engine/gpu/backend/android_driver.cpp")
    target_link_libraries(nier PRIVATE adrenotools)
    add_dependencies(nier main_hook file_redirect_hook gsl_alloc_hook hook_impl)
endif()
target_include_directories(nier PRIVATE "${CMAKE_SOURCE_DIR}/src" "${CMAKE_SOURCE_DIR}/src/renut_compat")
target_compile_definitions(nier PRIVATE NIER_RENUT_RENDERER=1)
