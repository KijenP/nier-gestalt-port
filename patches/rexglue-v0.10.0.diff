+// TEMP GPU stage timing (NIER_GPU_PROF=1).
+void VulkanCommandProcessor::ProfInitialize() {
+  const char* env = std::getenv("NIER_GPU_PROF");
+  prof_enabled_ = env && std::atoi(env) != 0;
+  const char* report_env = std::getenv("NIER_FRAME_REPORT");
+  report_target_ = report_env ? std::strtoull(report_env, nullptr, 10) : 0;
+  report_enabled_ = report_target_ != 0;
+  report_frame_ = 0;
+  report_capturing_ = report_closed_ = report_written_ = false;
+  prof_enabled_ |= report_enabled_;
+  if (!prof_enabled_) {
+    return;
+  }
+  const ui::vulkan::VulkanDevice* vulkan_device = GetVulkanDevice();
+  const ui::vulkan::VulkanDevice::Functions& dfn = vulkan_device->functions();
+  VkPhysicalDeviceProperties properties;
+  vulkan_device->vulkan_instance()->functions().vkGetPhysicalDeviceProperties(
+      vulkan_device->physical_device(), &properties);
+  if (!properties.limits.timestampComputeAndGraphics) {
+    REXGPU_WARN("GPUPROF: timestamps not supported");
+    prof_enabled_ = false;
+    return;
+  }
+  prof_period_ns_ = properties.limits.timestampPeriod;
+  VkQueryPoolCreateInfo pool_info = {};
+  pool_info.sType = VK_STRUCTURE_TYPE_QUERY_POOL_CREATE_INFO;
+  pool_info.queryType = VK_QUERY_TYPE_TIMESTAMP;
+  pool_info.queryCount = kProfSlots * kProfQueriesPerSlot;
+  if (dfn.vkCreateQueryPool(vulkan_device->device(), &pool_info, nullptr, &prof_pool_) !=
+      VK_SUCCESS) {
+    REXGPU_WARN("GPUPROF: failed to create the timestamp query pool");
+    prof_enabled_ = false;
+    return;
+  }
+  prof_slots_.resize(kProfSlots);
+  for (ProfSlot& slot : prof_slots_) {
+    slot.stages.resize(kProfQueriesPerSlot);
+    slot.tags.resize(kProfQueriesPerSlot, UINT32_MAX);
+    slot.counts.resize(kProfQueriesPerSlot, 0);
+  }
+  const char* draws_env = std::getenv("NIER_GPU_PROF_DRAWS");
+  prof_draws_ = draws_env && std::atoi(draws_env) != 0;
+  const char* passes_env = std::getenv("NIER_GPU_PROF_PASSES");
+  prof_passes_ = passes_env && std::atoi(passes_env) != 0;
+  prof_draws_ |= prof_passes_ || report_enabled_;
+  if (report_enabled_) {
+    REXGPU_INFO("FRAMEREPORT: will capture frame {}", report_target_);
+  }
+  REXGPU_INFO("GPUPROF: enabled, timestamp period {} ns", prof_period_ns_);
+}
+
+void VulkanCommandProcessor::ProfShutdown() {
+  if (prof_pool_ != VK_NULL_HANDLE) {
+    const ui::vulkan::VulkanDevice* vulkan_device = GetVulkanDevice();
+    vulkan_device->functions().vkDestroyQueryPool(vulkan_device->device(), prof_pool_, nullptr);
+    prof_pool_ = VK_NULL_HANDLE;
+  }
+  prof_slots_.clear();
+  prof_current_slot_ = nullptr;
+  prof_enabled_ = false;
+}
+
+void VulkanCommandProcessor::ProfDraw(uint64_t vertex_shader_hash, uint64_t pixel_shader_hash,
+                                      uint32_t index_count) {
+  // NIER_GPU_PROF_PASSES: tiled GPUs run a pass at its end, so only whole
+  // passes (tagged when they begin) are timed, not draws.
+  if (prof_passes_) {
+    prof_pass_draws_++;
+    prof_pass_pixel_shaders_ ^= pixel_shader_hash;
+    return;
+  }
+  ProfTagged(ProfStage::kDraw, vertex_shader_hash, pixel_shader_hash, index_count);
+}
+
+void VulkanCommandProcessor::ProfTagged(ProfStage stage, uint64_t vertex_shader_hash,
+                                        uint64_t pixel_shader_hash, uint32_t index_count) {
+  if (!prof_enabled_ || !prof_draws_) {
+    return;
+  }
+  uint64_t key = vertex_shader_hash * 0x9E3779B97F4A7C15ull ^ pixel_shader_hash;
+  auto it = prof_tag_index_.find(key);
+  if (it == prof_tag_index_.end()) {
+    it = prof_tag_index_.emplace(key, uint32_t(prof_tags_.size())).first;
+    ProfTag& tag = prof_tags_.emplace_back();
+    tag.vs = vertex_shader_hash;
+    tag.ps = pixel_shader_hash;
+  }
+  ++prof_tags_[it->second].draws;
+  prof_tags_[it->second].indices += index_count;
+  // Force a new mark even if already in the stage.
+  prof_stage_ = ProfStage::kCount;
+  prof_tag_ = it->second;
+  prof_tag_stage_ = stage;
+  prof_pending_count_ = index_count;
+  ProfMark(stage);
+  prof_pending_count_ = 0;
+}
+
+void VulkanCommandProcessor::ProfMark(ProfStage stage) {
+  if (!prof_enabled_ || stage == prof_stage_) {
+    return;
+  }
+  prof_stage_ = stage;
+  // The tag stays across barriers within its stage.
+  uint32_t tag = UINT32_MAX;
+  if (prof_tag_ != UINT32_MAX) {
+    if (stage == prof_tag_stage_) {
+      tag = prof_tag_;
+    } else if (stage != ProfStage::kBarrier) {
+      prof_tag_ = UINT32_MAX;
+    }
+  }
+  if (!prof_current_slot_ || !submission_open_) {
+    return;
+  }
+  ProfSlot& slot = *prof_current_slot_;
+  // Keep the last query for the end of the submission.
+  if (slot.count >= kProfQueriesPerSlot - 1) {
+    ++prof_overflow_;
+    return;
+  }
+  uint32_t slot_index = uint32_t(prof_current_slot_ - prof_slots_.data());
+  slot.stages[slot.count] = uint8_t(stage);
+  slot.tags[slot.count] = tag;
+  slot.counts[slot.count] = prof_pending_count_;
+  deferred_command_buffer_.CmdVkWriteTimestamp(VK_PIPELINE_STAGE_BOTTOM_OF_PIPE_BIT, prof_pool_,
+                                               slot_index * kProfQueriesPerSlot + slot.count);
+  ++slot.count;
+}
+
+void VulkanCommandProcessor::ProfBeginSubmission() {
+  prof_current_slot_ = nullptr;
+  if (!prof_enabled_) {
+    return;
+  }
+  uint64_t submission = GetCurrentSubmission();
+  uint32_t slot_index = uint32_t(submission % kProfSlots);
+  ProfSlot& slot = prof_slots_[slot_index];
+  if (slot.submission) {
+    // Previous use of the slot not collected yet.
+    ++prof_skipped_;
+    return;
+  }
+  slot.submission = submission;
+  slot.count = 0;
+  prof_current_slot_ = &slot;
+  deferred_command_buffer_.CmdVkResetQueryPool(prof_pool_, slot_index * kProfQueriesPerSlot,
+                                               kProfQueriesPerSlot);
+  // Opening timestamp, attributed to the current stage.
+  ProfStage stage = prof_stage_;
+  prof_stage_ = ProfStage::kCount;
+  ProfMark(stage);
+}
+
+void VulkanCommandProcessor::ProfEndSubmission() {
+  if (!prof_current_slot_) {
+    return;
+  }
+  ProfSlot& slot = *prof_current_slot_;
+  uint32_t slot_index = uint32_t(prof_current_slot_ - prof_slots_.data());
+  slot.stages[slot.count] = uint8_t(ProfStage::kCount);
+  deferred_command_buffer_.CmdVkWriteTimestamp(VK_PIPELINE_STAGE_BOTTOM_OF_PIPE_BIT, prof_pool_,
+                                               slot_index * kProfQueriesPerSlot + slot.count);
+  ++slot.count;
+  prof_current_slot_ = nullptr;
+}
+
+void VulkanCommandProcessor::ProfCollect() {
+  if (!prof_enabled_) {
+    return;
+  }
+  const ui::vulkan::VulkanDevice* vulkan_device = GetVulkanDevice();
+  const ui::vulkan::VulkanDevice::Functions& dfn = vulkan_device->functions();
+  std::vector<uint64_t> values;
+  for (uint32_t i = 0; i < kProfSlots; ++i) {
+    ProfSlot& slot = prof_slots_[i];
+    if (!slot.submission || slot.submission > submission_completed_ ||
+        &slot == prof_current_slot_) {
+      continue;
+    }
+    if (slot.count >= 2) {
+      values.resize(slot.count);
+      if (dfn.vkGetQueryPoolResults(vulkan_device->device(), prof_pool_, i * kProfQueriesPerSlot,
+                                    slot.count, sizeof(uint64_t) * slot.count, values.data(),
+                                    sizeof(uint64_t), VK_QUERY_RESULT_64_BIT) == VK_SUCCESS) {
+        for (uint32_t j = 0; j + 1 < slot.count; ++j) {
+          if (values[j + 1] >= values[j] && slot.stages[j] < uint8_t(ProfStage::kCount)) {
+            prof_ticks_[slot.stages[j]] += double(values[j + 1] - values[j]);
+            if (slot.tags[j] < prof_tags_.size()) {
+              prof_tags_[slot.tags[j]].ticks += double(values[j + 1] - values[j]);
+            }
+          }
+        }
+        if (report_enabled_ && (report_capturing_ || report_closed_) && !report_written_) {
+          ReportAddSlot(slot, values);
+        }
+        prof_marks_ += slot.count;
+        ++prof_submissions_;
+      }
+    }
+    slot.submission = 0;
+  }
+  if (report_closed_ && !report_written_ && submission_completed_ >= report_last_sub_) {
+    ReportWrite();
+  }
+}
+
+void VulkanCommandProcessor::ProfRenderPassBegin(
+    const VulkanRenderTargetCache::Framebuffer* framebuffer, uint32_t attachments) {
+  if (!prof_enabled_ || !framebuffer) {
+    return;
+  }
+  ++prof_rp_begins_;
+  // Load + store of every attachment, 4 bytes per pixel (tile memory in and out).
+  prof_rp_attachments_ = std::max(attachments, 1u);
+  prof_rp_current_bytes_ = std::max<uint64_t>(1, uint64_t(framebuffer->host_extent.width) *
+                                                     framebuffer->host_extent.height *
+                                                     prof_rp_attachments_ * 4 * 2);
+  prof_rp_bytes_ += prof_rp_current_bytes_;
+  ++prof_rp_extents_[std::make_pair(framebuffer->host_extent.width,
+                                    framebuffer->host_extent.height)];
+  prof_rp_x0_ = prof_rp_y0_ = INT32_MAX;
+  prof_rp_x1_ = prof_rp_y1_ = INT32_MIN;
+}
+
+void VulkanCommandProcessor::ProfRenderPassDraw() {
+  if (!prof_enabled_ || !prof_rp_current_bytes_) {
+    return;
+  }
+  // Scissor clipped by the viewport.
+  int32_t x0 = std::max(dynamic_scissor_.offset.x, int32_t(std::floor(dynamic_viewport_.x)));
+  int32_t y0 = std::max(dynamic_scissor_.offset.y, int32_t(std::floor(dynamic_viewport_.y)));
+  int32_t x1 = std::min(dynamic_scissor_.offset.x + int32_t(dynamic_scissor_.extent.width),
+                        int32_t(std::ceil(dynamic_viewport_.x + dynamic_viewport_.width)));
+  int32_t y1 = std::min(dynamic_scissor_.offset.y + int32_t(dynamic_scissor_.extent.height),
+                        int32_t(std::ceil(dynamic_viewport_.y + dynamic_viewport_.height)));
+  if (x1 <= x0 || y1 <= y0) {
+    return;
+  }
+  prof_rp_x0_ = std::min(prof_rp_x0_, x0);
+  prof_rp_y0_ = std::min(prof_rp_y0_, y0);
+  prof_rp_x1_ = std::max(prof_rp_x1_, x1);
+  prof_rp_y1_ = std::max(prof_rp_y1_, y1);
+}
+
+void VulkanCommandProcessor::ProfRenderPassEnd(const void* ender) {
+  if (!prof_enabled_ || !prof_rp_current_bytes_) {
+    return;
+  }
+  if (report_pass_open_) {
+    report_pass_open_ = false;
+    if (report_capturing_ && !report_pass_areas_.empty() && prof_rp_x1_ > prof_rp_x0_ &&
+        prof_rp_y1_ > prof_rp_y0_) {
+      report_pass_areas_.back() = {std::max(prof_rp_x0_, 0), std::max(prof_rp_y0_, 0), prof_rp_x1_,
+                                   prof_rp_y1_};
+    }
+  }
+  if (prof_rp_x1_ > prof_rp_x0_ && prof_rp_y1_ > prof_rp_y0_) {
+    uint64_t w = uint64_t(std::min(prof_rp_x1_, 1280 * 8) - std::max(prof_rp_x0_, 0));
+    uint64_t h = uint64_t(std::min(prof_rp_y1_, 2048 * 8) - std::max(prof_rp_y0_, 0));
+    prof_rp_used_bytes_ += std::min(w * h * prof_rp_attachments_ * 4 * 2, prof_rp_current_bytes_);
+    if (prof_rp_area_log_ < 40) {
+      ++prof_rp_area_log_;
+      REXGPU_INFO("RPDBG pass area x {}..{} y {}..{} draws {}", prof_rp_x0_, prof_rp_x1_,
+                  prof_rp_y0_, prof_rp_y1_, prof_rp_draws_);
+    }
+  } else {
+    prof_rp_used_bytes_ += prof_rp_current_bytes_;  // Transfers etc.: unknown, count all.
+  }
+  ++prof_rp_ends_[std::make_pair(reinterpret_cast<uintptr_t>(ender),
+                                 reinterpret_cast<uintptr_t>(prof_rp_first_barrier_pusher_))];
+  uint32_t d = prof_rp_draws_;
+  ++prof_rp_draw_hist_[d == 0 ? 0 : d == 1 ? 1 : d <= 4 ? 2 : d <= 15 ? 3 : 4];
+  if (d <= 1) {
+    prof_rp_empty_bytes_ += prof_rp_current_bytes_;
+  }
+  prof_rp_current_bytes_ = 0;
+}
+
+void VulkanCommandProcessor::ProfFrame() {
+  ReportFrameBoundary();
+  if (!prof_enabled_ || ++prof_frames_ < 120) {
+    return;
+  }
+  {  // TEMP (RPDBG): render pass breaks.
+    auto where = [](uintptr_t address) -> std::string {
+      if (address <= 2) {
+        return address == 1 ? "target-switch" : address == 2 ? "transfer-pass" : "-";
+      }
+#if !REX_PLATFORM_WIN32
+      Dl_info info;
+      if (dladdr(reinterpret_cast<const void*>(address), &info) && info.dli_fname) {
+        const char* name = std::strrchr(info.dli_fname, '/');
+        return fmt::format("{}+{:X}", name ? name + 1 : info.dli_fname,
+                           address - reinterpret_cast<uintptr_t>(info.dli_fbase));
+      }
+#endif
+      return fmt::format("{:X}", address);
+    };
+    double f = double(prof_frames_);
+    REXGPU_INFO(
+        "RPDBG per frame: passes={:.1f} load+store={:.0f}MB (passes with <=1 draw: {:.0f}MB) "
+        "draws/pass 0:{:.1f} 1:{:.1f} 2-4:{:.1f} 5-15:{:.1f} 16+:{:.1f}",
+        prof_rp_begins_ / f, prof_rp_bytes_ / f / 1048576.0, prof_rp_empty_bytes_ / f / 1048576.0,
+        prof_rp_draw_hist_[0] / f, prof_rp_draw_hist_[1] / f, prof_rp_draw_hist_[2] / f,
+        prof_rp_draw_hist_[3] / f, prof_rp_draw_hist_[4] / f);
+    std::string extents;
+    for (const auto& entry : prof_rp_extents_) {
+      extents += fmt::format(" {}x{}:{:.1f}", entry.first.first, entry.first.second,
+                             entry.second / f);
+    }
+    REXGPU_INFO("RPDBG per frame: load+store inside the draw scissors={:.0f}MB; stencil draws={:.1f}; extents{}",
+                prof_rp_used_bytes_ / f / 1048576.0, prof_stencil_draws_ / f, extents);
+    prof_stencil_draws_ = 0;
+    prof_rp_extents_.clear();
+    prof_rp_used_bytes_ = 0;
+    std::vector<std::pair<uint32_t, std::pair<uintptr_t, uintptr_t>>> sorted;
+    for (const auto& entry : prof_rp_ends_) {
+      sorted.emplace_back(entry.second, entry.first);
+    }
+    std::sort(sorted.rbegin(), sorted.rend());
+    for (size_t i = 0; i < sorted.size() && i < 16; ++i) {
+      REXGPU_INFO("RPDBG end {:.1f}/frame: ended by {} first barrier from {}", sorted[i].first / f,
+                  where(sorted[i].second.first), where(sorted[i].second.second));
+    }
+    prof_rp_ends_.clear();
+    prof_rp_begins_ = prof_rp_bytes_ = prof_rp_empty_bytes_ = 0;
+    std::fill(std::begin(prof_rp_draw_hist_), std::end(prof_rp_draw_hist_), 0);
+  }
+  double scale = prof_period_ns_ / 1.0e6 / double(prof_frames_);
+  double ms[size_t(ProfStage::kCount)];
+  double total = 0.0;
+  for (size_t i = 0; i < size_t(ProfStage::kCount); ++i) {
+    ms[i] = prof_ticks_[i] * scale;
+    total += ms[i];
+  }
+  REXGPU_INFO(
+      "GPUPROF frames={} subs/f={:.1f} marks/f={:.0f} skipped={} overflow={} total={:.2f} "
+      "draw={:.2f} transfer={:.2f} rclear={:.2f} dump={:.2f} copy={:.2f} direct={:.2f} "
+      "rother={:.2f} tex={:.2f} texres={:.2f} upload={:.2f} present={:.2f} barrier={:.2f}",
+      prof_frames_, double(prof_submissions_) / double(prof_frames_),
+      double(prof_marks_) / double(prof_frames_), prof_skipped_, prof_overflow_, total,
+      ms[size_t(ProfStage::kDraw)], ms[size_t(ProfStage::kTransfer)],
+      ms[size_t(ProfStage::kResolveClear)], ms[size_t(ProfStage::kResolveDump)],
+      ms[size_t(ProfStage::kResolveCopy)], ms[size_t(ProfStage::kResolveDirect)],
+      ms[size_t(ProfStage::kResolveOther)], ms[size_t(ProfStage::kTextureLoad)],
+      ms[size_t(ProfStage::kTextureLoadResolved)], ms[size_t(ProfStage::kUpload)],
+      ms[size_t(ProfStage::kPresent)], ms[size_t(ProfStage::kBarrier)]);
+  {  // TEMP WAITDBG: where the wall time of a frame goes.
+    static auto last_report = std::chrono::steady_clock::now();
+    auto now = std::chrono::steady_clock::now();
+    double wall_ms =
+        std::chrono::duration<double, std::milli>(now - last_report).count() / prof_frames_;
+    last_report = now;
+    double per_frame = 1.0e-3 / prof_frames_;
+    REXGPU_INFO(
+        "WAITDBG per frame: wall={:.2f} ms gpu_thread_idle={:.2f} game_waits_readback={:.2f} "
+        "gpu_thread_waits_gpu={:.2f} upload={:.2f} MB",
+        wall_ms, g_waitdbg_idle_us.exchange(0) * per_frame,
+        g_waitdbg_lazy_us.exchange(0) * per_frame, g_waitdbg_fence_us.exchange(0) * per_frame,
+        g_waitdbg_upload_bytes.exchange(0) / 1048576.0 / prof_frames_);
+  }
+  {  // TEMP: barrier histogram.
+    std::vector<std::pair<uint32_t, uint64_t>> sorted;
+    for (const auto& entry : prof_barrier_histogram_) {
+      sorted.emplace_back(entry.second, entry.first);
+    }
+    std::sort(sorted.rbegin(), sorted.rend());
+    std::string top;
+    for (size_t i = 0; i < sorted.size() && i < 10; ++i) {
+      top += fmt::format(" {:X}->{:X}:{:.1f}", uint32_t(sorted[i].second >> 32),
+                         uint32_t(sorted[i].second), double(sorted[i].first) / prof_frames_);
+    }
+    REXGPU_INFO("GPUBARRIERS per frame: commands={:.1f} buffers={:.1f} images={:.1f} top(src->dst:n){}",
+                double(prof_barrier_commands_) / prof_frames_,
+                double(prof_barrier_buffers_) / prof_frames_,
+                double(prof_barrier_images_) / prof_frames_, top);
+    prof_barrier_histogram_.clear();
+    prof_barrier_commands_ = prof_barrier_buffers_ = prof_barrier_images_ = 0;
+  }
+  if (prof_draws_) {  // TEMP: most expensive shader pairs.
+    std::vector<uint32_t> order(prof_tags_.size());
+    for (uint32_t i = 0; i < order.size(); ++i) {
+      order[i] = i;
+    }
+    std::sort(order.begin(), order.end(), [this](uint32_t a, uint32_t b) {
+      return prof_tags_[a].ticks > prof_tags_[b].ticks;
+    });
+    double ms_scale = prof_period_ns_ / 1.0e6 / double(prof_frames_);
+    for (size_t i = 0; i < order.size() && i < 60; ++i) {
+      const ProfTag& tag = prof_tags_[order[i]];
+      if (!tag.draws) {
+        continue;
+      }
+      REXGPU_INFO("GPUDRAWS vs={:016X} ps={:016X} ms={:.2f} draws={:.1f} indices={:.0f}", tag.vs,
+                  tag.ps, tag.ticks * ms_scale, double(tag.draws) / prof_frames_,
+                  double(tag.indices) / prof_frames_);
+    }
+    for (ProfTag& tag : prof_tags_) {
+      tag.ticks = 0;
+      tag.draws = tag.indices = 0;
+    }
+  }
+  std::memset(prof_ticks_, 0, sizeof(prof_ticks_));
+  prof_marks_ = 0;
+  prof_frames_ = 0;
+  prof_submissions_ = 0;
+  prof_skipped_ = 0;
+  prof_overflow_ = 0;
+}
