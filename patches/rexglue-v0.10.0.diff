-              default:
-                assert_unhandled_case(instr.attributes.signed_rf_mode);
-            }
-          } else {
-            a_.OpMul(result_unpacked_dest, result_src, dxbc::Src::LF(1.0f / 4294967295.0f));
-          }
-        }
