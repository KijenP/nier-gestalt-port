+uint32_t SpirvBuilder::relaxFloatResults(
+    const std::vector<std::pair<spv::Id, spv::Id>>& id_ranges) {
+  uint32_t relaxed_count = 0;
+  if (id_ranges.empty()) {
+    return relaxed_count;
+  }
+  for (spv::Function* function : module.getFunctions()) {
+    for (spv::Block* block : function->getBlocks()) {
+      for (const std::unique_ptr<spv::Instruction>& instruction : block->getInstructions()) {
+        relaxed_count += uint32_t(relaxFloatResult(*instruction, id_ranges));
+      }
+    }
+  }
+  return relaxed_count;
+}
+
+bool SpirvBuilder::relaxFloatResult(const spv::Instruction& instruction,
+                                    const std::vector<std::pair<spv::Id, spv::Id>>& id_ranges) {
+  spv::Id id = instruction.getResultId();
+  if (id == spv::NoResult) {
+    return false;
+  }
+  // Ranges are sorted and don't overlap - find the last starting at or before id.
+  auto range_it = std::upper_bound(
+      id_ranges.begin(), id_ranges.end(), id,
+      [](spv::Id value, const std::pair<spv::Id, spv::Id>& range) { return value < range.first; });
+  if (range_it == id_ranges.begin() || id >= std::prev(range_it)->second) {
+    return false;
+  }
+  switch (instruction.getOpCode()) {
+    case spv::OpFAdd:
+    case spv::OpFSub:
+    case spv::OpFMul:
+    case spv::OpFDiv:
+    case spv::OpFMod:
+    case spv::OpFRem:
+    case spv::OpFNegate:
+    case spv::OpDot:
+    case spv::OpVectorTimesScalar:
+    case spv::OpExtInst:
+    case spv::OpSelect:
+    case spv::OpLoad:
+    case spv::OpPhi:
+    case spv::OpCompositeExtract:
+    case spv::OpCompositeConstruct:
+    case spv::OpVectorShuffle:
+      break;
+    default:
+      return false;
+  }
+  if (instruction.getTypeId() == spv::NoType) {
+    return false;
+  }
+  spv::Instruction* type = module.getInstruction(instruction.getTypeId());
+  if (type && type->getOpCode() == spv::OpTypeVector) {
+    type = module.getInstruction(type->getIdOperand(0));
+  }
+  if (!type || type->getOpCode() != spv::OpTypeFloat) {
+    return false;
+  }
+  addDecoration(id, spv::DecorationRelaxedPrecision);
+  return true;
+}
