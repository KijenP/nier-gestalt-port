+        xe_verify[4] = x | (c.y << 16u);
+      }
+    } else {
+#ifdef XE_DEPTH_UNORM
+      imageStore(xe_dest, ivec2(x, c.y), vec4(uintBitsToFloat(value)));
+#else
+      imageStore(xe_dest, ivec2(x, c.y), unpackUnorm4x8(value));
+#endif
+    }
+  }
+}
+)";
+  for (size_t i = 0; i < direct_load_pipelines_.size(); ++i) {
+    std::string source = i ? "#version 450\n#define XE_DEPTH_UNORM 1\n" : "#version 450\n";
+    if (std::getenv("NIER_FORWARD_VERIFY")) {
+      source += "#define XE_VERIFY_FORWARD 1\n";
+    }
+    source += kSource;
+    std::vector<uint32_t> spirv;
+    std::string compile_error;
+    if (!command_processor_.CompileGlslToSpirv(VK_SHADER_STAGE_COMPUTE_BIT, source, spirv,
+                                               compile_error)) {
+      REXGPU_ERROR("VulkanTextureCache: Failed to compile the direct load shader: {}",
+                   compile_error);
+      return false;
+    }
+    direct_load_pipelines_[i] = ui::vulkan::util::CreateComputePipeline(
+        vulkan_device, direct_load_pipeline_layout_, spirv.data(),
+        sizeof(uint32_t) * spirv.size());
+    if (direct_load_pipelines_[i] == VK_NULL_HANDLE) {
+      REXGPU_ERROR("VulkanTextureCache: Failed to create the direct load pipeline");
+      return false;
+    }
+  }
+
+  // Forward-only resolve store: the 8888 direct load inverted (the image holds
+  // unpackUnorm4x8 of the endian-swapped dwords, packUnorm4x8 gives them back
+  // exactly). Optional - forward-only resolves are not done without it.
+  static const char kStoreSource[] = R"(
+#ifdef XE_VERIFY
+layout(std430, set = 0, binding = 0) buffer XeDest { uint xe_dest[]; };
+layout(std430, set = 3, binding = 0) buffer XeVerify { uint xe_verify[]; };
+#else
+layout(std430, set = 0, binding = 0) writeonly buffer XeDest { uint xe_dest[]; };
+#endif
+layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;
+layout(set = 1, binding = 0, rgba8) uniform readonly image2D xe_source;
+layout(push_constant) uniform XePush {
+  uint pitch_macro_tiles;
+  uint width_scaled;
+  uint height_scaled;
+  uint scale;
+  uint endian;
+} xe_push;
+
+int XenosTiledAddress2D(ivec2 p, uint pitch_macro_tiles, uint bytes_per_block_log2) {
+  int outer_blocks = ((p.y >> 5) * int(pitch_macro_tiles) + (p.x >> 5)) << 6;
+  int inner_blocks = (((p.y >> 1) & 7) << 3) | (p.x & 7);
+  int outer_inner_bytes = (outer_blocks | inner_blocks) << bytes_per_block_log2;
+  int bank = (p.y >> 4) & 1;
+  int pipe = ((p.x >> 3) & 3) ^ (((p.y >> 3) & 1) << 1);
+  return ((p.y & 1) << 4) | (pipe << 6) | (bank << 11) | (outer_inner_bytes & 0xF) |
+         (((outer_inner_bytes >> 4) & 1) << 5) | (((outer_inner_bytes >> 5) & 7) << 8) |
+         (outer_inner_bytes >> 8 << 12);
+}
+
+void main() {
+  uvec2 c = gl_GlobalInvocationID.xy;
+  if (c.x >= xe_push.width_scaled || c.y >= xe_push.height_scaled) {
+    return;
+  }
+  uvec2 scale = uvec2(xe_push.scale & 0xFFu, xe_push.scale >> 8u);
+  uvec2 host_group = uvec2(c.x >> 2u, c.y);
+  uvec2 guest_group = host_group / scale;
+  uvec2 host_group_in_guest_group = host_group - guest_group * scale;
+  uint address =
+      uint(XenosTiledAddress2D(ivec2(guest_group.x << 2u, guest_group.y),
+                               xe_push.pitch_macro_tiles, 2u)) * (scale.x * scale.y) +
+      ((((host_group_in_guest_group.x * scale.y + host_group_in_guest_group.y) << 2u) |
+        (c.x & 3u)) << 2u);
+  uint v = packUnorm4x8(imageLoad(xe_source, ivec2(c)));
+  if (xe_push.endian == 1u || xe_push.endian == 2u) {
+    v = ((v & 0x00FF00FFu) << 8u) | ((v & 0xFF00FF00u) >> 8u);
+  }
+  if (xe_push.endian == 2u || xe_push.endian == 3u) {
+    v = (v << 16u) | (v >> 16u);
+  }
+#ifdef XE_VERIFY
+  // TEMP: NIER_FWDONLY_VERIFY - the resolve has also stored, compare.
+  atomicAdd(xe_verify[17], 1u);
+  uint expected = xe_dest[address >> 2u];
+  if (expected != v && atomicAdd(xe_verify[16], 1u) == 0u) {
+    xe_verify[18] = expected;
+    xe_verify[19] = v;
+    xe_verify[20] = c.x | (c.y << 16u);
+  }
+#else
+  xe_dest[address >> 2u] = v;
+#endif
+}
+)";
+  {
+    std::vector<uint32_t> spirv;
+    std::string compile_error;
+    std::string store_source = "#version 450\n";
+    if (std::getenv("NIER_FWDONLY_VERIFY")) {
+      store_source += "#define XE_VERIFY 1\n";
+    }
+    store_source += kStoreSource;
+    if (command_processor_.CompileGlslToSpirv(VK_SHADER_STAGE_COMPUTE_BIT, store_source, spirv,
+                                              compile_error)) {
+      direct_store_pipeline_ = ui::vulkan::util::CreateComputePipeline(
+          vulkan_device, direct_load_pipeline_layout_, spirv.data(),
+          sizeof(uint32_t) * spirv.size());
+    } else {
+      REXGPU_ERROR("VulkanTextureCache: Failed to compile the direct store shader: {}",
+                   compile_error);
+    }
+  }
+  direct_load_pipelines_failed_ = false;
+  if (direct_store_pipeline_ != VK_NULL_HANDLE &&
+      REXCVAR_GET(vulkan_resolve_forward_only_1x)) {
+    shared_memory().SetRequestHook(SharedMemoryRequestHook, this);
+  }
+  REXGPU_INFO("VulkanTextureCache: Direct resolved texture load enabled");
+  return true;
+}
+
+bool VulkanTextureCache::LoadTextureBaseDirect(VulkanTexture& texture,
+                                               VkBuffer verify_scratch_buffer,
+                                               uint32_t verify_scratch_pitch_bytes,
+                                               bool verify_forward) {
+  if (!EnsureDirectLoadPipelines()) {
+    return false;
+  }
+  bool verify = verify_scratch_buffer != VK_NULL_HANDLE;
+  verify_forward = verify_forward && !verify;
+  const ui::vulkan::VulkanDevice* const vulkan_device = command_processor_.GetVulkanDevice();
+  const ui::vulkan::VulkanDevice::Functions& dfn = vulkan_device->functions();
+  const VkDevice device = vulkan_device->device();
+  TextureKey texture_key = texture.key();
+  const texture_util::TextureGuestLayout& guest_layout = texture.guest_layout();
+
+  VkDescriptorSet descriptor_set_dest = texture.GetDirectLoadDescriptorSet();
+  if (descriptor_set_dest == VK_NULL_HANDLE) {
+    return false;
+  }
+  VkDescriptorSet descriptor_sets[4];
+  VkDescriptorBufferInfo buffer_infos[3];
+  VkWriteDescriptorSet writes[3] = {};
+  uint32_t write_count = 0;
+  auto allocate_buffer_set = [&](VkBuffer buffer, VkDeviceSize offset,
+                                 VkDeviceSize range) -> VkDescriptorSet {
+    VkDescriptorSet set = command_processor_.AllocateSingleTransientDescriptor(
+        VulkanCommandProcessor::SingleTransientDescriptorLayout::kStorageBufferCompute);
+    if (set == VK_NULL_HANDLE) {
+      return VK_NULL_HANDLE;
+    }
+    VkDescriptorBufferInfo& info = buffer_infos[write_count];
+    info.buffer = buffer;
+    info.offset = offset;
+    info.range = range;
+    VkWriteDescriptorSet& write = writes[write_count++];
+    write.sType = VK_STRUCTURE_TYPE_WRITE_DESCRIPTOR_SET;
+    write.dstSet = set;
+    write.descriptorCount = 1;
+    write.descriptorType = VK_DESCRIPTOR_TYPE_STORAGE_BUFFER;
+    write.pBufferInfo = &info;
+    return set;
+  };
+  uint64_t source_start, source_range;
+  if (!GetScaledResolveRange(texture_key.base_page << 12, texture.GetGuestBaseSize(), 4,
+                             source_start, source_range)) {
+    return false;
+  }
+  descriptor_sets[0] = allocate_buffer_set(scaled_resolve_buffer_, source_start, source_range);
+  descriptor_sets[1] = descriptor_set_dest;
+  if (verify || verify_forward) {
+    if (direct_load_verify_buffer_ == VK_NULL_HANDLE) {
+      uint32_t memory_type;
+      VkDeviceSize memory_size;
+      if (!ui::vulkan::util::CreateDedicatedAllocationBuffer(
+              vulkan_device, 4096, VK_BUFFER_USAGE_STORAGE_BUFFER_BIT,
+              ui::vulkan::util::MemoryPurpose::kReadback, direct_load_verify_buffer_,
+              direct_load_verify_memory_, &memory_type, &memory_size) ||
+          dfn.vkMapMemory(device, direct_load_verify_memory_, 0, VK_WHOLE_SIZE, 0,
+                          reinterpret_cast<void**>(&direct_load_verify_mapping_)) != VK_SUCCESS) {
+        return false;
+      }
+      std::memset(direct_load_verify_mapping_, 0, 4096);
+      VkMappedMemoryRange range = {};
+      range.sType = VK_STRUCTURE_TYPE_MAPPED_MEMORY_RANGE;
+      range.memory = direct_load_verify_memory_;
+      range.size = VK_WHOLE_SIZE;
+      dfn.vkFlushMappedMemoryRanges(device, 1, &range);
+    }
+    descriptor_sets[2] = verify ? allocate_buffer_set(verify_scratch_buffer, 0, VK_WHOLE_SIZE)
+                                : descriptor_sets[0];
+    descriptor_sets[3] = allocate_buffer_set(direct_load_verify_buffer_, 0, VK_WHOLE_SIZE);
+  } else {
+    // Unused, but must be valid.
+    descriptor_sets[2] = descriptor_sets[0];
+    descriptor_sets[3] = descriptor_sets[0];
+  }
+  for (VkDescriptorSet set : descriptor_sets) {
+    if (set == VK_NULL_HANDLE) {
+      return false;
+    }
+  }
+  dfn.vkUpdateDescriptorSets(device, write_count, writes, 0, nullptr);
+  StoreForwardOnlyResolves(source_start, source_range);
+  UseScaledResolveBufferForRead();
+
+  DeferredCommandBuffer& command_buffer = command_processor_.deferred_command_buffer();
+  if (verify) {
+    command_processor_.PushBufferMemoryBarrier(
+        verify_scratch_buffer, 0, VK_WHOLE_SIZE, VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT,
+        VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT, VK_ACCESS_SHADER_WRITE_BIT,
+        VK_ACCESS_SHADER_READ_BIT);
+  } else {
+    texture.MarkAsUsed();
+    VulkanTexture::Usage old_usage = texture.SetUsage(VulkanTexture::Usage::kComputeWrite);
+    VkPipelineStageFlags src_stage_mask, dst_stage_mask;
+    VkAccessFlags src_access_mask, dst_access_mask;
+    VkImageLayout old_layout, new_layout;
+    GetTextureUsageMasks(old_usage, src_stage_mask, src_access_mask, old_layout);
+    GetTextureUsageMasks(VulkanTexture::Usage::kComputeWrite, dst_stage_mask, dst_access_mask,
+                         new_layout);
+    // Always a barrier, also between consecutive loads (write after write).
+    command_processor_.PushImageMemoryBarrier(
+        texture.image(), ui::vulkan::util::InitializeSubresourceRange(), src_stage_mask,
+        dst_stage_mask, src_access_mask, dst_access_mask,
+        old_usage == VulkanTexture::Usage::kComputeWrite ? new_layout : old_layout, new_layout);
+  }
+  command_processor_.BindExternalComputePipeline(
+      direct_load_pipelines_[GetDirectLoadFormat(texture_key) == VK_FORMAT_R32_SFLOAT]);
+  command_buffer.CmdVkBindDescriptorSets(VK_PIPELINE_BIND_POINT_COMPUTE,
+                                         direct_load_pipeline_layout_, 0, 4, descriptor_sets, 0,
+                                         nullptr);
+  uint32_t scale_x = draw_resolution_scale_x(), scale_y = draw_resolution_scale_y();
+  uint32_t push[7];
+  push[0] = (guest_layout.base.row_pitch_bytes / 4) >> 5;
+  push[1] = texture_key.GetWidth() * scale_x;
+  push[2] = texture_key.GetHeight() * scale_y;
+  push[3] = scale_x | (scale_y << 8);
+  push[4] = uint32_t(texture_key.endianness);
+  push[5] = verify_scratch_pitch_bytes / 4;
+  push[6] = verify ? 1 : (verify_forward ? 2 : 0);
+  command_buffer.CmdVkPushConstants(direct_load_pipeline_layout_, VK_SHADER_STAGE_COMPUTE_BIT, 0,
+                                    sizeof(push), push);
+  command_processor_.SubmitBarriers(true);
+  command_buffer.CmdVkDispatch((push[1] + 7) / 8, (push[2] + 7) / 8, 1);
+  return true;
+}
+
+bool VulkanTextureCache::PrepareResolveForward(uint32_t dest_base, uint32_t dest_pitch_div_32,
+                                               uint32_t width, uint32_t height, bool depth,
+                                               ResolveForwardTarget& target_out, bool draw,
+                                               bool memory_read_back) {
+  if (!REXCVAR_GET(vulkan_resolve_to_texture) || (dest_base & 0xFFF) ||
+      direct_load_textures_.empty()) {
+    return false;
+  }
+  VkFormat format = depth ? VK_FORMAT_R32_SFLOAT : VK_FORMAT_R8G8B8A8_UNORM;
+  auto range = direct_load_textures_.equal_range((dest_base & 0x1FFFFFFF) >> 12);
+  for (auto it = range.first; it != range.second; ++it) {
+    VulkanTexture& texture = *it->second;
+    TextureKey key = texture.key();
+    // GetDirectLoadFormat also checks that it's a scaled tiled 2D texture.
+    if (key.pitch != dest_pitch_div_32 || key.GetWidth() > width || key.GetHeight() > height ||
+        GetDirectLoadFormat(key) != format || texture.guest_layout().packed_level == 0) {
+      continue;
+    }
+    VkDescriptorSet descriptor_set = texture.GetDirectLoadDescriptorSet();
+    if (descriptor_set == VK_NULL_HANDLE) {
+      continue;
+    }
+    texture.MarkAsUsed();
+    // Needs COLOR_ATTACHMENT usage, given on creation with the cvar.
+    draw = draw && REXCVAR_GET(vulkan_resolve_forward_draw) && texture.direct_load_view();
+    VulkanTexture::Usage write_usage =
+        draw ? VulkanTexture::Usage::kColorAttachmentWrite : VulkanTexture::Usage::kComputeWrite;
+    VulkanTexture::Usage old_usage = texture.SetUsage(write_usage);
+    VkPipelineStageFlags src_stage_mask, dst_stage_mask;
+    VkAccessFlags src_access_mask, dst_access_mask;
+    VkImageLayout old_layout, new_layout;
+    GetTextureUsageMasks(old_usage, src_stage_mask, src_access_mask, old_layout);
+    GetTextureUsageMasks(write_usage, dst_stage_mask, dst_access_mask, new_layout);
+    // The whole base level is overwritten by a draw.
+    command_processor_.PushImageMemoryBarrier(
+        texture.image(), ui::vulkan::util::InitializeSubresourceRange(), src_stage_mask,
+        dst_stage_mask, src_access_mask, dst_access_mask,
+        old_usage == write_usage ? new_layout : old_layout, new_layout);
+    target_out.draw = draw;
+    target_out.view = draw ? texture.direct_load_view() : VK_NULL_HANDLE;
+    target_out.framebuffer = draw ? &texture.forward_framebuffer_ : nullptr;
+    target_out.texture = &texture;
+    target_out.image_descriptor_set = descriptor_set;
+    target_out.endian = uint32_t(key.endianness);
+    target_out.width_scaled = key.GetWidth() * draw_resolution_scale_x();
+    target_out.height_scaled = key.GetHeight() * draw_resolution_scale_y();
+    // The texture must hold all that the resolve writes to be able to store it
+    // later (and the depth texture has no stencil). The forwarding verification
+    // (TEMP) loads the texture from the buffer.
+    static const bool forward_verify = std::getenv("NIER_FORWARD_VERIFY") != nullptr;
+    // Without scaling, stored to the shared memory when it's requested
+    // (vulkan_resolve_forward_only_1x), unless the CPU reads the resolve back.
+    // Not learning which destinations are requested: big ones requested once
+    // in a while then lose more than the always requested small ones gain.
+    target_out.forward_only = !depth &&
+                              (key.scaled_resolve ? REXCVAR_GET(vulkan_resolve_forward_only)
+                                                  : (REXCVAR_GET(vulkan_resolve_forward_only_1x) &&
+                                                     !memory_read_back)) &&
+                              direct_store_pipeline_ != VK_NULL_HANDLE &&
+                              key.GetWidth() == width && key.GetHeight() == height &&
+                              !forward_verify;
+    return true;
+  }
+  return false;
+}
+
+void VulkanTextureCache::CompleteResolveForward(const ResolveForwardTarget& target) {
+  VulkanTexture& texture = *static_cast<VulkanTexture*>(target.texture);
+  // TEMP: NIER_FORWARD_VERIFY=<frame> - for 2 frames, forwarded textures are
+  // still loaded, first comparing the image with the loaded values, reported
+  // 30 frames later.
+  static const uint64_t verify_frame = [] {
+    const char* v = std::getenv("NIER_FORWARD_VERIFY");
+    return v ? uint64_t(std::atoll(v)) : uint64_t(0);
+  }();
+  if (verify_frame) {
+    uint64_t frame = command_processor_.GetCurrentFrame();
+    static bool reported = false;
+    if (!reported && frame >= verify_frame + 30 && direct_load_verify_mapping_) {
+      reported = true;
+      const ui::vulkan::VulkanDevice* const vulkan_device = command_processor_.GetVulkanDevice();
+      VkMappedMemoryRange range = {};
+      range.sType = VK_STRUCTURE_TYPE_MAPPED_MEMORY_RANGE;
+      range.memory = direct_load_verify_memory_;
+      range.size = VK_WHOLE_SIZE;
+      vulkan_device->functions().vkInvalidateMappedMemoryRanges(vulkan_device->device(), 1,
+                                                                &range);
+      REXGPU_INFO(
+          "FORWARDVERIFY checked={} mismatches={} first: loaded={:08X} forwarded={:08X} at {},{}",
+          direct_load_verify_mapping_[9], direct_load_verify_mapping_[8],
+          direct_load_verify_mapping_[10], direct_load_verify_mapping_[11],
+          direct_load_verify_mapping_[12] & 0xFFFF, direct_load_verify_mapping_[12] >> 16);
+    }
+    if (frame >= verify_frame && frame < verify_frame + 2) {
+      forward_verify_textures_.insert(&texture);
+      return;
+    }
+  }
+  MarkTextureBaseUpToDate(texture);
+}
+
+uint64_t VulkanTextureCache::GetResolveForwardState(const ResolveForwardTarget& target,
+                                                    uint32_t start, uint32_t length) {
+  VulkanTexture& texture = *static_cast<VulkanTexture*>(target.texture);
+  // The watch must cover all that the resolve writes.
+  uint32_t base = texture.key().base_page << 12;
+  start &= 0x1FFFFFFF;
+  bool up_to_date;
+  uint64_t invalidations = GetTextureBaseInvalidations(texture, up_to_date);
+  if (start < base || start + length > base + texture.GetGuestBaseSize() || !up_to_date ||
+      forward_verify_textures_.count(&texture)) {
+    return UINT64_MAX;
+  }
+  return (uint64_t(texture.direct_load_id_) << 32) | uint32_t(invalidations);
+}
+
+bool VulkanTextureCache::IsResolveForwardUnchanged(void* texture, uint32_t dest_base,
+                                                   uint64_t state) {
+  if (!texture || state == UINT64_MAX) {
+    return false;
+  }
+  auto range = direct_load_textures_.equal_range((dest_base & 0x1FFFFFFF) >> 12);
+  for (auto it = range.first; it != range.second; ++it) {
+    if (it->second == texture) {
+      bool up_to_date;
+      uint64_t invalidations = GetTextureBaseInvalidations(*it->second, up_to_date);
+      return up_to_date && ((uint64_t(it->second->direct_load_id_) << 32) |
+                            uint32_t(invalidations)) == state;
+    }
+  }
+  return false;
+}
+
+void VulkanTextureCache::SetResolveForwardOnly(const ResolveForwardTarget& target,
+                                               uint32_t extent_start, uint32_t extent_length) {
+  assert_true(target.forward_only);
+  VulkanTexture& texture = *static_cast<VulkanTexture*>(target.texture);
+  ForwardOnlyResolve resolve;
+  resolve.texture = &texture;
+  resolve.dest_base = texture.key().base_page << 12;
+  if (!texture.key().scaled_resolve) {
+    // PrepareUnscaledResolveWrite has removed the overlapping ones.
+    resolve.unscaled = true;
+    resolve.start_scaled = extent_start;
+    resolve.length_scaled = extent_length;
+    forward_only_resolves_.push_back(resolve);
+    ++forward_only_registered_count_;
+    return;
+  }
+  if (!GetScaledResolveRange(extent_start, extent_length, 0, resolve.start_scaled,
+                             resolve.length_scaled)) {
+    // Shouldn't happen (the resolve has used the range), but store right away.
+    resolve.start_scaled = 0;
+    resolve.length_scaled = 0;
+    StoreForwardOnlyResolve(resolve);
+    return;
+  }
+  // PrepareScaledResolveWrite has removed the overlapping ones.
+  forward_only_resolves_.push_back(resolve);
+}
+
+void VulkanTextureCache::SharedMemoryRequestHook(void* context, uint32_t start, uint32_t length) {
+  VulkanTextureCache& texture_cache = *static_cast<VulkanTextureCache*>(context);
+  if (!texture_cache.request_hook_suppressed_) {
+    texture_cache.StoreForwardOnlyResolves(start, length, true);
+  }
+}
+
+void VulkanTextureCache::StoreForwardOnlyResolves(uint64_t start_scaled, uint64_t length_scaled,
+                                                  bool unscaled) {
+  if (forward_only_resolves_.empty()) {
+    return;
+  }
+  for (size_t i = 0; i < forward_only_resolves_.size();) {
+    const ForwardOnlyResolve& resolve = forward_only_resolves_[i];
+    if (resolve.unscaled == unscaled && resolve.start_scaled < start_scaled + length_scaled &&
+        start_scaled < resolve.start_scaled + resolve.length_scaled) {
+      ForwardOnlyResolve stored = resolve;
+      forward_only_resolves_.erase(forward_only_resolves_.begin() + i);
+      StoreForwardOnlyResolve(stored);
+    } else {
+      ++i;
+    }
+  }
+}
+
+void VulkanTextureCache::PrepareScaledResolveWrite(uint32_t dest_base, uint32_t dest_pitch_div_32,
+                                                   uint32_t width, uint32_t height,
+                                                   bool dest_offset, uint32_t extent_start,
+                                                   uint32_t extent_length) {
+  if (forward_only_resolves_.empty()) {
+    return;
+  }
+  uint64_t start_scaled, length_scaled;
+  if (!GetScaledResolveRange(extent_start, extent_length, 0, start_scaled, length_scaled)) {
+    return;
+  }
+  dest_base &= 0x1FFFFFFF;
+  for (size_t i = 0; i < forward_only_resolves_.size();) {
+    const ForwardOnlyResolve& resolve = forward_only_resolves_[i];
+    if (resolve.unscaled || resolve.start_scaled >= start_scaled + length_scaled ||
+        start_scaled >= resolve.start_scaled + resolve.length_scaled) {
+      ++i;
+      continue;
+    }
+    ForwardOnlyResolve stored = resolve;
+    forward_only_resolves_.erase(forward_only_resolves_.begin() + i);
+    // The same pixels written again (the texture is exactly the size of the
+    // forward-only resolve) - nothing to keep.
+    TextureKey key = stored.texture->key();
+    if (stored.dest_base == dest_base && !dest_offset && key.pitch == dest_pitch_div_32 &&
+        key.GetWidth() == width && key.GetHeight() == height) {
+      continue;
+    }
+    StoreForwardOnlyResolve(stored);
+  }
+}
+
+void VulkanTextureCache::PrepareUnscaledResolveWrite(uint32_t dest_base,
+                                                     uint32_t dest_pitch_div_32, uint32_t width,
+                                                     uint32_t height, bool dest_offset,
+                                                     uint32_t extent_start,
+                                                     uint32_t extent_length) {
+  dest_base &= 0x1FFFFFFF;
+  for (size_t i = 0; i < forward_only_resolves_.size();) {
+    const ForwardOnlyResolve& resolve = forward_only_resolves_[i];
+    if (!resolve.unscaled || resolve.start_scaled >= uint64_t(extent_start) + extent_length ||
+        extent_start >= resolve.start_scaled + resolve.length_scaled) {
+      ++i;
+      continue;
+    }
+    // The same pixels written again - kept until the resolve is actually done
+    // (it may be skipped as unchanged), then dropped by
+    // DropUnscaledForwardOnlyResolve.
+    TextureKey key = resolve.texture->key();
+    if (resolve.dest_base == dest_base && !dest_offset && key.pitch == dest_pitch_div_32 &&
+        key.GetWidth() == width && key.GetHeight() == height) {
+      ++i;
+      continue;
+    }
+    ForwardOnlyResolve stored = resolve;
+    forward_only_resolves_.erase(forward_only_resolves_.begin() + i);
+    StoreForwardOnlyResolve(stored);
+  }
+}
+
+void VulkanTextureCache::DropUnscaledForwardOnlyResolve(uint32_t dest_base) {
+  dest_base &= 0x1FFFFFFF;
+  for (size_t i = 0; i < forward_only_resolves_.size();) {
+    if (forward_only_resolves_[i].unscaled && forward_only_resolves_[i].dest_base == dest_base) {
+      forward_only_resolves_.erase(forward_only_resolves_.begin() + i);
+    } else {
+      ++i;
+    }
+  }
+}
+
+void VulkanTextureCache::StoreForwardOnlyResolve(const ForwardOnlyResolve& resolve) {
+  VulkanTexture& texture = *resolve.texture;
+  TextureKey key = texture.key();
+  if (resolve.unscaled) {
+    // Something else has written to the range since (the CPU, for instance) -
+    // the texture is outdated, and the memory is newer than it.
+    bool up_to_date;
+    GetTextureBaseInvalidations(texture, up_to_date);
+    if (!up_to_date) {
+      return;
+    }
+  }
+  ++forward_only_stored_count_;
+  {  // TEMP: NIER_RESOLVE_LOG also logs the stores.
+    const uint64_t log_frame = NierResolveLogFrame();
+    uint64_t frame = command_processor_.GetCurrentFrame();
+    if (log_frame && frame >= log_frame && frame < log_frame + 2) {
+      REXGPU_INFO("RESLOG f={} forwardonlystore dest={:08X} {}x{} total={}", frame,
+                  resolve.dest_base, key.GetWidth(), key.GetHeight(),
+                  forward_only_stored_count_);
+    }
+  }
+  const ui::vulkan::VulkanDevice* const vulkan_device = command_processor_.GetVulkanDevice();
+  const ui::vulkan::VulkanDevice::Functions& dfn = vulkan_device->functions();
+  const VkDevice device = vulkan_device->device();
+  uint64_t dest_start, dest_range;
+  VkDescriptorSet descriptor_sets[2];
+  descriptor_sets[1] = texture.GetDirectLoadDescriptorSet();
+  if (resolve.unscaled) {
+    dest_start = resolve.dest_base;
+    dest_range = texture.GetGuestBaseSize();
+  }
+  if ((!resolve.unscaled && !GetScaledResolveRange(resolve.dest_base, texture.GetGuestBaseSize(),
+                                                   4, dest_start, dest_range)) ||
+      descriptor_sets[1] == VK_NULL_HANDLE) {
+    ++forward_only_lost_count_;
+    REXGPU_ERROR("VulkanTextureCache: Failed to store the forward-only resolve to {:08X}",
+                 resolve.dest_base);
+    return;
+  }
+  descriptor_sets[0] = command_processor_.AllocateSingleTransientDescriptor(
+      VulkanCommandProcessor::SingleTransientDescriptorLayout::kStorageBufferCompute);
+  if (descriptor_sets[0] == VK_NULL_HANDLE) {
+    ++forward_only_lost_count_;
+    REXGPU_ERROR("VulkanTextureCache: Failed to store the forward-only resolve to {:08X}",
+                 resolve.dest_base);
+    return;
+  }
+  VulkanSharedMemory& vulkan_shared_memory = static_cast<VulkanSharedMemory&>(shared_memory());
+  VkDescriptorBufferInfo buffer_info;
+  buffer_info.buffer = resolve.unscaled ? vulkan_shared_memory.buffer() : scaled_resolve_buffer_;
+  buffer_info.offset = dest_start;
+  buffer_info.range = dest_range;
+  VkWriteDescriptorSet write = {};
+  write.sType = VK_STRUCTURE_TYPE_WRITE_DESCRIPTOR_SET;
+  write.dstSet = descriptor_sets[0];
+  write.descriptorCount = 1;
+  write.descriptorType = VK_DESCRIPTOR_TYPE_STORAGE_BUFFER;
+  write.pBufferInfo = &buffer_info;
+  dfn.vkUpdateDescriptorSets(device, 1, &write, 0, nullptr);
+
+  if (resolve.unscaled) {
+    vulkan_shared_memory.Use(VulkanSharedMemory::Usage::kComputeWrite,
+                             std::pair<uint32_t, uint32_t>(uint32_t(resolve.start_scaled),
+                                                           uint32_t(resolve.length_scaled)));
+  } else {
+    UseScaledResolveBufferForWrite(resolve.start_scaled, resolve.length_scaled);
+  }
+  VulkanTexture::Usage old_usage = texture.SetUsage(VulkanTexture::Usage::kComputeRead);
+  if (old_usage != VulkanTexture::Usage::kComputeRead) {
+    VkPipelineStageFlags src_stage_mask, dst_stage_mask;
+    VkAccessFlags src_access_mask, dst_access_mask;
+    VkImageLayout old_layout, new_layout;
+    GetTextureUsageMasks(old_usage, src_stage_mask, src_access_mask, old_layout);
+    GetTextureUsageMasks(VulkanTexture::Usage::kComputeRead, dst_stage_mask, dst_access_mask,
+                         new_layout);
+    command_processor_.PushImageMemoryBarrier(
+        texture.image(), ui::vulkan::util::InitializeSubresourceRange(), src_stage_mask,
+        dst_stage_mask, src_access_mask, dst_access_mask, old_layout, new_layout);
+  }
+  command_processor_.BindExternalComputePipeline(direct_store_pipeline_);
+  DeferredCommandBuffer& command_buffer = command_processor_.deferred_command_buffer();
+  command_buffer.CmdVkBindDescriptorSets(VK_PIPELINE_BIND_POINT_COMPUTE,
+                                         direct_load_pipeline_layout_, 0, 2, descriptor_sets, 0,
+                                         nullptr);
+  static const bool fwdonly_verify = std::getenv("NIER_FWDONLY_VERIFY") != nullptr;
+  if (fwdonly_verify) {
+    // TEMP: comparison results in direct_load_verify_buffer_[16..20].
+    if (direct_load_verify_buffer_ == VK_NULL_HANDLE) {
+      uint32_t memory_type;
+      VkDeviceSize memory_size;
+      if (!ui::vulkan::util::CreateDedicatedAllocationBuffer(
+              vulkan_device, 4096, VK_BUFFER_USAGE_STORAGE_BUFFER_BIT,
+              ui::vulkan::util::MemoryPurpose::kReadback, direct_load_verify_buffer_,
+              direct_load_verify_memory_, &memory_type, &memory_size) ||
+          dfn.vkMapMemory(device, direct_load_verify_memory_, 0, VK_WHOLE_SIZE, 0,
+                          reinterpret_cast<void**>(&direct_load_verify_mapping_)) != VK_SUCCESS) {
+        return;
+      }
+      std::memset(direct_load_verify_mapping_, 0, 4096);
+      VkMappedMemoryRange range = {};
+      range.sType = VK_STRUCTURE_TYPE_MAPPED_MEMORY_RANGE;
+      range.memory = direct_load_verify_memory_;
+      range.size = VK_WHOLE_SIZE;
+      dfn.vkFlushMappedMemoryRanges(device, 1, &range);
+    }
+    VkDescriptorSet verify_set = command_processor_.AllocateSingleTransientDescriptor(
+        VulkanCommandProcessor::SingleTransientDescriptorLayout::kStorageBufferCompute);
+    if (verify_set == VK_NULL_HANDLE) {
+      return;
+    }
+    VkDescriptorBufferInfo verify_info;
+    verify_info.buffer = direct_load_verify_buffer_;
+    verify_info.offset = 0;
+    verify_info.range = VK_WHOLE_SIZE;
+    write.dstSet = verify_set;
+    write.pBufferInfo = &verify_info;
+    dfn.vkUpdateDescriptorSets(device, 1, &write, 0, nullptr);
+    VkDescriptorSet verify_sets[2] = {descriptor_sets[0], verify_set};
+    command_buffer.CmdVkBindDescriptorSets(VK_PIPELINE_BIND_POINT_COMPUTE,
+                                           direct_load_pipeline_layout_, 2, 2, verify_sets, 0,
+                                           nullptr);
+  }
+  uint32_t scale_x = draw_resolution_scale_x(), scale_y = draw_resolution_scale_y();
+  uint32_t push[5];
+  push[0] = (texture.guest_layout().base.row_pitch_bytes / 4) >> 5;
+  push[1] = key.GetWidth() * scale_x;
+  push[2] = key.GetHeight() * scale_y;
+  push[3] = scale_x | (scale_y << 8);
+  push[4] = uint32_t(key.endianness);
+  command_buffer.CmdVkPushConstants(direct_load_pipeline_layout_, VK_SHADER_STAGE_COMPUTE_BIT, 0,
+                                    sizeof(push), push);
+  command_processor_.SubmitBarriers(true);
+  command_buffer.CmdVkDispatch((push[1] + 7) / 8, (push[2] + 7) / 8, 1);
+}
