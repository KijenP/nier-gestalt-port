-    return nullptr;
-  }
-  if (error_blob != nullptr) {
-    error_blob->Release();
-  }
-  ID3D12RootSignature* root_signature = nullptr;
-  provider.GetDevice()->CreateRootSignature(0, blob->GetBufferPointer(), blob->GetBufferSize(),
-                                            IID_PPV_ARGS(&root_signature));
-  blob->Release();
-  return root_signature;
-}
