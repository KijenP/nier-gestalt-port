-bool D3D12RenderTargetCache::IsHostDepthEncodingDifferent(
-    xenos::DepthRenderTargetFormat format) const {
-  if (format == xenos::DepthRenderTargetFormat::kD24FS8) {
-    return !depth_float24_convert_in_pixel_shader_;
-  }
-  return false;
