+bool VulkanCommandProcessor::GetDepthOverwriteRectangle(xenos::PrimitiveType prim_type,
+                                                        uint32_t index_count,
+                                                        const IndexBufferInfo* index_buffer_info,
+                                                        reg::RB_DEPTHCONTROL depth_control,
+                                                        DepthOverwriteInfo& info_out) {
+  // Only the screen-space clear rectangle of NieR (and other games using the
+  // same Direct3D clear vertex shader): position = the first 3 floats of the
+  // first vertex binding, so its coverage can be computed here.
+  constexpr uint64_t kClearVertexShaderHash = 0x1E6883FCCDE1F688ull;
+  const RegisterFile& regs = *register_file_;
+  if (prim_type != xenos::PrimitiveType::kRectangleList || index_count != 3 ||
+      index_buffer_info || regs.Get<reg::VGT_INDX_OFFSET>().indx_offset ||
+      regs.Get<reg::RB_SURFACE_INFO>().msaa_samples != xenos::MsaaSamples::k1X) {
+    return false;
+  }
+  Shader* vertex_shader = active_vertex_shader();
+  if (!vertex_shader || vertex_shader->ucode_data_hash() != kClearVertexShaderHash) {
+    return false;
+  }
+  // Depth fully replaced, or not touched at all by a stencil-only clear.
+  info_out.depth_written = depth_control.z_enable;
+  if (depth_control.z_enable && (!depth_control.z_write_enable ||
+                                 depth_control.zfunc != xenos::CompareFunction::kAlways)) {
+    return false;
+  }
+  // Stencil fully replaced too (any face), with the same value.
+  {
+    auto stencil_ref_mask = regs.Get<reg::RB_STENCILREFMASK>();
+    auto stencil_ref_mask_bf = regs.Get<reg::RB_STENCILREFMASK>(XE_GPU_REG_RB_STENCILREFMASK_BF);
+    info_out.stencil_disabled = !depth_control.stencil_enable;
+    info_out.stencil_ref = uint8_t(stencil_ref_mask.stencilref);
+    info_out.stencil_replaced =
+        depth_control.stencil_enable &&
+        depth_control.stencilfunc == xenos::CompareFunction::kAlways &&
+        depth_control.stencilzpass == xenos::StencilOp::kReplace &&
+        stencil_ref_mask.stencilwritemask == 0xFF &&
+        (!depth_control.backface_enable ||
+         (depth_control.stencilfunc_bf == xenos::CompareFunction::kAlways &&
+          depth_control.stencilzpass_bf == xenos::StencilOp::kReplace &&
+          stencil_ref_mask_bf.stencilwritemask == 0xFF &&
+          stencil_ref_mask_bf.stencilref == stencil_ref_mask.stencilref));
+    if (!info_out.depth_written && !info_out.stencil_replaced) {
+      return false;
+    }
+  }
+  // Every pixel of the rectangle written.
+  auto pa_su_sc_mode_cntl = regs.Get<reg::PA_SU_SC_MODE_CNTL>();
+  if (pa_su_sc_mode_cntl.cull_front || pa_su_sc_mode_cntl.cull_back ||
+      regs.Get<reg::RB_COLORCONTROL>().alpha_to_mask_enable ||
+      (regs[XE_GPU_REG_PA_SC_AA_MASK] & 0x1) == 0) {
+    return false;
+  }
+  if (regs.Get<reg::RB_COLORCONTROL>().alpha_test_enable &&
+      regs.Get<reg::RB_COLORCONTROL>().alpha_func != xenos::CompareFunction::kAlways) {
+    return false;
+  }
+  auto pixel_shader = static_cast<VulkanShader*>(active_pixel_shader());
+  if (pixel_shader) {
+    pipeline_cache_->AnalyzeShaderUcode(*pixel_shader);
+    if (pixel_shader->kills_pixels() || pixel_shader->writes_depth() ||
+        pixel_shader->memexport_eM_written()) {
+      return false;
+    }
+  }
+
+  // Vertex positions - the position is the first 3 floats of the first
+  // binding (indexed by the auto-generated vertex index 0, 1, 2).
+  const std::vector<Shader::VertexBinding>& vertex_bindings = vertex_shader->vertex_bindings();
+  if (vertex_bindings.empty() || vertex_bindings[0].stride_words < 3 ||
+      vertex_bindings[0].attributes.empty() ||
+      vertex_bindings[0].attributes[0].fetch_instr.attributes.offset != 0 ||
+      vertex_bindings[0].attributes[0].fetch_instr.attributes.data_format !=
+          xenos::VertexFormat::k_32_32_32_FLOAT) {
+    return false;
+  }
+  uint32_t stride = vertex_bindings[0].stride_words;
+  xenos::xe_gpu_vertex_fetch_t fetch = regs.GetVertexFetch(vertex_bindings[0].fetch_constant);
+  if (fetch.type != xenos::FetchConstantType::kVertex || fetch.size < 2 * stride + 3) {
+    return false;
+  }
+  const uint32_t* vertices =
+      reinterpret_cast<const uint32_t*>(memory_->TranslatePhysical(fetch.address << 2));
+  if (!vertices) {
+    return false;
+  }
+  auto vte = regs.Get<reg::PA_CL_VTE_CNTL>();
+  float scale_x = vte.vport_x_scale_ena ? regs.Get<float>(XE_GPU_REG_PA_CL_VPORT_XSCALE) : 1.0f;
+  float offset_x = vte.vport_x_offset_ena ? regs.Get<float>(XE_GPU_REG_PA_CL_VPORT_XOFFSET) : 0.0f;
+  float scale_y = vte.vport_y_scale_ena ? regs.Get<float>(XE_GPU_REG_PA_CL_VPORT_YSCALE) : 1.0f;
+  float offset_y = vte.vport_y_offset_ena ? regs.Get<float>(XE_GPU_REG_PA_CL_VPORT_YOFFSET) : 0.0f;
+  float scale_z = vte.vport_z_scale_ena ? regs.Get<float>(XE_GPU_REG_PA_CL_VPORT_ZSCALE) : 1.0f;
+  float offset_z = vte.vport_z_offset_ena ? regs.Get<float>(XE_GPU_REG_PA_CL_VPORT_ZOFFSET) : 0.0f;
+  float x_min = FLT_MAX, x_max = -FLT_MAX, y_min = FLT_MAX, y_max = -FLT_MAX;
+  info_out.integer_coordinates = true;
+  info_out.raw_z_constant = true;
+  for (uint32_t i = 0; i < 3; ++i) {
+    float position[3];
+    for (uint32_t j = 0; j < 3; ++j) {
+      uint32_t bits = xenos::GpuSwap(vertices[stride * i + j], fetch.endian);
+      std::memcpy(&position[j], &bits, sizeof(float));
+    }
+    // W is 1, so the XY / W and Z / W division and the formats don't matter.
+    float x = position[0] * scale_x + offset_x;
+    float y = position[1] * scale_y + offset_y;
+    float z = position[2] * scale_z + offset_z;
+    // Not clipped by the depth range or by the guard band (or NaN).
+    if (!(z >= 0.0f && z <= 1.0f) || !(std::abs(x) < 16384.0f) || !(std::abs(y) < 16384.0f)) {
+      return false;
+    }
+    if (x != std::floor(x) || y != std::floor(y)) {
+      info_out.integer_coordinates = false;
+    }
+    if (!i) {
+      info_out.raw_z = position[2];
+    } else if (position[2] != info_out.raw_z) {
+      info_out.raw_z_constant = false;
+    }
+    x_min = std::min(x_min, x);
+    x_max = std::max(x_max, x);
+    y_min = std::min(y_min, y);
+    y_max = std::max(y_max, y);
+  }
+  // Pixels covered for any pixel center convention.
+  int32_t left = int32_t(std::ceil(x_min)), right = int32_t(std::floor(x_max));
+  int32_t top = int32_t(std::ceil(y_min)), bottom = int32_t(std::floor(y_max));
+  if (pa_su_sc_mode_cntl.vtx_window_offset_enable) {
+    auto window_offset = regs.Get<reg::PA_SC_WINDOW_OFFSET>();
+    left += window_offset.window_x_offset;
+    right += window_offset.window_x_offset;
+    top += window_offset.window_y_offset;
+    bottom += window_offset.window_y_offset;
+  }
+  // Scissors.
+  auto window_scissor_tl = regs.Get<reg::PA_SC_WINDOW_SCISSOR_TL>();
+  auto window_scissor_br = regs.Get<reg::PA_SC_WINDOW_SCISSOR_BR>();
+  int32_t window_scissor[4] = {int32_t(window_scissor_tl.tl_x), int32_t(window_scissor_tl.tl_y),
+                               int32_t(window_scissor_br.br_x), int32_t(window_scissor_br.br_y)};
+  if (!window_scissor_tl.window_offset_disable) {
+    auto window_offset = regs.Get<reg::PA_SC_WINDOW_OFFSET>();
+    window_scissor[0] += window_offset.window_x_offset;
+    window_scissor[2] += window_offset.window_x_offset;
+    window_scissor[1] += window_offset.window_y_offset;
+    window_scissor[3] += window_offset.window_y_offset;
+  }
+  auto screen_scissor_tl = regs.Get<reg::PA_SC_SCREEN_SCISSOR_TL>();
+  auto screen_scissor_br = regs.Get<reg::PA_SC_SCREEN_SCISSOR_BR>();
+  left = std::max({left, window_scissor[0], int32_t(screen_scissor_tl.tl_x), int32_t(0)});
+  top = std::max({top, window_scissor[1], int32_t(screen_scissor_tl.tl_y), int32_t(0)});
+  right = std::min({right, window_scissor[2], int32_t(screen_scissor_br.br_x)});
+  bottom = std::min({bottom, window_scissor[3], int32_t(screen_scissor_br.br_y)});
+  if (right <= left || bottom <= top) {
+    return false;
+  }
+  info_out.rectangle[0] = uint32_t(left);
+  info_out.rectangle[1] = uint32_t(top);
+  info_out.rectangle[2] = uint32_t(right - left);
+  info_out.rectangle[3] = uint32_t(bottom - top);
+  return true;
+}
+
 bool VulkanCommandProcessor::IssueDraw(xenos::PrimitiveType prim_type, uint32_t index_count,
                                        IndexBufferInfo* index_buffer_info,
                                        bool major_mode_explicit) {
+  if (REXCVAR_GET(vulkan_force_msaa_1x)) {
+    // Draws and resolves see their render targets as 1x: the EDRAM layout of a
+    // 1x target of the same pitch is just smaller, so the guest's bases still
+    // don't overlap.
+    RegisterFile& regs = *register_file_;
+    auto surface_info = regs.Get<reg::RB_SURFACE_INFO>();
+    if (surface_info.msaa_samples != xenos::MsaaSamples::k1X) {
+      uint32_t saved = regs[XE_GPU_REG_RB_SURFACE_INFO];
+      surface_info.msaa_samples = xenos::MsaaSamples::k1X;
+      regs[XE_GPU_REG_RB_SURFACE_INFO] = surface_info.value;
+      bool result = IssueDrawWithCurrentRegisters(prim_type, index_count, index_buffer_info,
+                                                  major_mode_explicit);
+      regs[XE_GPU_REG_RB_SURFACE_INFO] = saved;
+      return result;
+    }
+  }
+  if (!REXCVAR_GET(vulkan_msaa_clear_as_1x) || !IsMsaaClearDrawableAs1x(prim_type)) {
+    return IssueDrawWithCurrentRegisters(prim_type, index_count, index_buffer_info,
+                                         major_mode_explicit);
+  }
+  RegisterFile& regs = *register_file_;
+  constexpr uint32_t kPatched[] = {
+      XE_GPU_REG_RB_SURFACE_INFO,         XE_GPU_REG_PA_CL_VTE_CNTL,
+      XE_GPU_REG_PA_CL_VPORT_XSCALE,      XE_GPU_REG_PA_CL_VPORT_XOFFSET,
+      XE_GPU_REG_PA_CL_VPORT_YSCALE,      XE_GPU_REG_PA_CL_VPORT_YOFFSET,
+      XE_GPU_REG_PA_SC_WINDOW_OFFSET,     XE_GPU_REG_PA_SC_WINDOW_SCISSOR_TL,
+      XE_GPU_REG_PA_SC_WINDOW_SCISSOR_BR, XE_GPU_REG_PA_SC_SCREEN_SCISSOR_TL,
+      XE_GPU_REG_PA_SC_SCREEN_SCISSOR_BR,
+  };
+  uint32_t saved[rex::countof(kPatched)];
+  for (size_t i = 0; i < rex::countof(kPatched); ++i) {
+    saved[i] = regs[kPatched[i]];
+  }
+
+  auto surface_info = regs.Get<reg::RB_SURFACE_INFO>();
+  surface_info.msaa_samples = xenos::MsaaSamples::k1X;
+  surface_info.surface_pitch *= 2;
+  regs[XE_GPU_REG_RB_SURFACE_INFO] = surface_info.value;
+
+  // Doubling the viewport doubles the rectangle; a disabled scale is 1.
+  auto vte_cntl = regs.Get<reg::PA_CL_VTE_CNTL>();
+  auto double_float = [&](uint32_t reg, bool enabled, float disabled_value) {
+    float value = enabled ? regs.Get<float>(reg) : disabled_value;
+    regs[reg] = rex::memory::Reinterpret<uint32_t>(value * 2.0f);
+  };
+  double_float(XE_GPU_REG_PA_CL_VPORT_XSCALE, vte_cntl.vport_x_scale_ena, 1.0f);
+  double_float(XE_GPU_REG_PA_CL_VPORT_YSCALE, vte_cntl.vport_y_scale_ena, 1.0f);
+  double_float(XE_GPU_REG_PA_CL_VPORT_XOFFSET, vte_cntl.vport_x_offset_ena, 0.0f);
+  double_float(XE_GPU_REG_PA_CL_VPORT_YOFFSET, vte_cntl.vport_y_offset_ena, 0.0f);
+  vte_cntl.vport_x_scale_ena = 1;
+  vte_cntl.vport_y_scale_ena = 1;
+  vte_cntl.vport_x_offset_ena = 1;
+  vte_cntl.vport_y_offset_ena = 1;
+  regs[XE_GPU_REG_PA_CL_VTE_CNTL] = vte_cntl.value;
+
+  auto window_offset = regs.Get<reg::PA_SC_WINDOW_OFFSET>();
+  window_offset.window_x_offset *= 2;
+  window_offset.window_y_offset *= 2;
+  regs[XE_GPU_REG_PA_SC_WINDOW_OFFSET] = window_offset.value;
+  auto window_scissor_tl = regs.Get<reg::PA_SC_WINDOW_SCISSOR_TL>();
+  window_scissor_tl.tl_x = std::min(uint32_t(window_scissor_tl.tl_x) * 2, uint32_t(0x3FFF));
+  window_scissor_tl.tl_y = std::min(uint32_t(window_scissor_tl.tl_y) * 2, uint32_t(0x3FFF));
+  regs[XE_GPU_REG_PA_SC_WINDOW_SCISSOR_TL] = window_scissor_tl.value;
+  auto window_scissor_br = regs.Get<reg::PA_SC_WINDOW_SCISSOR_BR>();
+  window_scissor_br.br_x = std::min(uint32_t(window_scissor_br.br_x) * 2, uint32_t(0x3FFF));
+  window_scissor_br.br_y = std::min(uint32_t(window_scissor_br.br_y) * 2, uint32_t(0x3FFF));
+  regs[XE_GPU_REG_PA_SC_WINDOW_SCISSOR_BR] = window_scissor_br.value;
+  auto screen_scissor_tl = regs.Get<reg::PA_SC_SCREEN_SCISSOR_TL>();
+  screen_scissor_tl.tl_x = std::min(int32_t(screen_scissor_tl.tl_x) * 2, int32_t(0x3FFF));
+  screen_scissor_tl.tl_y = std::min(int32_t(screen_scissor_tl.tl_y) * 2, int32_t(0x3FFF));
+  regs[XE_GPU_REG_PA_SC_SCREEN_SCISSOR_TL] = screen_scissor_tl.value;
+  auto screen_scissor_br = regs.Get<reg::PA_SC_SCREEN_SCISSOR_BR>();
+  screen_scissor_br.br_x = std::min(int32_t(screen_scissor_br.br_x) * 2, int32_t(0x3FFF));
+  screen_scissor_br.br_y = std::min(int32_t(screen_scissor_br.br_y) * 2, int32_t(0x3FFF));
+  regs[XE_GPU_REG_PA_SC_SCREEN_SCISSOR_BR] = screen_scissor_br.value;
+
+  bool result = IssueDrawWithCurrentRegisters(prim_type, index_count, index_buffer_info,
+                                              major_mode_explicit);
+  for (size_t i = 0; i < rex::countof(kPatched); ++i) {
+    regs[kPatched[i]] = saved[i];
+  }
+  return result;
+}
