--- /dev/null
+++ b/include/rex/graphics/shader_override.h
@@ -0,0 +1,36 @@
+/**
+ * @file        rex/graphics/shader_override.h
+ * @brief       Mod hook that replaces guest shaders by their ucode hash.
+ *
+ * The game registers a function that, for a shader (type, ucode hash, modification), returns the
+ * bytes of a replacement file or null. The Vulkan backend then builds the shader module from it:
+ * a SPIR-V binary (magic 0x07230203) is used as is, anything else is GLSL (#version 450) compiled
+ * with glslang. The replacement must keep the interface of the shader it replaces (the
+ * descriptor layout of the pipeline comes from the original translation).
+ */
+#pragma once
+
+#include <cstdint>
+#include <string>
+#include <string_view>
+#include <vector>
+
+#include <rex/graphics/xenos.h>
+
+namespace rex::graphics {
+
+// type: xenos::ShaderType (0 vertex, 1 pixel). Returns null for "no replacement".
+using GuestShaderOverrideFn = const std::vector<uint8_t>* (*)(uint32_t type, uint64_t ucode_hash,
+                                                              uint64_t modification);
+void SetGuestShaderOverride(GuestShaderOverrideFn fn);
+GuestShaderOverrideFn GetGuestShaderOverride();
+
+namespace vulkan {
+
+// Compiles replacement GLSL for the stage of the shader type (defined in command_processor.cpp,
+// where the glslang resources are). On failure returns false and fills error_out.
+bool CompileShaderOverrideGlsl(xenos::ShaderType type, std::string_view source,
+                               std::vector<uint32_t>& spirv_out, std::string& error_out);
+
+}  // namespace vulkan
+}  // namespace rex::graphics
