-            (UINT32_C(1) << std::min(input_clip_distance_count - j, UINT32_C(4))) - 1;
-        uint32_t input_register_clip_distance = input_register_clip_and_cull_distances + (j >> 2);
-        a.OpAdd(dxbc::Dest::R(1, clip_distance_mask),
