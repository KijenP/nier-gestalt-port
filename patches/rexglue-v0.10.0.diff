+// FXAA over the raw swap texture (luma from the color, not from the alpha of
+// the gamma + luma pass) that applies the gamma ramp to the pixel it writes.
+// Non-edge pixels come out exactly as gamma then FXAA; edge blends are
+// filtered before the ramp instead of after, as on the console's scanout.
+std::string GetSwapFxaaGammaComputeSource(bool use_pwl, bool extreme_quality) {
+  std::string source = GetSwapFxaaComputeSource(extreme_quality);
+  auto replace = [&source](std::string_view from, std::string_view to) {
+    size_t pos = source.find(from);
+    assert_true(pos != std::string::npos);
+    source.replace(pos, from.size(), to);
+  };
+  std::string_view dest = "writeonly uniform image2D xe_fxaa_dest;\n";
+  replace(dest, std::string(dest) +
+                    (use_pwl ? R"(layout(set = 2, binding = 0) uniform utextureBuffer xe_apply_gamma_ramp;
+float ApplyPwl(uint source_value_10b, uint channel) {
+  uint source_value_base = source_value_10b >> 3u;
+  uvec4 pwl = texelFetch(xe_apply_gamma_ramp, int(source_value_base * 3u + channel));
+  float value = float(pwl.x) + float((source_value_10b & 7u) * pwl.y) * 0.125;
+  return clamp(value * 1.52737048e-05, 0.0, 1.0);
+}
+vec3 ApplyGamma(vec3 color) {
+  uvec3 source = uvec3(color * 1023.0 + vec3(0.5));
+  return vec3(ApplyPwl(source.r, 0u), ApplyPwl(source.g, 1u), ApplyPwl(source.b, 2u));
+}
+)"
+                             : R"(layout(set = 2, binding = 0) uniform textureBuffer xe_apply_gamma_ramp;
+vec3 ApplyGamma(vec3 color) {
+  uvec3 source = uvec3(color * 255.0 + vec3(0.5));
+  return vec3(texelFetch(xe_apply_gamma_ramp, int(source.r)).b,
+              texelFetch(xe_apply_gamma_ramp, int(source.g)).g,
+              texelFetch(xe_apply_gamma_ramp, int(source.b)).r);
+}
+)"));
+  replace("return textureLod(xe_fxaa_source, uv, 0.0).a;",
+          "return dot(textureLod(xe_fxaa_source, uv, 0.0).rgb, kLumaWeights);");
+  replace("float lumaM = rgbm.a;", "float lumaM = dot(rgbm.rgb, kLumaWeights);");
+  replace("vec4(result, 1.0)", "vec4(ApplyGamma(result), 1.0)");
+  return source;
+}
