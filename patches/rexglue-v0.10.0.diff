+// --- Lazy resolve readback --------------------------------------------------
+//
+// Some titles (NieR's eye adaptation) need a resolve's result on the CPU in the
+// same frame. Reading it back synchronously stalls the GPU thread until the GPU
+// drains, and the delayed ("fast") readback hands the guest data from two frames
+// earlier (NieR: a white image). Instead, the copy into a readback buffer is
+// recorded without waiting and the guest page is made inaccessible; the first
+// guest access faults, and only then (usually after the GPU has finished) the
+// handler waits for the copy, delivers the data and restores the page. Same
+// approach as the D3D12 backend, using the portable exception handler and page
+// protection, and a dedicated fence so guest threads never touch the submission
+// fences the GPU thread recycles.
+
+bool VulkanCommandProcessor::LazyReadbackExceptionHandler(arch::Exception* ex, void* data) {
+  if (ex->code() != arch::Exception::Code::kAccessViolation) {
+    return false;
+  }
+  auto* self = static_cast<VulkanCommandProcessor*>(data);
+  if (!self->lazy_pending_.load()) {
+    return false;
+  }
+  return self->HandleLazyReadbackFault(reinterpret_cast<const uint8_t*>(ex->fault_address()));
+}
+
+bool VulkanCommandProcessor::IsLazyReadbackAddress(uint32_t physical_address) const {
+  std::string_view list = REXCVAR_GET(readback_resolve_lazy_addresses);
+  while (!list.empty()) {
+    size_t comma = list.find(',');
+    std::string_view item = list.substr(0, comma);
+    uint32_t value = 0;
+    std::from_chars(item.data(), item.data() + item.size(), value, 16);
+    if (value == physical_address) {
+      return true;
+    }
+    list = comma == std::string_view::npos ? std::string_view() : list.substr(comma + 1);
+  }
+  return false;
+}
+
+bool VulkanCommandProcessor::IsResolveReadBack(uint32_t physical_address) const {
+  // Like IssueCopy_ReadbackResolvePath.
+  if (GetReadbackResolveMode(REXCVAR_GET(vulkan_readback_resolve)) ==
+      ReadbackResolveMode::kDisabled) {
+    return false;
+  }
+  if (REXCVAR_GET(readback_resolve_lazy_addresses).empty()) {
+    return true;
+  }
+  return IsLazyReadbackAddress(physical_address);
+}
+
+bool VulkanCommandProcessor::WaitLazyFence(uint64_t timeout_ns) {
+  if (!lazy_fence_submitted_.load()) {
+    return false;
+  }
+  const ui::vulkan::VulkanDevice* const vulkan_device = GetVulkanDevice();
+  return vulkan_device->functions().vkWaitForFences(vulkan_device->device(), 1, &lazy_fence_,
+                                                    VK_TRUE, timeout_ns) == VK_SUCCESS;
+}
+
+// Copies the pending data (if asked) and restores the original protection of
+// every view. Caller holds lazy_mutex_ and has made sure the GPU is done.
+void VulkanCommandProcessor::FinishLazyReadbackLocked(bool copy) {
+  if (!lazy_.active) {
+    return;
+  }
+  lazy_.active = false;
+  lazy_pending_ = false;
+  // TEMP (Android debugging)
+  static uint32_t dropped = 0;
+  if (!copy && (++dropped <= 5 || !(dropped % 120))) {
+    REXGPU_INFO("LAZYDBG dropped #{}", dropped);
+  }
+  for (int i = 0; i < 4; ++i) {
+    if (lazy_.views[i]) {
+      memory::Protect(lazy_.views[i], lazy_.length, lazy_.old_access[i]);
+    }
+  }
+  if (copy) {
+    const ui::vulkan::VulkanDevice* const vulkan_device = GetVulkanDevice();
+    VkMappedMemoryRange range = {};
+    range.sType = VK_STRUCTURE_TYPE_MAPPED_MEMORY_RANGE;
+    range.memory = lazy_.source_memory;
+    range.offset = 0;
+    range.size = VK_WHOLE_SIZE;
+    vulkan_device->functions().vkInvalidateMappedMemoryRanges(vulkan_device->device(), 1, &range);
+    // May fault into the shared memory write watch, which is the normal path
+    // for CPU writes to GPU-visible memory.
+    std::memcpy(memory_->TranslatePhysical(lazy_.physical_address), lazy_.source, lazy_.length);
+    // TEMP (Android debugging): optional override of the delivered texels.
+    std::string_view override_value = REXCVAR_GET(debug_lazy_readback_override);
+    if (!override_value.empty()) {
+      uint32_t value = 0;
+      std::from_chars(override_value.data(), override_value.data() + override_value.size(), value,
+                      16);
+      uint32_t* dest =
+          reinterpret_cast<uint32_t*>(memory_->TranslatePhysical(lazy_.physical_address));
+      const uint32_t* source = static_cast<const uint32_t*>(lazy_.source);
+      for (uint32_t i = 0; i < lazy_.length / 4; ++i) {
+        if (source[i]) {
+          dest[i] = value;
+        }
+      }
+    }
+    // TEMP (Android debugging): the delivered values.
+    static uint32_t delivered = 0;
+    if (++delivered <= 5 || !(delivered % 120)) {
+      const uint32_t* data = static_cast<const uint32_t*>(lazy_.source);
+      REXGPU_INFO(
+          "LAZYDBG delivered #{} f={}: {:08X} {:08X} {:08X} {:08X} {:08X} {:08X} {:08X} {:08X}",
+          delivered, GetCurrentFrame(), data[0], data[1], data[2], data[3], data[4], data[5],
+          data[6], data[7]);
+    }
+    if (int32_t(delivered) == REXCVAR_GET(debug_reslog_at_delivery)) {
+      NierResolveLogFrameOverride() = GetCurrentFrame() + 2;
+      REXGPU_INFO("LAZYDBG resolve log from frame {}", GetCurrentFrame() + 2);
+    }
+  }
+}
+
+void VulkanCommandProcessor::ArmLazyReadback(uint32_t physical_address, uint32_t length,
+                                             const void* source, VkDeviceMemory source_memory) {
+  if (!source) {
+    return;
+  }
+  const ui::vulkan::VulkanDevice* const vulkan_device = GetVulkanDevice();
+  const ui::vulkan::VulkanDevice::Functions& dfn = vulkan_device->functions();
+  const VkDevice device = vulkan_device->device();
+  if (lazy_fence_ == VK_NULL_HANDLE) {
+    VkFenceCreateInfo fence_create_info = {};
+    fence_create_info.sType = VK_STRUCTURE_TYPE_FENCE_CREATE_INFO;
+    if (dfn.vkCreateFence(device, &fence_create_info, nullptr, &lazy_fence_) != VK_SUCCESS) {
+      lazy_fence_ = VK_NULL_HANDLE;
+      return;
+    }
+  }
+  if (!lazy_handler_installed_) {
+    arch::ExceptionHandler::Install(LazyReadbackExceptionHandler, this);
+    lazy_handler_installed_ = true;
+    REXGPU_INFO("Lazy resolve readback active for {:08X} ({} bytes)", physical_address, length);
+  }
+  uint64_t submission = GetCurrentSubmission();
+  std::lock_guard lock(lazy_mutex_);
+  if (lazy_.active && !lazy_fence_submitted_.load()) {
+    // The previous result is still in the open submission (two lazy resolves
+    // in one submission): send it, together with the fence.
+    EndSubmission(false);
+  }
+  if (lazy_fence_submitted_.load()) {
+    // Unread previous result (or a fence a timed-out waiter left pending):
+    // finish it and make the fence reusable.
+    bool done = WaitLazyFence(UINT64_MAX);
+    FinishLazyReadbackLocked(done);
+    dfn.vkResetFences(device, 1, &lazy_fence_);
+    lazy_fence_submitted_ = false;
+  }
+  if (submission < GetCurrentSubmission()) {
+    // This copy went out with the submission just ended and has completed:
+    // deliver it now.
+    lazy_ = {};
+    lazy_.physical_address = physical_address;
+    lazy_.length = length;
+    lazy_.source = source;
+    lazy_.source_memory = source_memory;
+    lazy_.active = true;
+    FinishLazyReadbackLocked(true);
+    return;
+  }
+  lazy_ = {};
+  lazy_.physical_address = physical_address;
+  lazy_.length = length;
+  lazy_.source = source;
+  lazy_.source_memory = source_memory;
+  lazy_.submission = submission;
+  // The physical view plus the guest's cached/uncached virtual mirrors.
+  const uint32_t mirrors[] = {0xA0000000u, 0xC0000000u, 0xE0000000u};
+  lazy_.views[0] = memory_->TranslatePhysical(physical_address);
+  for (int i = 0; i < 3; ++i) {
+    lazy_.views[i + 1] = memory_->TranslateVirtual(mirrors[i] + physical_address);
+  }
+  for (int i = 0; i < 4; ++i) {
+    if (lazy_.views[i] && !memory::Protect(lazy_.views[i], length, memory::PageAccess::kNoAccess,
+                                           &lazy_.old_access[i])) {
+      // TEMP (Android debugging)
+      REXGPU_WARN("LAZYDBG protect failed for view {} ({})", i, static_cast<void*>(lazy_.views[i]));
+      lazy_.views[i] = nullptr;
+    }
+  }
+  lazy_.active = true;
+  lazy_pending_ = true;
+  lazy_fence_for_submission_ = submission;
+}
+
+bool VulkanCommandProcessor::HandleLazyReadbackFault(const uint8_t* host_address) {
+  std::lock_guard lock(lazy_mutex_);
+  if (!lazy_.active) {
+    return false;
+  }
+  bool ours = false;
+  for (uint8_t* view : lazy_.views) {
+    if (view && host_address >= view && host_address < view + lazy_.length) {
+      ours = true;
+    }
+  }
+  if (!ours) {
+    return false;
+  }
+  bool copy;
+  if (std::this_thread::get_id() == worker_thread_id_.load()) {
+    // The GPU thread itself touched the page; it cannot wait for its own
+    // submission here. Deliver only if it already completed.
+    copy = WaitLazyFence(0);
+  } else {
+    auto waitdbg_start = std::chrono::steady_clock::now();  // TEMP WAITDBG
+    // Make sure the submission holding the copy has been sent to the GPU.
+    if (!lazy_fence_submitted_.load()) {
+      lazy_flush_requested_ = true;
+      for (int i = 0; i < 700 && !lazy_fence_submitted_.load(); ++i) {
+        if (i < 200) {
+          std::this_thread::yield();
+        } else {
+          std::this_thread::sleep_for(std::chrono::milliseconds(1));
+        }
+      }
+    }
+    copy = WaitLazyFence(250ull * 1000 * 1000);
+    g_waitdbg_lazy_us += uint64_t(std::chrono::duration_cast<std::chrono::microseconds>(
+                                      std::chrono::steady_clock::now() - waitdbg_start)
+                                      .count());
+  }
+  // TEMP (Android debugging): how the faults go, with the delivered data.
+  static uint32_t faults = 0, copies = 0;
+  ++faults;
+  copies += copy;
+  if (faults <= 5 || !(faults % 300)) {
+    const uint32_t* data = static_cast<const uint32_t*>(lazy_.source);
+    REXGPU_INFO("LAZYDBG faults={} copies={} gpu_thread={} data {:08X} {:08X} {:08X} {:08X}",
+                faults, copies, std::this_thread::get_id() == worker_thread_id_.load(),
+                data ? data[0] : 0, data ? data[1] : 0, data ? data[2] : 0, data ? data[3] : 0);
+  }
+  FinishLazyReadbackLocked(copy);
+  return true;
+}
+
+// GPU thread: a guest thread waiting for lazy data asked for the open
+// submission to be sent. Safe between draws/copies (the synchronous readback
+// path ends submissions at the same points).
+void VulkanCommandProcessor::ServiceLazyFlushRequest() {
+  if (lazy_flush_requested_.exchange(false) && submission_open_) {
+    EndSubmission(false);
+  }
+}
+
+void VulkanCommandProcessor::PrepareForWait() {
+  // Going idle with lazy data not yet sent: send it now, so a guest thread
+  // that touches it later never waits for a submission the idle GPU thread
+  // holds.
+  if ((lazy_fence_for_submission_.load() != 0 || lazy_flush_requested_.exchange(false)) &&
+      submission_open_) {
+    EndSubmission(false);
+  }
+  CommandProcessor::PrepareForWait();
+}
+
+void VulkanCommandProcessor::ShutdownLazyReadback() {
+  {
+    std::lock_guard lock(lazy_mutex_);
+    FinishLazyReadbackLocked(false);
+  }
+  if (lazy_handler_installed_) {
+    arch::ExceptionHandler::Uninstall(LazyReadbackExceptionHandler, this);
+    lazy_handler_installed_ = false;
+  }
+  if (lazy_fence_ != VK_NULL_HANDLE) {
+    const ui::vulkan::VulkanDevice* const vulkan_device = GetVulkanDevice();
+    vulkan_device->functions().vkDestroyFence(vulkan_device->device(), lazy_fence_, nullptr);
+    lazy_fence_ = VK_NULL_HANDLE;
+  }
+  lazy_fence_submitted_ = false;
+  lazy_fence_for_submission_ = 0;
+}
