+        needed.set(operand.storage_index * 4 + uint32_t(component));
+      }
+    }
+  };
+  auto is_result_precise = [&](const InstructionResult& result) {
+    uint32_t write_mask = result.GetUsedWriteMask();
+    if (!write_mask) {
+      return false;
+    }
+    switch (result.storage_target) {
+      case InstructionStorageTarget::kNone:
+      case InstructionStorageTarget::kColor:
+        return false;
+      case InstructionStorageTarget::kRegister:
+        if (result.storage_addressing_mode != InstructionStorageAddressingMode::kAbsolute ||
+            result.storage_index >= xenos::kMaxShaderTempRegisters) {
+          return true;
+        }
+        for (uint32_t i = 0; i < 4; ++i) {
+          if ((write_mask & (1 << i)) && needed.test(result.storage_index * 4 + i)) {
+            return true;
+          }
+        }
+        return false;
+      default:
+        return true;
+    }
+  };
+  auto kill_result = [&](const InstructionResult& result) {
+    if (result.storage_target != InstructionStorageTarget::kRegister ||
+        result.storage_addressing_mode != InstructionStorageAddressingMode::kAbsolute ||
+        result.storage_index >= xenos::kMaxShaderTempRegisters) {
+      return;
+    }
+    uint32_t write_mask = result.GetUsedWriteMask();
+    for (uint32_t i = 0; i < 4; ++i) {
+      if (write_mask & (1 << i)) {
+        needed.reset(result.storage_index * 4 + i);
+      }
+    }
+  };
+  auto reads_previous_scalar = [](ucode::AluScalarOpcode opcode) {
+    switch (opcode) {
+      case ucode::AluScalarOpcode::kAddsPrev:
+      case ucode::AluScalarOpcode::kMulsPrev:
+      case ucode::AluScalarOpcode::kMulsPrev2:
+      case ucode::AluScalarOpcode::kSubsPrev:
+      case ucode::AluScalarOpcode::kRetainPrev:
+        return true;
+      default:
+        return false;
+    }
+  };
+  std::vector<bool> alu_precise(alu_instructions.size(), false);
+  bool changed = true;
+  while (changed && !give_up) {
+    changed = false;
+    for (auto step_it = steps.rbegin(); step_it != steps.rend() && !give_up; ++step_it) {
+      const Step& step = *step_it;
+      if (step.alu_index == UINT32_MAX) {
+        for (uint32_t k = 0; k < step.fetch_operand_count; ++k) {
+          mark_operand(step.fetch_operands[k]);
+        }
+        continue;
+      }
+      const ParsedAluInstruction& alu_instr = alu_instructions[step.alu_index];
+      if (alu_instr.IsNop()) {
+        continue;
+      }
+      bool is_precise =
+          alu_precise[step.alu_index] || is_result_precise(alu_instr.vector_and_constant_result) ||
+          is_result_precise(alu_instr.scalar_result) ||
+          alu_instr.vector_opcode == ucode::AluVectorOpcode::kMaxA ||
+          alu_instr.scalar_opcode == ucode::AluScalarOpcode::kMaxAs ||
+          alu_instr.scalar_opcode == ucode::AluScalarOpcode::kMaxAsf ||
+          (needed.test(kPreviousScalar) &&
+           alu_instr.scalar_opcode != ucode::AluScalarOpcode::kRetainPrev);
+      if (is_straight_line && !step.is_conditional) {
+        kill_result(alu_instr.vector_and_constant_result);
+        kill_result(alu_instr.scalar_result);
+      }
+      if (!is_precise) {
+        continue;
+      }
+      if (!alu_precise[step.alu_index]) {
+        alu_precise[step.alu_index] = true;
+        changed = true;
+      }
+      for (uint32_t l = 0; l < alu_instr.vector_operand_count; ++l) {
+        mark_operand(alu_instr.vector_operands[l]);
+      }
+      for (uint32_t l = 0; l < alu_instr.scalar_operand_count; ++l) {
+        mark_operand(alu_instr.scalar_operands[l]);
+      }
+      if (reads_previous_scalar(alu_instr.scalar_opcode)) {
+        needed.set(kPreviousScalar);
+      }
+    }
+    // Lifetimes are exact in straight-line code - one pass is enough.
+    if (is_straight_line) {
+      break;
+    }
+  }
+  if (give_up) {
+    return;
+  }
+
+  alu_relaxed_precision_.resize(alu_instructions.size());
+  for (size_t k = 0; k < alu_instructions.size(); ++k) {
+    alu_relaxed_precision_[k] = !alu_precise[k];
+  }
+}
