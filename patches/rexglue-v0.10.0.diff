-  a_.OpBreak();
-
-  // kConstantAlpha
-  a_.OpCase(dxbc::Src::LU(uint32_t(xenos::BlendFactor::kConstantAlpha)));
-  a_.OpMov(factor_dest,
-           LoadSystemConstant(SystemConstants::Index::kEdramBlendConstant,
