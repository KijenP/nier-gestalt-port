+  // its operands read become needed.
+  constexpr uint32_t kPreviousScalar = xenos::kMaxShaderTempRegisters * 4;
+  std::bitset<xenos::kMaxShaderTempRegisters * 4 + 1> needed;
+  bool give_up = false;
