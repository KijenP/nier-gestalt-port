-              if (!(used_format_components & (1 << i))) {
-                continue;
-              }
-              if (packed_widths[i] > 2) {
-                packed_scales[i] = 1.0f / float((uint32_t(1) << (packed_widths[i] - 1)) - 1);
-                packed_scales_mask |= 1 << i;
-              }
-            }
-            if (packed_scales_mask) {
