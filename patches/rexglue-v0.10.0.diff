-    : Texture(texture_cache, key, track_usage),
-      resource_(resource),
-      resource_state_(resource_state) {
-  ID3D12Device* device = texture_cache.command_processor_.GetD3D12Provider().GetDevice();
-  D3D12_RESOURCE_DESC resource_desc = resource_->GetDesc();
