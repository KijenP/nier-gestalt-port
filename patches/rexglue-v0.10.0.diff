+bool VulkanCommandProcessor::IsMsaaClearDrawableAs1x(xenos::PrimitiveType prim_type) {
+  // Xbox 360 games (Direct3D's clear among them) clear a 1x surface quickly by
+  // drawing a rectangle at 4x MSAA over the same EDRAM tiles: a 4x pixel holds
+  // 2x2 1x pixels as its samples. Here the host would transfer the 1x render
+  // target to a 4x one, clear it, and transfer it back. If every sample gets
+  // the same value regardless of its position, drawing the rectangle at 1x
+  // with all coordinates doubled writes exactly the same EDRAM samples.
+  const RegisterFile& regs = *register_file_;
+  if (prim_type != xenos::PrimitiveType::kRectangleList ||
+      regs.Get<reg::RB_SURFACE_INFO>().msaa_samples != xenos::MsaaSamples::k4X ||
+      regs.Get<reg::RB_SURFACE_INFO>().surface_pitch * 2 > 0x3FFF ||
+      (regs[XE_GPU_REG_PA_SC_AA_MASK] & 0xF) != 0xF ||
+      regs.Get<reg::RB_COLORCONTROL>().alpha_to_mask_enable) {
+    return false;
+  }
+  xenos::EdramMode edram_mode = regs.Get<reg::RB_MODECONTROL>().edram_mode;
+  if (edram_mode != xenos::EdramMode::kColorDepth && edram_mode != xenos::EdramMode::kDepthOnly) {
+    return false;
+  }
+  auto vertex_shader = static_cast<VulkanShader*>(active_vertex_shader());
+  if (!vertex_shader) {
+    return false;
+  }
+  pipeline_cache_->AnalyzeShaderUcode(*vertex_shader);
+  if (!vertex_shader->texture_bindings().empty() || vertex_shader->memexport_eM_written()) {
+    return false;
+  }
+  auto pixel_shader = static_cast<VulkanShader*>(active_pixel_shader());
+  if (pixel_shader && edram_mode == xenos::EdramMode::kColorDepth) {
+    pipeline_cache_->AnalyzeShaderUcode(*pixel_shader);
+    if (!pixel_shader->texture_bindings().empty() || pixel_shader->memexport_eM_written()) {
+      return false;
+    }
+  }
+  return true;
+}
