+    uint64_t hash = 0;
+  } saved_vertex, saved_pixel;
+  auto save_shader = [](const Shader* shader, SavedShader& saved) {
+    if (!shader) return;
+    saved.ucode.resize(shader->ucode_dword_count());
+    memory::copy_and_swap(saved.ucode.data(), shader->ucode_dwords(), saved.ucode.size());
+    saved.hash = shader->ucode_data_hash();
