+// TOML basic string. Values such as Windows paths contain backslashes, which
+// written raw ("E:\NIER\...") make the whole file fail to parse on next load.
+static std::string QuoteTomlString(const std::string& value) {
+  std::string out = "\"";
+  for (char c : value) {
+    switch (c) {
+      case '\\': out += "\\\\"; break;
+      case '"': out += "\\\""; break;
+      case '\n': out += "\\n"; break;
+      case '\r': out += "\\r"; break;
+      case '\t': out += "\\t"; break;
+      default: out += c;
+    }
+  }
+  return out + "\"";
+}
