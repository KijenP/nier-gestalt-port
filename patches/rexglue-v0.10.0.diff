+void VulkanCommandProcessor::TrackDrawArea() {
+  if (!draw_area_tracking_) {
+    return;
+  }
+  // The scissor, within the viewport with a margin for points and lines wider
+  // than a pixel.
+  constexpr int32_t kViewportMargin = 64;
+  int32_t x0 = std::max(dynamic_scissor_.offset.x,
+                        int32_t(std::floor(dynamic_viewport_.x)) - kViewportMargin);
+  int32_t y0 = std::max(dynamic_scissor_.offset.y,
+                        int32_t(std::floor(dynamic_viewport_.y)) - kViewportMargin);
+  int32_t x1 = std::min(
+      dynamic_scissor_.offset.x + int32_t(dynamic_scissor_.extent.width),
+      int32_t(std::ceil(dynamic_viewport_.x + dynamic_viewport_.width)) + kViewportMargin);
+  int32_t y1 = std::min(
+      dynamic_scissor_.offset.y + int32_t(dynamic_scissor_.extent.height),
+      int32_t(std::ceil(dynamic_viewport_.y + dynamic_viewport_.height)) + kViewportMargin);
+  if (const int32_t cap_y = REXCVAR_GET(vulkan_draw_area_cap_y)) {
+    y1 = std::min(y1, cap_y);
+  }
+  // Clears often have a viewport and scissor as tall as the EDRAM while their
+  // vertices only cover the screen: also limit by the render target cache's
+  // estimate of the rows the draw touches (from the vertices if
+  // execute_unclipped_draw_vs_on_cpu). It's in guest pixels, the total in
+  // samples (2 rows per pixel with 2x and 4x MSAA), the framebuffer covers the
+  // whole total.
+  if (REXCVAR_GET(vulkan_draw_area_estimate) && current_framebuffer_) {
+    uint32_t total = render_target_cache_->last_update_height_total();
+    if (total) {
+      uint32_t used = render_target_cache_->last_update_height_used()
+                      << uint32_t(register_file_->Get<reg::RB_SURFACE_INFO>().msaa_samples >=
+                                  xenos::MsaaSamples::k2X);
+      uint64_t host_height = current_framebuffer_->host_extent.height;
+      int32_t used_y1 = int32_t((uint64_t(std::min(used, total)) * host_height + total - 1) / total) +
+                        kViewportMargin;
+      y1 = std::min(y1, used_y1);
+    }
+  }
+  if (x1 <= x0 || y1 <= y0) {
+    return;
+  }
+  draw_area_x0_ = std::min(draw_area_x0_, x0);
+  draw_area_y0_ = std::min(draw_area_y0_, y0);
+  draw_area_x1_ = std::max(draw_area_x1_, x1);
+  draw_area_y1_ = std::max(draw_area_y1_, y1);
+}
+
+void VulkanCommandProcessor::FinishDrawArea() {
+  if (!draw_area_tracking_) {
+    return;
+  }
+  draw_area_tracking_ = false;
+  if (!in_render_pass_ || !current_framebuffer_) {
+    return;
+  }
+  const VkExtent2D& extent = current_framebuffer_->host_extent;
+  int32_t x0 = std::max(draw_area_x0_, 0), y0 = std::max(draw_area_y0_, 0);
+  int32_t x1 = std::min(draw_area_x1_, int32_t(extent.width));
+  int32_t y1 = std::min(draw_area_y1_, int32_t(extent.height));
+  VkRect2D area;
+  if (x1 <= x0 || y1 <= y0) {
+    // Nothing drawn - the smallest area.
+    area.offset = {0, 0};
+    area.extent = {1, 1};
+  } else {
+    area.offset = {x0, y0};
+    area.extent = {uint32_t(x1 - x0), uint32_t(y1 - y0)};
+  }
+  deferred_command_buffer_.SetLastRenderPassArea(area);
+}
