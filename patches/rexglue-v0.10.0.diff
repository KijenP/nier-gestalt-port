diff --git a/src/kernel/xboxkrnl/xboxkrnl_threading.cpp b/src/kernel/xboxkrnl/xboxkrnl_threading.cpp
index 57fd161..e368f5a 100644
--- a/src/kernel/xboxkrnl/xboxkrnl_threading.cpp
+++ b/src/kernel/xboxkrnl/xboxkrnl_threading.cpp
@@ -15,6 +15,8 @@
 #include <algorithm>
 #include <atomic>
 #include <chrono>
+#include <cstdlib>
+#include <cstring>
 #include <memory>
 #include <vector>
 
@@ -43,6 +45,35 @@ namespace rex::kernel::xboxkrnl {
 using namespace rex::system;
 using rex::runtime::current_ppc_context;
 
+// TEMP EVENTLOG: NIER_EVENT_LOG=<start s>|<length ms> logs every event set and
+// every wait (with how long it blocked) in that window after the first call.
+static bool EventLogActive() {
+  static const auto origin = std::chrono::steady_clock::now();
+  static const std::pair<int64_t, int64_t> window = [] {
+    const char* spec = std::getenv("NIER_EVENT_LOG");
+    if (!spec || !*spec) return std::make_pair(int64_t(-1), int64_t(0));
+    const char* bar = std::strchr(spec, '|');
+    int64_t start_ms = int64_t(std::atoi(spec)) * 1000;
+    return std::make_pair(start_ms, start_ms + (bar ? std::atoi(bar + 1) : 500));
+  }();
+  if (window.first < 0) return false;
+  int64_t now_ms = std::chrono::duration_cast<std::chrono::milliseconds>(
+                       std::chrono::steady_clock::now() - origin)
+                       .count();
+  return now_ms >= window.first && now_ms < window.second;
+}
+
+static void EventLog(const char* what, const void* object, int64_t waited_us = -1) {
+  static const auto origin = std::chrono::steady_clock::now();
+  int64_t now_us = std::chrono::duration_cast<std::chrono::microseconds>(
+                       std::chrono::steady_clock::now() - origin)
+                       .count();
+  XThread* thread = XThread::IsInThread() ? XThread::GetCurrentThread() : nullptr;
+  PPCContext* ctx = current_ppc_context();
+  REXKRNL_INFO("EVENTLOG t={} {} obj={} thread={:08X} lr={:08X} waited_us={}", now_us, what,
+               object, thread ? thread->handle() : 0u, ctx ? uint32_t(ctx->lr) : 0u, waited_us);
+}
+
 // r13 + 0x100: pointer to thread local state
 // Thread local state:
 //   0x058: kernel time
@@ -468,6 +499,7 @@ uint32_t xeKeSetEvent(X_KEVENT* event_ptr, uint32_t increment, uint32_t wait) {
     assert_always();
     return 0;
   }
+  if (EventLogActive()) EventLog("KeSetEvent", ev.get());  // TEMP EVENTLOG
 
   return ev->Set(increment, !!wait);
 }
@@ -532,6 +564,7 @@ uint32_t xeNtSetEvent(uint32_t handle, rex::be<uint32_t>* previous_state_ptr) {
 
   auto ev = REX_KERNEL_OBJECTS()->LookupObject<XEvent>(handle);
   if (ev) {
+    if (EventLogActive()) EventLog("NtSetEvent", ev.get());  // TEMP EVENTLOG
     int32_t was_signalled = ev->Set(0, false);
     if (previous_state_ptr) {
       *previous_state_ptr = static_cast<uint32_t>(was_signalled);
@@ -857,7 +890,14 @@ u32 NtWaitForSingleObjectEx_entry(u32 object_handle, u32 wait_mode, u32 alertabl
   auto object = REX_KERNEL_OBJECTS()->LookupObject<XObject>(object_handle);
   if (object) {
     uint64_t timeout = timeout_ptr ? static_cast<uint64_t>(*timeout_ptr) : 0u;
+    auto eventlog_start = std::chrono::steady_clock::now();  // TEMP EVENTLOG
     result = object->Wait(3, wait_mode, alertable, timeout_ptr ? &timeout : nullptr);
+    if (EventLogActive()) {
+      EventLog("NtWait", object.get(),
+               std::chrono::duration_cast<std::chrono::microseconds>(
+                   std::chrono::steady_clock::now() - eventlog_start)
+                   .count());
+    }
     if (alertable && result == X_STATUS_USER_APC) {
       XThread::GetCurrentThread()->DeliverAPCs();
     }
