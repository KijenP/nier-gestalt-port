+// TEMP clock probe (NIER_CLOCK_PROBE=1).
+void VulkanCommandProcessor::ProbeInitialize() {
+  probe_enabled_ = std::getenv("NIER_CLOCK_PROBE") != nullptr;
+  if (!probe_enabled_) {
+    return;
+  }
+  probe_enabled_ = false;
+  const ui::vulkan::VulkanDevice* vulkan_device = GetVulkanDevice();
+  const ui::vulkan::VulkanDevice::Functions& dfn = vulkan_device->functions();
+  VkDevice device = vulkan_device->device();
+  VkPhysicalDeviceProperties properties;
+  vulkan_device->vulkan_instance()->functions().vkGetPhysicalDeviceProperties(
+      vulkan_device->physical_device(), &properties);
+  prof_period_ns_ = properties.limits.timestampPeriod;
+  VkQueryPoolCreateInfo pool_info = {};
+  pool_info.sType = VK_STRUCTURE_TYPE_QUERY_POOL_CREATE_INFO;
+  pool_info.queryType = VK_QUERY_TYPE_TIMESTAMP;
+  pool_info.queryCount = kProbeSlots * 3;
+  if (dfn.vkCreateQueryPool(device, &pool_info, nullptr, &probe_pool_) != VK_SUCCESS) {
+    return;
+  }
+  for (uint32_t i = 0; i < 2; ++i) {
+    if (!ui::vulkan::util::CreateDedicatedAllocationBuffer(
+            vulkan_device, kProbeCopySize,
+            VK_BUFFER_USAGE_STORAGE_BUFFER_BIT | VK_BUFFER_USAGE_TRANSFER_SRC_BIT |
+                VK_BUFFER_USAGE_TRANSFER_DST_BIT,
+            ui::vulkan::util::MemoryPurpose::kDeviceLocal, probe_buffers_[i],
+            probe_memories_[i])) {
+      return;
+    }
+  }
+  VkDescriptorSetLayout set_layout =
+      GetSingleTransientDescriptorLayout(SingleTransientDescriptorLayout::kStorageBufferCompute);
+  VkPipelineLayoutCreateInfo layout_info = {};
+  layout_info.sType = VK_STRUCTURE_TYPE_PIPELINE_LAYOUT_CREATE_INFO;
+  layout_info.setLayoutCount = 1;
+  layout_info.pSetLayouts = &set_layout;
+  if (dfn.vkCreatePipelineLayout(device, &layout_info, nullptr, &probe_pipeline_layout_) !=
+      VK_SUCCESS) {
+    return;
+  }
+  static const char kSource[] = R"(#version 450
+layout(local_size_x = 64) in;
+layout(std430, set = 0, binding = 0) buffer XeOut { vec4 xe_out[]; };
+void main() {
+  vec4 a = vec4(float(gl_GlobalInvocationID.x) * 1.0e-6);
+  vec4 b = a + 1.0, c = a + 2.0, d = a + 3.0;
+  for (int i = 0; i < 2048; ++i) {
+    a = fma(a, vec4(0.9999), vec4(0.5));
+    b = fma(b, vec4(1.0001), vec4(-0.5));
+    c = fma(c, vec4(0.99), vec4(0.1));
+    d = fma(d, vec4(1.01), vec4(-0.1));
+  }
+  xe_out[gl_GlobalInvocationID.x] = a + b + c + d;
+}
+)";
+  std::vector<uint32_t> spirv;
+  std::string error;
+  if (!CompileGlslToSpirv(VK_SHADER_STAGE_COMPUTE_BIT, kSource, spirv, error)) {
+    REXGPU_WARN("CLOCKPROBE: shader compilation failed: {}", error);
+    return;
+  }
+  probe_pipeline_ = ui::vulkan::util::CreateComputePipeline(
+      vulkan_device, probe_pipeline_layout_, spirv.data(), sizeof(uint32_t) * spirv.size());
+  if (probe_pipeline_ == VK_NULL_HANDLE) {
+    return;
+  }
+  probe_enabled_ = true;
+  REXGPU_INFO("CLOCKPROBE: enabled");
+}
+
+void VulkanCommandProcessor::ProbeShutdown() {
+  const ui::vulkan::VulkanDevice* vulkan_device = GetVulkanDevice();
+  const ui::vulkan::VulkanDevice::Functions& dfn = vulkan_device->functions();
+  VkDevice device = vulkan_device->device();
+  ui::vulkan::util::DestroyAndNullHandle(dfn.vkDestroyPipeline, device, probe_pipeline_);
+  ui::vulkan::util::DestroyAndNullHandle(dfn.vkDestroyPipelineLayout, device,
+                                         probe_pipeline_layout_);
+  for (uint32_t i = 0; i < 2; ++i) {
+    ui::vulkan::util::DestroyAndNullHandle(dfn.vkDestroyBuffer, device, probe_buffers_[i]);
+    ui::vulkan::util::DestroyAndNullHandle(dfn.vkFreeMemory, device, probe_memories_[i]);
+  }
+  ui::vulkan::util::DestroyAndNullHandle(dfn.vkDestroyQueryPool, device, probe_pool_);
+  probe_enabled_ = false;
+}
+
+void VulkanCommandProcessor::ProbeRecord() {
+  if (!probe_enabled_ || !submission_open_ || GetCurrentFrame() % 60 != 0) {
+    return;
+  }
+  uint32_t slot = uint32_t(probe_count_++ % kProbeSlots);
+  if (probe_slot_submission_[slot]) {
+    return;
+  }
+  VkDescriptorSet descriptor_set =
+      AllocateSingleTransientDescriptor(SingleTransientDescriptorLayout::kStorageBufferCompute);
+  if (descriptor_set == VK_NULL_HANDLE) {
+    return;
+  }
+  const ui::vulkan::VulkanDevice* vulkan_device = GetVulkanDevice();
+  VkDescriptorBufferInfo buffer_info;
+  buffer_info.buffer = probe_buffers_[1];
+  buffer_info.offset = 0;
+  buffer_info.range = VkDeviceSize(65536) * 16;
+  VkWriteDescriptorSet write = {};
+  write.sType = VK_STRUCTURE_TYPE_WRITE_DESCRIPTOR_SET;
+  write.dstSet = descriptor_set;
+  write.descriptorCount = 1;
+  write.descriptorType = VK_DESCRIPTOR_TYPE_STORAGE_BUFFER;
+  write.pBufferInfo = &buffer_info;
+  vulkan_device->functions().vkUpdateDescriptorSets(vulkan_device->device(), 1, &write, 0,
+                                                    nullptr);
+  probe_slot_submission_[slot] = GetCurrentSubmission();
+  // Order after everything before, and the previous probe's copy.
+  PushBufferMemoryBarrier(probe_buffers_[1], 0, VK_WHOLE_SIZE, VK_PIPELINE_STAGE_TRANSFER_BIT,
+                          VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT, VK_ACCESS_TRANSFER_WRITE_BIT,
+                          VK_ACCESS_SHADER_WRITE_BIT);
+  SubmitBarriers(true);
+  deferred_command_buffer_.CmdVkResetQueryPool(probe_pool_, slot * 3, 3);
+  deferred_command_buffer_.CmdVkWriteTimestamp(VK_PIPELINE_STAGE_BOTTOM_OF_PIPE_BIT, probe_pool_,
+                                               slot * 3);
+  BindExternalComputePipeline(probe_pipeline_);
+  deferred_command_buffer_.CmdVkBindDescriptorSets(VK_PIPELINE_BIND_POINT_COMPUTE,
+                                                   probe_pipeline_layout_, 0, 1, &descriptor_set,
+                                                   0, nullptr);
+  deferred_command_buffer_.CmdVkDispatch(1024, 1, 1);
+  PushBufferMemoryBarrier(probe_buffers_[1], 0, VK_WHOLE_SIZE,
+                          VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT, VK_PIPELINE_STAGE_TRANSFER_BIT,
+                          VK_ACCESS_SHADER_WRITE_BIT, VK_ACCESS_TRANSFER_WRITE_BIT);
+  SubmitBarriers(true);
+  deferred_command_buffer_.CmdVkWriteTimestamp(VK_PIPELINE_STAGE_BOTTOM_OF_PIPE_BIT, probe_pool_,
+                                               slot * 3 + 1);
+  VkBufferCopy region;
+  region.srcOffset = 0;
+  region.dstOffset = 0;
+  region.size = kProbeCopySize;
+  deferred_command_buffer_.CmdVkCopyBuffer(probe_buffers_[0], probe_buffers_[1], 1, &region);
+  deferred_command_buffer_.CmdVkWriteTimestamp(VK_PIPELINE_STAGE_BOTTOM_OF_PIPE_BIT, probe_pool_,
+                                               slot * 3 + 2);
+}
+
+void VulkanCommandProcessor::ProbeCollect() {
+  if (!probe_enabled_) {
+    return;
+  }
+  const ui::vulkan::VulkanDevice* vulkan_device = GetVulkanDevice();
+  for (uint32_t slot = 0; slot < kProbeSlots; ++slot) {
+    uint64_t submission = probe_slot_submission_[slot];
+    if (!submission || submission > submission_completed_) {
+      continue;
+    }
+    probe_slot_submission_[slot] = 0;
+    uint64_t values[3];
+    if (vulkan_device->functions().vkGetQueryPoolResults(
+            vulkan_device->device(), probe_pool_, slot * 3, 3, sizeof(values), values,
+            sizeof(uint64_t), VK_QUERY_RESULT_64_BIT) != VK_SUCCESS) {
+      continue;
+    }
+    double alu_us = double(values[1] - values[0]) * prof_period_ns_ / 1000.0;
+    double copy_us = double(values[2] - values[1]) * prof_period_ns_ / 1000.0;
+    REXGPU_INFO("CLOCKPROBE alu={:.1f}us copy64MB={:.1f}us ({:.1f} GB/s)", alu_us, copy_us,
+                copy_us > 0.0 ? 2.0 * 64.0 / 1024.0 / (copy_us * 1.0e-6) : 0.0);
+  }
+}
