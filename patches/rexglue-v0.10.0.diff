-    if (is_integer) {
-      if (absolute) {
-        value = uint32_t(std::abs(int32_t(value)));
-      }
-      if (negate) {
-        value = uint32_t(-int32_t(value));
-      }
-    } else {
-      if (absolute) {
-        value &= uint32_t(INT32_MAX);
-      }
-      if (negate) {
-        value ^= uint32_t(INT32_MAX) + 1;
-      }
-    }
-    return value;
-  }
