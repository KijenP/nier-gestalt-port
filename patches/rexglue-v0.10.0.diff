+/**
+ * @file        graphics/vulkan/frame_report.cpp
+ * @brief       NIER_FRAME_REPORT: one whole frame of GPU work, in order, with GPU times.
+ *
+ * Built on the GPU stage timestamps of VulkanCommandProcessor (NIER_GPU_PROF): each timestamp mark
+ * remembers its stage, shader pair (vs/ps hash) and index count. The frame is cut between two
+ * swaps; the rows are written once, as text for reading and CSV for scripts.
+ */
+
+#include <algorithm>
+#include <cstdint>
+#include <cstdlib>
+#include <filesystem>
+#include <fstream>
+#include <map>
+#include <string>
+#include <type_traits>
+#include <vector>
+
+#include <fmt/format.h>
+
+#include <rex/graphics/vulkan/command_processor.h>
+#include <rex/graphics/vulkan/texture_cache.h>
+#include <rex/logging.h>
+
+namespace rex::graphics::vulkan {
+
+namespace {
+
+const char* const kStageNames[] = {
+    "draw",          "transfer",    "resolve-clear", "resolve-dump", "resolve-copy", "resolve-direct",
+    "resolve-other", "texture-load", "texture-load-resolved", "upload", "present", "barrier",
+};
+
+// A pass marker is a tag whose vertex hash is 0x7B | width << 32 | height << 16 and whose pixel
+// hash is the render pass key (see SubmitBarriersAndEnterRenderTargetCacheRenderPass).
+bool IsPassMarker(uint64_t vs) { return (vs >> 56) == 0x7B; }
+
+struct Pair {
+  double ms = 0.0;
+  uint64_t draws = 0, indices = 0;
+};
+
+}  // namespace
+
+void VulkanCommandProcessor::ReportFrameBoundary() {
+  if (!report_enabled_ || report_written_ || report_closed_) {
+    return;
+  }
+  ++report_frame_;
+  {  // TEMP: NIER_REPORT_TRIGGER=<file>: when the file shows up, capture (and
+     // resolve-log) a frame 2 frames later; the file is removed.
+    static const char* trigger = std::getenv("NIER_REPORT_TRIGGER");
+    if (trigger && !report_capturing_ && report_frame_ % 15 == 0 &&
+        std::filesystem::exists(trigger)) {
+      std::error_code ec;
+      std::filesystem::remove(trigger, ec);
+      report_target_ = report_frame_ + 2;
+      NierResolveLogFrameOverride() = GetCurrentFrame() + 2;
+      REXGPU_INFO("FRAMEREPORT: triggered, capturing frame {}", report_target_);
+    }
+  }
+  const uint32_t mark = prof_current_slot_ ? prof_current_slot_->count : 0;
+  if (report_frame_ == report_target_) {
+    report_rows_.clear();
+    report_first_sub_ = GetCurrentSubmission();
+    report_first_mark_ = mark;
+    report_capturing_ = true;
+  } else if (report_capturing_ && report_frame_ == report_target_ + 1) {
+    report_last_sub_ = GetCurrentSubmission();
+    report_last_mark_ = mark;
+    report_capturing_ = false;
+    report_closed_ = true;
+  }
+}
+
+void VulkanCommandProcessor::ReportAddSlot(const ProfSlot& slot,
+                                           const std::vector<uint64_t>& values) {
+  if (slot.submission < report_first_sub_ ||
+      (report_closed_ && slot.submission > report_last_sub_)) {
+    return;
+  }
+  for (uint32_t j = 0; j + 1 < slot.count; ++j) {
+    if (slot.submission == report_first_sub_ && j < report_first_mark_) {
+      continue;
+    }
+    if (report_closed_ && slot.submission == report_last_sub_ && j >= report_last_mark_) {
+      continue;
+    }
+    ReportRow row;
+    row.submission = slot.submission;
+    row.mark = j;
+    row.stage = slot.stages[j];
+    row.count = slot.counts[j];
+    row.vs = row.ps = 0;
+    if (slot.tags[j] < prof_tags_.size()) {
+      row.vs = prof_tags_[slot.tags[j]].vs;
+      row.ps = prof_tags_[slot.tags[j]].ps;
+    }
+    row.ticks = values[j + 1] >= values[j] ? values[j + 1] - values[j] : 0;
+    report_rows_.push_back(row);
+  }
+}
+
+void VulkanCommandProcessor::ReportWrite() {
+  report_written_ = true;
+  std::sort(report_rows_.begin(), report_rows_.end(), [](const ReportRow& a, const ReportRow& b) {
+    return a.submission != b.submission ? a.submission < b.submission : a.mark < b.mark;
+  });
+  const double to_ms = prof_period_ns_ / 1.0e6;
+
+  const char* dir_env = std::getenv("NIER_FRAME_REPORT_DIR");
+  std::filesystem::path dir = dir_env && *dir_env ? dir_env : "logs";
+  std::error_code ec;
+  std::filesystem::create_directories(dir, ec);
+  const std::string base = fmt::format("frame-report-{}", report_target_);
+  std::ofstream txt(dir / (base + ".txt"));
+  std::ofstream csv(dir / (base + ".csv"));
+  if (!txt || !csv) {
+    REXGPU_WARN("FRAMEREPORT: could not write into {}", dir.string());
+    return;
+  }
+
+  // Totals per stage, passes, shader pairs.
+  double stage_ms[size_t(ProfStage::kCount)] = {};
+  double total_ms = 0.0;
+  struct PassInfo {
+    uint32_t width = 0, height = 0;
+    uint64_t key = 0;
+    double ms = 0.0;
+    uint64_t draws = 0, indices = 0;
+    size_t first_row = 0;
+  };
+  std::vector<PassInfo> passes;
+  std::map<std::pair<uint64_t, uint64_t>, Pair> pairs;
+  std::map<uint64_t, Pair> pixel_shaders;
+  uint64_t draws = 0, indices = 0;
+  std::vector<int> row_pass(report_rows_.size(), -1);
+  for (size_t i = 0; i < report_rows_.size(); ++i) {
+    const ReportRow& row = report_rows_[i];
+    const double ms = row.ticks * to_ms;
+    total_ms += ms;
+    if (row.stage < uint8_t(ProfStage::kCount)) {
+      stage_ms[row.stage] += ms;
+    }
+    if (row.stage == uint8_t(ProfStage::kDraw) && IsPassMarker(row.vs)) {
+      PassInfo pass;
+      pass.width = uint32_t(row.vs >> 32) & 0xFFFF;
+      pass.height = uint32_t(row.vs >> 16) & 0xFFFF;
+      pass.key = row.ps;
+      pass.first_row = i;
+      passes.push_back(pass);
+    }
+    if (!passes.empty()) {
+      row_pass[i] = int(passes.size()) - 1;
+      const bool draw_time = row.stage == uint8_t(ProfStage::kDraw) ||
+                             row.stage == uint8_t(ProfStage::kBarrier);
+      if (draw_time) {
+        passes.back().ms += ms;
+      }
+    }
+    if (row.stage == uint8_t(ProfStage::kDraw) && row.count && !IsPassMarker(row.vs)) {
+      ++draws;
+      indices += row.count;
+      if (!passes.empty()) {
+        ++passes.back().draws;
+        passes.back().indices += row.count;
+      }
+      Pair& pair = pairs[{row.vs, row.ps}];
+      pair.ms += ms;
+      ++pair.draws;
+      pair.indices += row.count;
+      Pair& pixel = pixel_shaders[row.ps];
+      pixel.ms += ms;
+      ++pixel.draws;
+      pixel.indices += row.count;
+    }
+  }
+
+  txt << fmt::format(
+      "FRAME REPORT - frame {} (between swap {} and swap {}); GPU timestamps, {} events\n"
+      "GPU time of the frame: {:.2f} ms | draws: {} | indices: {} | passes: {} | submissions {}..{}\n"
+      "(The first and last submission are cut at the swap; durations are timestamp to timestamp, on "
+      "tile-based GPUs per-draw times are not meaningful, use the pass times.)\n\n",
+      report_target_, report_target_, report_target_ + 1, report_rows_.size(), total_ms, draws,
+      indices, passes.size(), report_first_sub_, report_last_sub_);
+
+  txt << "== Time per kind of work\n";
+  for (size_t i = 0; i < size_t(ProfStage::kCount); ++i) {
+    if (stage_ms[i] > 0.0) {
+      txt << fmt::format("  {:<22} {:7.3f} ms  {:5.1f}%\n", kStageNames[i], stage_ms[i],
+                         total_ms > 0.0 ? stage_ms[i] * 100.0 / total_ms : 0.0);
+    }
+  }
+
+  txt << "\n== Render passes (time = draws + barriers inside the pass)\n";
+  txt << "   #   target size   painted area      draws  indices    ms     pass key\n";
+  const bool have_areas = report_pass_areas_.size() == passes.size();
+  for (size_t i = 0; i < passes.size(); ++i) {
+    const PassInfo& pass = passes[i];
+    std::string area = "?";
+    if (have_areas && report_pass_areas_[i][2] > report_pass_areas_[i][0]) {
+      const auto& a = report_pass_areas_[i];
+      area = fmt::format("{}x{}", a[2] - a[0], a[3] - a[1]);
+    }
+    txt << fmt::format("  {:3} {:5}x{:<5} {:>12} {:7} {:9} {:7.3f}   {:016X}\n", i, pass.width,
+                       pass.height, area, pass.draws, pass.indices, pass.ms, pass.key);
+  }
+  report_pass_areas_.clear();
+
+  auto top = [&](const char* title, auto& map, auto format_key, size_t limit) {
+    std::vector<std::pair<typename std::decay_t<decltype(map)>::key_type, Pair>> sorted(
+        map.begin(), map.end());
+    std::sort(sorted.begin(), sorted.end(),
+              [](const auto& a, const auto& b) { return a.second.ms > b.second.ms; });
+    txt << "\n== " << title << "\n";
+    for (size_t i = 0; i < sorted.size() && i < limit; ++i) {
+      txt << fmt::format("  {}  {:7.3f} ms  draws {:4}  indices {:8}\n", format_key(sorted[i].first),
+                         sorted[i].second.ms, sorted[i].second.draws, sorted[i].second.indices);
+    }
+  };
+  top("Pixel shaders by GPU time (hash = ucode hash of the guest shader)", pixel_shaders,
+      [](uint64_t ps) { return fmt::format("ps={:016X}              ", ps); }, 25);
+  top("Shader pairs by GPU time", pairs,
+      [](const std::pair<uint64_t, uint64_t>& key) {
+        return fmt::format("vs={:016X} ps={:016X}", key.first, key.second);
+      },
+      25);
+
+  txt << "\n== Events in order (ms = time until the next event)\n";
+  double clock = 0.0;
+  for (size_t i = 0; i < report_rows_.size(); ++i) {
+    const ReportRow& row = report_rows_[i];
+    const double ms = row.ticks * to_ms;
+    const char* stage = row.stage < uint8_t(ProfStage::kCount) ? kStageNames[row.stage] : "?";
+    if (row.stage == uint8_t(ProfStage::kDraw) && IsPassMarker(row.vs)) {
+      txt << fmt::format("\n[{:8.3f}] PASS {} {}x{} key={:016X}\n", clock,
+                         row_pass[i], uint32_t(row.vs >> 32) & 0xFFFF,
+                         uint32_t(row.vs >> 16) & 0xFFFF, row.ps);
+    } else if (row.stage == uint8_t(ProfStage::kDraw) && row.count) {
+      txt << fmt::format("[{:8.3f}]   draw  {:6.3f} ms  vs={:016X} ps={:016X} indices={}\n", clock,
+                         ms, row.vs, row.ps, row.count);
+    } else if (ms >= 0.005) {
+      txt << fmt::format("[{:8.3f}]   {:<14} {:6.3f} ms\n", clock, stage, ms);
+    }
+    csv << fmt::format("{},{},{},{},{:.5f},{},{:016X},{:016X},{}\n", i, row.submission, row.mark,
+                       stage, ms, row.count, row.vs, row.ps, row_pass[i]);
+    clock += ms;
+  }
+
+  REXGPU_INFO("FRAMEREPORT: frame {} written: {} ({:.2f} ms GPU, {} draws, {} passes)",
+              report_target_, (dir / (base + ".txt")).string(), total_ms, draws, passes.size());
+  report_rows_.clear();
+  report_rows_.shrink_to_fit();
+}
+
+}  // namespace rex::graphics::vulkan
