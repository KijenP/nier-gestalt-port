+VkFormat VulkanTextureCache::GetDirectLoadFormat(const TextureKey& key) const {
+  // Without scaling (vulkan_resolve_to_texture_1x), only as a resolve
+  // forwarding target, any tiled 2D texture may be one.
+  bool unscaled_forwarding = !IsDrawResolutionScaled() && REXCVAR_GET(vulkan_resolve_to_texture_1x);
+  if (!(key.scaled_resolve || unscaled_forwarding) || !key.tiled ||
+      key.dimension != xenos::DataDimension::k2DOrStacked ||
+      key.GetDepthOrArraySize() != 1 || key.signed_separate) {
+    return VK_FORMAT_UNDEFINED;
+  }
+  const HostFormatPair& host_format_pair = GetHostFormatPair(key);
+  if (key.format == xenos::TextureFormat::k_8_8_8_8 &&
+      host_format_pair.format_unsigned.format == VK_FORMAT_R8G8B8A8_UNORM &&
+      host_format_pair.format_unsigned.load_shader == kLoadShaderIndex32bpb &&
+      (host_format_pair.format_signed.format == VK_FORMAT_UNDEFINED ||
+       host_format_pair.format_signed.format == VK_FORMAT_R8G8B8A8_UNORM ||
+       host_format_pair.format_signed.format == VK_FORMAT_R8G8B8A8_SNORM)) {
+    return VK_FORMAT_R8G8B8A8_UNORM;
+  }
+  if (key.format == xenos::TextureFormat::k_24_8 &&
+      host_format_pair.format_unsigned.format == VK_FORMAT_R32_SFLOAT &&
+      host_format_pair.format_unsigned.load_shader == kLoadShaderIndexDepthUnorm &&
+      (host_format_pair.format_signed.format == VK_FORMAT_UNDEFINED ||
+       host_format_pair.format_signed.format == VK_FORMAT_R32_SFLOAT)) {
+    return VK_FORMAT_R32_SFLOAT;
+  }
+  return VK_FORMAT_UNDEFINED;
