+VulkanRenderTargetCache::VulkanRenderTarget* VulkanRenderTargetCache::GetFusedResolveSource(
+    const draw_util::ResolveInfo& resolve_info, uint32_t& origin_x_out, uint32_t& origin_y_out) {
+  // Color: 8888. Depth: D24S8 (24-bit unorm depth, stored as float32 on the
+  // host), without the red / blue swap.
+  bool is_depth = resolve_info.IsCopyingDepth();
+  const draw_util::ResolveEdramInfo& edram_info =
+      is_depth ? resolve_info.depth_edram_info : resolve_info.color_edram_info;
+  if (edram_info.msaa_samples != xenos::MsaaSamples::k1X || edram_info.format_is_64bpp) {
+    return nullptr;
+  }
+  if (is_depth ? xenos::DepthRenderTargetFormat(edram_info.format) !=
+                     xenos::DepthRenderTargetFormat::kD24S8
+               : xenos::ColorRenderTargetFormat(edram_info.format) !=
+                     xenos::ColorRenderTargetFormat::k_8_8_8_8) {
+    return nullptr;
+  }
+  reg::RB_COPY_DEST_INFO dest_info = resolve_info.copy_dest_info;
+  if (dest_info.copy_dest_exp_bias != 0 || dest_info.copy_dest_array ||
+      uint32_t(dest_info.copy_dest_endian) > uint32_t(xenos::Endian128::k16in32) ||
+      (is_depth && dest_info.copy_dest_swap)) {
+    return nullptr;
+  }
+  if (resolve_info.copy_dest_coordinate_info.copy_sample_select != xenos::CopySampleSelect::k0) {
+    return nullptr;
+  }
+
+  // One render target must own the whole area.
+  uint32_t dump_base, dump_row_length_used, dump_rows, dump_pitch;
+  resolve_info.GetCopyEdramTileSpan(dump_base, dump_row_length_used, dump_rows, dump_pitch);
+  GetResolveCopyRectanglesToDump(dump_base, dump_row_length_used, dump_rows, dump_pitch,
+                                 fused_resolve_rectangles_);
+  if (fused_resolve_rectangles_.size() != 1) {
+    return nullptr;
+  }
+  const ResolveCopyDumpRectangle& rectangle = fused_resolve_rectangles_.front();
+  if (rectangle.row_first != 0 || rectangle.rows != dump_rows || rectangle.row_first_start != 0 ||
+      rectangle.row_last_end != dump_row_length_used) {
+    return nullptr;
+  }
+  auto* render_target = static_cast<VulkanRenderTarget*>(rectangle.render_target);
+  RenderTargetKey rt_key = render_target->key();
+  if (bool(rt_key.is_depth) != is_depth || rt_key.msaa_samples != xenos::MsaaSamples::k1X ||
+      (is_depth ? rt_key.GetDepthFormat() != xenos::DepthRenderTargetFormat::kD24S8 ||
+                      (GetDepthVulkanFormat(rt_key.GetDepthFormat()) !=
+                           VK_FORMAT_D32_SFLOAT_S8_UINT &&
+                       GetDepthVulkanFormat(rt_key.GetDepthFormat()) !=
+                           VK_FORMAT_D24_UNORM_S8_UINT)
+                : rt_key.GetColorFormat() != xenos::ColorRenderTargetFormat::k_8_8_8_8) ||
+      !rt_key.GetPitchTiles() || rt_key.GetPitchTiles() != edram_info.pitch_tiles) {
+    return nullptr;
+  }
+
+  // Origin of the resolve area in the render target image.
+  int32_t tile_offset = int32_t(edram_info.base_tiles) - int32_t(rt_key.base_tiles);
+  if (tile_offset < 0) {
+    tile_offset += int32_t(xenos::kEdramTileCount);
+  }
+  uint32_t pitch_tiles = rt_key.GetPitchTiles();
+  uint32_t scale_x = draw_resolution_scale_x(), scale_y = draw_resolution_scale_y();
+  uint32_t origin_x = ((uint32_t(tile_offset) % pitch_tiles) * xenos::kEdramTileWidthSamples +
+                       (resolve_info.coordinate_info.edram_offset_x_div_8 << 3)) *
+                      scale_x;
+  uint32_t origin_y = ((uint32_t(tile_offset) / pitch_tiles) * xenos::kEdramTileHeightSamples +
+                       (resolve_info.coordinate_info.edram_offset_y_div_8 << 3)) *
+                      scale_y;
+  uint32_t image_width = pitch_tiles * xenos::kEdramTileWidthSamples * scale_x;
+  uint32_t image_height =
+      GetRenderTargetHeight(rt_key.pitch_tiles_at_32bpp, rt_key.msaa_samples) * scale_y;
+  if (origin_x + (resolve_info.coordinate_info.width_div_8 << 3) * scale_x > image_width ||
+      origin_y + (resolve_info.height_div_8 << 3) * scale_y > image_height) {
+    return nullptr;
+  }
+  origin_x_out = origin_x;
+  origin_y_out = origin_y;
+  return render_target;
+}
