-              case xenos::SignedRepeatingFractionMode::kNoZero:
-                a_.OpMAd(result_unpacked_dest, result_src, dxbc::Src::LF(1.0f / 2147483647.5f),
-                         dxbc::Src::LF(0.5f / 2147483647.5f));
