diff --git a/CMakeLists.txt b/CMakeLists.txt
index 9b3cdf5..35b4150 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -12,6 +12,12 @@ project(ReXGlue
     LANGUAGES ${REXGLUE_LANGUAGES}
     DESCRIPTION "Xbox 360 Recompilation SDK"
 )
+
+# Newer CMake selects the MSVC runtime for clang++ with explicit dependent libs,
+# dropping oldnames.lib (POSIX names such as isatty / fileno -> __imp_ aliases).
+if(WIN32 AND CMAKE_CXX_COMPILER_ID MATCHES "Clang")
+    link_libraries(oldnames)
+endif()
 # Floor only: bump MAJOR.MINOR for API changes. Patch is derived from git tags
 # in cmake/rex_version.cmake. See docs/RELEASING.md.
 
@@ -31,25 +37,11 @@ if(REXGLUE_ENABLE_PERF_COUNTERS)
     add_compile_definitions($<$<NOT:$<CONFIG:Release>>:REXGLUE_ENABLE_PERF_COUNTERS>)
 endif()
 
-# Graphics backend selection
-# D3D12: Windows only, ON by default.
-# Vulkan: Cross-platform, ON by default on Linux, OFF by default on Windows.
-if(WIN32)
-    option(REXGLUE_USE_D3D12  "Enable D3D12 graphics backend" ON)
-    option(REXGLUE_USE_VULKAN "Enable Vulkan graphics backend" OFF)
-else()
-    set(REXGLUE_USE_D3D12 OFF)
-    option(REXGLUE_USE_VULKAN "Enable Vulkan graphics backend" ON)
-endif()
-
-if(NOT REXGLUE_USE_D3D12 AND NOT REXGLUE_USE_VULKAN)
-    message(FATAL_ERROR "At least one graphics backend must be enabled (REXGLUE_USE_D3D12 or REXGLUE_USE_VULKAN)")
-endif()
+# Graphics backend: Vulkan only (PC and Android). The D3D12 backend was removed.
+option(REXGLUE_USE_VULKAN "Enable Vulkan graphics backend" ON)
 
-if (REXGLUE_ENABLE_FIDELITYFX AND
-    NOT (REXGLUE_USE_VULKAN OR REXGLUE_USE_D3D12))
-    message(FATAL_ERROR
-        "REXGLUE_ENABLE_FIDELITYFX requires at least one graphics backend")
+if(NOT REXGLUE_USE_VULKAN)
+    message(FATAL_ERROR "The Vulkan graphics backend is required (REXGLUE_USE_VULKAN=ON)")
 endif()
 
 # Root of the SDK source tree
@@ -223,9 +215,12 @@ configure_file(
 )
 
 # Output directories (multi-config appends /<Config>/ automatically)
-set(CMAKE_RUNTIME_OUTPUT_DIRECTORY "${REXGLUE_ROOT}/out/${REX_PLATFORM}")
-set(CMAKE_LIBRARY_OUTPUT_DIRECTORY "${REXGLUE_ROOT}/out/${REX_PLATFORM}")
-set(CMAKE_ARCHIVE_OUTPUT_DIRECTORY "${REXGLUE_ROOT}/out/${REX_PLATFORM}")
+# (REXGLUE_OUTPUT_DIR: another place, so a second build tree such as a coverage
+# build does not overwrite the first one's binaries.)
+set(REXGLUE_OUTPUT_DIR "${REXGLUE_ROOT}/out/${REX_PLATFORM}" CACHE PATH "Binary output directory")
+set(CMAKE_RUNTIME_OUTPUT_DIRECTORY "${REXGLUE_OUTPUT_DIR}")
+set(CMAKE_LIBRARY_OUTPUT_DIRECTORY "${REXGLUE_OUTPUT_DIR}")
+set(CMAKE_ARCHIVE_OUTPUT_DIRECTORY "${REXGLUE_OUTPUT_DIR}")
 
 # Sanitizer support for debugging memory corruption and undefined behavior
 if(REXGLUE_ENABLE_SANITIZERS)
@@ -279,7 +274,7 @@ message(STATUS "  Compiler: ${CMAKE_CXX_COMPILER_ID} ${CMAKE_CXX_COMPILER_VERSIO
 message(STATUS "  Configurations: ${CMAKE_CONFIGURATION_TYPES}")
 message(STATUS "  Output Dir: ${CMAKE_RUNTIME_OUTPUT_DIRECTORY}")
 message(STATUS "  C++ Standard: C++${CMAKE_CXX_STANDARD}")
-message(STATUS "  Graphics: D3D12=${REXGLUE_USE_D3D12} Vulkan=${REXGLUE_USE_VULKAN}")
+message(STATUS "  Graphics: Vulkan=${REXGLUE_USE_VULKAN}")
 message(STATUS "  FidelityFX: ${REXGLUE_ENABLE_FIDELITYFX}")
 message(STATUS "  Tracy: ${REXGLUE_ENABLE_TRACY}")
 message(STATUS "  Perf Counters: ${REXGLUE_ENABLE_PERF_COUNTERS}")
diff --git a/cmake/rexglue_helpers.cmake b/cmake/rexglue_helpers.cmake
index 41e6dce..995420e 100644
--- a/cmake/rexglue_helpers.cmake
+++ b/cmake/rexglue_helpers.cmake
@@ -45,6 +45,10 @@ endfunction()
 # runtime DLL staging is the host's job (see rexglue_configure_target).
 #==========================================================
 function(rexglue_apply_target_settings target_name)
+    if(WIN32 AND CMAKE_CXX_COMPILER_ID MATCHES "Clang")
+        # See the SDK's CMakeLists.txt (oldnames.lib with newer CMake).
+        target_link_libraries(${target_name} PRIVATE oldnames)
+    endif()
     if(UNIX AND NOT APPLE)
         # Large executable support
         if(CMAKE_SYSTEM_PROCESSOR MATCHES "x86_64|AMD64")
diff --git a/cmake/rexglue_install.cmake b/cmake/rexglue_install.cmake
index d9a64eb..e3a5eeb 100644
--- a/cmake/rexglue_install.cmake
+++ b/cmake/rexglue_install.cmake
@@ -27,10 +27,6 @@ if(REXGLUE_USE_VULKAN)
     )
 endif()
 
-if(REXGLUE_USE_D3D12)
-    list(APPEND REXGLUE_INSTALL_TARGETS dxc-headers)
-endif()
-
 if(REXGLUE_ENABLE_TRACY)
     list(APPEND REXGLUE_INSTALL_TARGETS TracyClient)
 endif()
@@ -128,15 +124,6 @@ install(FILES
     DESTINATION ${CMAKE_INSTALL_DATADIR}/rexglue
 )
 
-# Install DXC API headers (vendored, for D3D12 backend)
-if(REXGLUE_USE_D3D12)
-    install(FILES
-        thirdparty/dxc/include/DxbcConverter.h
-        thirdparty/dxc/include/dxcapi.h
-        DESTINATION ${CMAKE_INSTALL_INCLUDEDIR}/dxc
-    )
-endif()
-
 if(APPLE AND REXGLUE_USE_VULKAN)
     install(FILES "$<TARGET_FILE:Vulkan::Loader>"
         DESTINATION ${CMAKE_INSTALL_LIBDIR}
