-      pixel_shader ? static_cast<D3D12Shader::D3D12Translation*>(
-                         pixel_shader->GetOrCreateTranslation(pixel_shader_modification.value))
-                   : nullptr;
-  uint32_t bound_depth_and_color_render_target_bits;
