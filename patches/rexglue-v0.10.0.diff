+void SharedMemory::EnableGpuReadTracking() {
+  gpu_read_pages_.assign(((kBufferSize >> page_size_log2_) + 63) >> 6, 0);
+  gpu_read_blocks_.clear();
+}
+
+void SharedMemory::MarkRangeReadByGpu(uint32_t start, uint32_t length) {
+  if (gpu_read_pages_.empty() || !length || start >= kBufferSize) {
+    return;
+  }
+  length = std::min(length, kBufferSize - start);
+  uint32_t page_first = start >> page_size_log2_;
+  uint32_t page_last = (start + length - 1) >> page_size_log2_;
+  for (uint32_t block = page_first >> 6; block <= (page_last >> 6); ++block) {
+    uint64_t bits = UINT64_MAX;
+    if (block == (page_first >> 6)) {
+      bits &= ~((uint64_t(1) << (page_first & 63)) - 1);
+    }
+    if (block == (page_last >> 6) && (page_last & 63) != 63) {
+      bits &= (uint64_t(1) << ((page_last & 63) + 1)) - 1;
+    }
+    if (!gpu_read_pages_[block]) {
+      gpu_read_blocks_.push_back(block);
+    }
+    gpu_read_pages_[block] |= bits;
+  }
+}
+
+bool SharedMemory::WasRangeReadByGpu(uint32_t start, uint32_t length) const {
+  if (gpu_read_pages_.empty()) {
     return true;
   }
+  if (!length || start >= kBufferSize) {
+    return false;
+  }
+  length = std::min(length, kBufferSize - start);
+  uint32_t page_first = start >> page_size_log2_;
+  uint32_t page_last = (start + length - 1) >> page_size_log2_;
+  for (uint32_t block = page_first >> 6; block <= (page_last >> 6); ++block) {
+    uint64_t bits = UINT64_MAX;
+    if (block == (page_first >> 6)) {
+      bits &= ~((uint64_t(1) << (page_first & 63)) - 1);
+    }
+    if (block == (page_last >> 6) && (page_last & 63) != 63) {
+      bits &= (uint64_t(1) << ((page_last & 63) + 1)) - 1;
+    }
+    if (gpu_read_pages_[block] & bits) {
+      return true;
+    }
+  }
+  return false;
+}
 
-  return UploadRanges(upload_ranges_);
+void SharedMemory::ResetGpuReads() {
+  for (uint32_t block : gpu_read_blocks_) {
+    gpu_read_pages_[block] = 0;
+  }
+  gpu_read_blocks_.clear();
