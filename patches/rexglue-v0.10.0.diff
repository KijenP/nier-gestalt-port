+
+// Called by SDLActivity from libmain.so. No command line there: the log,
+// user data, cache and the app's config (REX_ANDROID_CONFIG) go to the app's
+// external files directory (Android/data/<package>/files), where the game
+// files are copied too.
+extern "C" SDLMAIN_DECLSPEC int SDL_main(int argc, char* argv[]) {
+  const char* files = SDL_GetAndroidExternalStoragePath();
+  std::string base = files ? files : ".";
+  // A NierPort folder in shared storage, if the app has "All files access",
+  // is easier to reach for the user (Android/data is hidden from many file
+  // managers) and holds files copied by other apps / over USB readably.
+  // NieR (2026-11-14): the shared storage's root as the system gives it (EXTERNAL_STORAGE, the folder the launcher's
+  // SetupActivity writes nier.toml into: Environment.getExternalStorageDirectory()), then the usual path. Only the
+  // fixed /storage/emulated/0 before: on a phone where it differs (another user, a second space) the game used the
+  // app's own folder instead, without the ISO the launcher saved, and its log went there too (a black screen).
+  std::vector<std::string> shared;
+  if (const char* ext = std::getenv("EXTERNAL_STORAGE"); ext && *ext) {
+    shared.push_back(std::string(ext) + "/NierPort");
+  }
+  shared.push_back("/storage/emulated/0/NierPort");
+  shared.push_back("/sdcard/NierPort");
+  for (const std::string& folder : shared) {
+    if (access(folder.c_str(), R_OK | W_OK | X_OK) == 0) {
+      base = folder;
+      break;
+    }
+  }
+  __android_log_print(ANDROID_LOG_INFO, "NieR", "files folder: %s", base.c_str());
+  std::vector<std::string> args;
+  for (int i = 0; i < argc; ++i) {
+    args.emplace_back(argv[i]);
+  }
+  if (args.empty()) {
+    args.emplace_back("rexglue");
+  }
+  args.push_back("--log_file=" + base + "/log.txt");
+  args.push_back("--user_data_root=" + base + "/userdata");
+  args.push_back("--cache_root=" + base + "/cache");
+  setenv("REX_ANDROID_FILES", base.c_str(), 1);
+  // Debugging: an app has no environment of its own; env.txt there sets
+  // variables (one NAME=value per line).
+  if (FILE* env_file = std::fopen((base + "/env.txt").c_str(), "r")) {
+    char line[512];
+    while (std::fgets(line, sizeof(line), env_file)) {
+      std::string entry(line);
+      while (!entry.empty() && (entry.back() == '\n' || entry.back() == '\r')) {
+        entry.pop_back();
+      }
+      size_t equals = entry.find('=');
+      if (equals != std::string::npos && equals) {
+        setenv(entry.substr(0, equals).c_str(), entry.substr(equals + 1).c_str(), 1);
+      }
+    }
+    std::fclose(env_file);
+  }
+  std::vector<char*> argv_ptrs;
+  for (auto& s : args) {
+    argv_ptrs.push_back(s.data());
+  }
+  return RunWindowedApp(int(argv_ptrs.size()), argv_ptrs.data());
+}
