-    } else {
-      shared_memory_->UseForReading();
-    }
-    SubmitBarriers();
-    PROFILE_DRAW_CALL();
-    PROFILE_VERTICES(primitive_processing_result.host_draw_vertex_count);
-    deferred_command_list_.D3DDrawInstanced(primitive_processing_result.host_draw_vertex_count, 1,
