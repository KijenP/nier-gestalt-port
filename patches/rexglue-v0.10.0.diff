-  if (used_missing_components) {
-    a_.OpMov(dxbc::Dest::R(system_temp_result_, used_missing_components), dxbc::Src::LF(0.0f));
-  }
-
-  StoreResult(instr.result, dxbc::Src::R(system_temp_result_));
-}
