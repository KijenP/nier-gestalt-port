-  // - Apply the exponent bias.
-
-  if (instr.attributes.exp_adjust) {
-    a_.OpMul(result_unpacked_dest, result_src,
-             dxbc::Src::LF(std::ldexp(1.0f, instr.attributes.exp_adjust)));
