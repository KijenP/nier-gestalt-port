+void SpirvShaderTranslator::AnalyzeRelaxedPrecisionAlu() {
+  const Shader& shader = current_shader();
+  const uint32_t* ucode_dwords = shader.ucode_data().data();
+
+  // Gather the fetch and ALU instructions in the translation order. Fetch
+  // operands (texture coordinates, LOD, gradients, vertex indices) are the
+  // seeds of the precise register components.
+  struct Step {
+    // UINT32_MAX for fetches.
+    uint32_t alu_index;
+    // Whether the step may be skipped (conditional exec or predicated), so it
+    // doesn't overwrite earlier values for sure.
+    bool is_conditional;
+    InstructionOperand fetch_operands[2];
+    uint32_t fetch_operand_count;
+  };
+  std::vector<Step> steps;
+  std::vector<ParsedAluInstruction> alu_instructions;
+  // Without jumps, calls and loops, the control flow order is the execution
+  // order, and register lifetimes can be tracked. Otherwise, any write to a
+  // register component that is precise anywhere is precise.
+  bool is_straight_line = true;
+  ucode::VertexFetchInstruction previous_vfetch_full = {};
+  for (uint32_t i = 0; i < shader.cf_pair_index_bound(); ++i) {
+    ucode::ControlFlowInstruction cf_ab[2];
+    ucode::UnpackControlFlowInstructions(ucode_dwords + i * 3, cf_ab);
+    for (uint32_t j = 0; j < 2; ++j) {
+      const ucode::ControlFlowInstruction& cf = cf_ab[j];
+      ParsedExecInstruction exec;
+      switch (cf.opcode()) {
+        case ucode::ControlFlowOpcode::kExec:
+        case ucode::ControlFlowOpcode::kExecEnd:
+          ParseControlFlowExec(cf.exec, i * 2 + j, exec);
+          break;
+        case ucode::ControlFlowOpcode::kCondExec:
+        case ucode::ControlFlowOpcode::kCondExecEnd:
+        case ucode::ControlFlowOpcode::kCondExecPredClean:
+        case ucode::ControlFlowOpcode::kCondExecPredCleanEnd:
+          ParseControlFlowCondExec(cf.cond_exec, i * 2 + j, exec);
+          break;
+        case ucode::ControlFlowOpcode::kCondExecPred:
+        case ucode::ControlFlowOpcode::kCondExecPredEnd:
+          ParseControlFlowCondExecPred(cf.cond_exec_pred, i * 2 + j, exec);
+          break;
+        case ucode::ControlFlowOpcode::kNop:
+        case ucode::ControlFlowOpcode::kAlloc:
+        case ucode::ControlFlowOpcode::kMarkVsFetchDone:
+          continue;
+        default:
+          is_straight_line = false;
+          continue;
+      }
+      bool is_exec_conditional = exec.type != ParsedExecInstruction::Type::kUnconditional;
+      uint32_t sequence = exec.sequence;
+      for (uint32_t instr_offset = exec.instruction_address;
+           instr_offset < exec.instruction_address + exec.instruction_count;
+           ++instr_offset, sequence >>= 2) {
+        const uint32_t* op_ptr = ucode_dwords + instr_offset * 3;
+        Step& step = steps.emplace_back();
+        step.alu_index = UINT32_MAX;
+        step.fetch_operand_count = 0;
+        if (sequence & 0b01) {
+          auto& op = *reinterpret_cast<const ucode::FetchInstruction*>(op_ptr);
+          if (op.opcode() == ucode::FetchOpcode::kVertexFetch) {
+            ParsedVertexFetchInstruction vfetch_instr;
+            if (ParseVertexFetchInstruction(op.vertex_fetch(), previous_vfetch_full,
+                                            vfetch_instr)) {
+              previous_vfetch_full = op.vertex_fetch();
+            }
+            step.is_conditional = is_exec_conditional || vfetch_instr.is_predicated;
+            step.fetch_operand_count = uint32_t(std::min(vfetch_instr.operand_count, size_t(2)));
+            std::copy_n(vfetch_instr.operands, step.fetch_operand_count, step.fetch_operands);
+          } else {
+            ParsedTextureFetchInstruction tfetch_instr;
+            ParseTextureFetchInstruction(op.texture_fetch(), tfetch_instr);
+            step.is_conditional = is_exec_conditional || tfetch_instr.is_predicated;
+            step.fetch_operand_count = uint32_t(std::min(tfetch_instr.operand_count, size_t(2)));
+            std::copy_n(tfetch_instr.operands, step.fetch_operand_count, step.fetch_operands);
+          }
+        } else {
+          step.alu_index = uint32_t(alu_instructions.size());
+          ParsedAluInstruction& alu_instr = alu_instructions.emplace_back();
+          ParseAluInstruction(*reinterpret_cast<const ucode::AluInstruction*>(op_ptr),
+                              shader.type(), alu_instr);
+          step.is_conditional = is_exec_conditional || alu_instr.is_predicated;
+        }
