+VkDescriptorSet VulkanTextureCache::VulkanTexture::GetDirectLoadDescriptorSet() {
+  if (direct_load_descriptor_set_ != VK_NULL_HANDLE) {
+    return direct_load_descriptor_set_;
+  }
+  const VulkanTextureCache& vulkan_texture_cache =
+      static_cast<const VulkanTextureCache&>(texture_cache());
+  const ui::vulkan::VulkanDevice* const vulkan_device =
+      vulkan_texture_cache.command_processor_.GetVulkanDevice();
+  const ui::vulkan::VulkanDevice::Functions& dfn = vulkan_device->functions();
+  const VkDevice device = vulkan_device->device();
+  if (direct_load_view_ == VK_NULL_HANDLE) {
+    VkImageViewCreateInfo view_create_info = {};
+    view_create_info.sType = VK_STRUCTURE_TYPE_IMAGE_VIEW_CREATE_INFO;
+    view_create_info.image = image_;
+    view_create_info.viewType = VK_IMAGE_VIEW_TYPE_2D;
+    view_create_info.format = vulkan_texture_cache.GetDirectLoadFormat(key());
+    view_create_info.subresourceRange = ui::vulkan::util::InitializeSubresourceRange(
+        VK_IMAGE_ASPECT_COLOR_BIT, 0, 1, 0, 1);
+    if (dfn.vkCreateImageView(device, &view_create_info, nullptr, &direct_load_view_) !=
+        VK_SUCCESS) {
+      direct_load_view_ = VK_NULL_HANDLE;
+      return VK_NULL_HANDLE;
+    }
+  }
+  VkDescriptorSetAllocateInfo allocate_info = {};
+  allocate_info.sType = VK_STRUCTURE_TYPE_DESCRIPTOR_SET_ALLOCATE_INFO;
+  allocate_info.descriptorPool = vulkan_texture_cache.direct_load_descriptor_pool_;
+  allocate_info.descriptorSetCount = 1;
+  allocate_info.pSetLayouts = &vulkan_texture_cache.direct_load_set_layout_;
+  if (dfn.vkAllocateDescriptorSets(device, &allocate_info, &direct_load_descriptor_set_) !=
+      VK_SUCCESS) {
+    direct_load_descriptor_set_ = VK_NULL_HANDLE;
+    return VK_NULL_HANDLE;
+  }
+  VkDescriptorImageInfo image_info;
+  image_info.sampler = VK_NULL_HANDLE;
+  image_info.imageView = direct_load_view_;
+  image_info.imageLayout = VK_IMAGE_LAYOUT_GENERAL;
+  VkWriteDescriptorSet write = {};
+  write.sType = VK_STRUCTURE_TYPE_WRITE_DESCRIPTOR_SET;
+  write.dstSet = direct_load_descriptor_set_;
+  write.descriptorCount = 1;
+  write.descriptorType = VK_DESCRIPTOR_TYPE_STORAGE_IMAGE;
+  write.pImageInfo = &image_info;
+  dfn.vkUpdateDescriptorSets(device, 1, &write, 0, nullptr);
+  auto& mutable_cache = const_cast<VulkanTextureCache&>(vulkan_texture_cache);
+  mutable_cache.direct_load_textures_.emplace(key().base_page, this);
+  direct_load_id_ = ++mutable_cache.direct_load_id_counter_;
+  return direct_load_descriptor_set_;
+}
