-    // not DXGI_FORMAT_UNKNOWN.
-    null_rtv_desc.Format = DXGI_FORMAT_R8G8B8A8_UNORM;
-    null_rtv_desc.ViewDimension = D3D12_RTV_DIMENSION_TEXTURE2D;
-    null_rtv_desc.Texture2D.MipSlice = 0;
-    null_rtv_desc.Texture2D.PlaneSlice = 0;
