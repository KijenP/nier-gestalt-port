+bool VulkanRenderTargetCache::EnsureFusedResolvePipeline() {
+  if (fused_resolve_pipeline_ != VK_NULL_HANDLE) {
+    return true;
+  }
+  if (fused_resolve_pipeline_failed_) {
+    return false;
+  }
+  fused_resolve_pipeline_failed_ = true;
+  const ui::vulkan::VulkanDevice* const vulkan_device = command_processor_.GetVulkanDevice();
+  const ui::vulkan::VulkanDevice::Functions& dfn = vulkan_device->functions();
+  const VkDevice device = vulkan_device->device();
+
+  VkDescriptorSetLayout storage_buffer_layout =
+      command_processor_.GetSingleTransientDescriptorLayout(
+          VulkanCommandProcessor::SingleTransientDescriptorLayout::kStorageBufferCompute);
+  // The forwarding destination, identically defined to the direct resolved
+  // texture load's set layout, which the texture's descriptor set is from.
+  VkDescriptorSetLayoutBinding forward_binding = {};
+  forward_binding.binding = 0;
+  forward_binding.descriptorType = VK_DESCRIPTOR_TYPE_STORAGE_IMAGE;
+  forward_binding.descriptorCount = 1;
+  forward_binding.stageFlags = VK_SHADER_STAGE_COMPUTE_BIT;
+  VkDescriptorSetLayoutCreateInfo forward_set_layout_create_info = {};
+  forward_set_layout_create_info.sType = VK_STRUCTURE_TYPE_DESCRIPTOR_SET_LAYOUT_CREATE_INFO;
+  forward_set_layout_create_info.bindingCount = 1;
+  forward_set_layout_create_info.pBindings = &forward_binding;
+  if (dfn.vkCreateDescriptorSetLayout(device, &forward_set_layout_create_info, nullptr,
+                                      &fused_forward_set_layout_) != VK_SUCCESS) {
+    REXGPU_ERROR("VulkanRenderTargetCache: Failed to create the fused resolve set layout");
+    return false;
+  }
+  VkDescriptorSetLayout set_layouts[4] = {storage_buffer_layout,
+                                          descriptor_set_layout_sampled_image_,
+                                          storage_buffer_layout, fused_forward_set_layout_};
+  VkPushConstantRange push_constant_range;
+  push_constant_range.stageFlags = VK_SHADER_STAGE_COMPUTE_BIT;
+  push_constant_range.offset = 0;
+  push_constant_range.size = sizeof(uint32_t) * 10;
+  VkPipelineLayoutCreateInfo pipeline_layout_create_info = {};
+  pipeline_layout_create_info.sType = VK_STRUCTURE_TYPE_PIPELINE_LAYOUT_CREATE_INFO;
+  pipeline_layout_create_info.setLayoutCount = 3;
+  pipeline_layout_create_info.pSetLayouts = set_layouts;
+  pipeline_layout_create_info.pushConstantRangeCount = 1;
+  pipeline_layout_create_info.pPushConstantRanges = &push_constant_range;
+  for (uint32_t forward = 0; forward < 2; ++forward) {
+    pipeline_layout_create_info.setLayoutCount = forward ? 4 : 3;
+    set_layouts[1] = descriptor_set_layout_sampled_image_;
+    if (dfn.vkCreatePipelineLayout(
+            device, &pipeline_layout_create_info, nullptr,
+            forward ? &fused_forward_pipeline_layouts_[0] : &fused_resolve_pipeline_layout_) !=
+        VK_SUCCESS) {
+      REXGPU_ERROR("VulkanRenderTargetCache: Failed to create the fused resolve pipeline layout");
+      return false;
+    }
+    set_layouts[1] = descriptor_set_layout_sampled_image_x2_;
+    if (dfn.vkCreatePipelineLayout(device, &pipeline_layout_create_info, nullptr,
+                                   forward ? &fused_forward_pipeline_layouts_[1]
+                                           : &fused_resolve_pipeline_layout_depth_) !=
+        VK_SUCCESS) {
+      REXGPU_ERROR("VulkanRenderTargetCache: Failed to create the fused resolve pipeline layout");
+      return false;
+    }
+  }
+
+  // One invocation per host pixel. Packing like the 8888 EDRAM dump, then like
+  // the fast 32bpp resolve copy (resolve_fast_32bpp_1x2xmsaa): half-pixel
+  // offset gap filling, red/blue swap, endian swap, resolution-scaled tiled
+  // destination addressing (texture_address.xesli, 4 bytes per block).
+  static const char kSource[] = R"(
+#extension GL_EXT_samplerless_texture_functions : require
+layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;
+layout(std430, set = 0, binding = 0) buffer XeDest { uvec4 xe_dest[]; };
+layout(set = 1, binding = 0) uniform texture2D xe_source;
+#ifdef XE_DEPTH
+layout(set = 1, binding = 1) uniform utexture2D xe_source_stencil;
+#endif
+layout(std430, set = 2, binding = 0) buffer XeVerify { uint xe_verify[]; };
+#ifdef XE_FORWARD
+#ifdef XE_DEPTH
+layout(set = 3, binding = 0, r32f) uniform writeonly image2D xe_forward;
+#else
+layout(set = 3, binding = 0, rgba8) uniform writeonly image2D xe_forward;
+#endif
+#endif
+layout(push_constant) uniform XePush {
+  uint edram_info;
+  uint coordinate_info;
+  uint dest_info;
+  uint dest_coordinate_info;
+  uvec2 origin;
+  uint height_scaled;
+  // 0 - store, otherwise compare, counting in xe_verify[2 * (verify - 1)].
+  uint verify;
+  // Forwarding: the texture's endianness and scaled width | height << 16.
+  uint forward_endian;
+  uint forward_size;
+} xe_push;
+
+int XenosTiledAddress2D(ivec2 p, uint pitch_macro_tiles, uint bytes_per_block_log2) {
+  int outer_blocks = ((p.y >> 5) * int(pitch_macro_tiles) + (p.x >> 5)) << 6;
+  int inner_blocks = (((p.y >> 1) & 7) << 3) | (p.x & 7);
+  int outer_inner_bytes = (outer_blocks | inner_blocks) << bytes_per_block_log2;
+  int bank = (p.y >> 4) & 1;
+  int pipe = ((p.x >> 3) & 3) ^ (((p.y >> 3) & 1) << 1);
+  return ((p.y & 1) << 4) | (pipe << 6) | (bank << 11) | (outer_inner_bytes & 0xF) |
+         (((outer_inner_bytes >> 4) & 1) << 5) | (((outer_inner_bytes >> 5) & 7) << 8) |
+         (outer_inner_bytes >> 8 << 12);
+}
+
+uint XePack(uvec2 c, uvec2 fill) {
+  ivec2 p = ivec2(xe_push.origin + max(c, fill));
+#ifdef XE_DEPTH
+  // Like the D24S8 dump: float32 depth to 24-bit unorm rounding to the nearest
+  // even, stencil in the low 8 bits.
+  uint depth24 = uint(roundEven(texelFetch(xe_source, p, 0).r * 16777215.0));
+  uint packed = bitfieldInsert(texelFetch(xe_source_stencil, p, 0).r, depth24, 8, 24);
+#else
+  vec4 v = texelFetch(xe_source, p, 0);
+  uvec4 b = uvec4(v * 255.0 + 0.5);
+  uint packed = b.r | (b.g << 8u) | (b.b << 16u) | (b.a << 24u);
+#endif
+  if ((xe_push.dest_info & (1u << 24u)) != 0u) {
+    packed = (packed & ~0xFF00FFu) | ((packed & 0xFFu) << 16u) | ((packed >> 16u) & 0xFFu);
+  }
+  uint endian = xe_push.dest_info & 7u;
+  if (endian == 1u || endian == 2u) {
+    packed = ((packed & 0x00FF00FFu) << 8u) | ((packed & 0xFF00FF00u) >> 8u);
+  }
+  if (endian == 2u || endian == 3u) {
+    packed = (packed << 16u) | (packed >> 16u);
+  }
+  return packed;
+}
+
+void main() {
+  uvec2 scale = (uvec2(xe_push.coordinate_info) >> uvec2(16u, 19u)) & 7u;
+  uint width_scaled = ((xe_push.coordinate_info >> 5u) & 0x7FFu) * 8u * scale.x;
+  // 1 invocation = 4 host pixels (one 16-byte host group) - faster than 1
+  // pixel per invocation (measured 2.8 vs 4.4 ms per frame at 4K).
+  uvec2 c = gl_GlobalInvocationID.xy << uvec2(2u, 0u);
+  if (c.x >= width_scaled || c.y >= xe_push.height_scaled) {
+    return;
+  }
+  uvec2 fill = (xe_push.edram_info & (1u << 29u)) != 0u ? (scale >> 1u) : uvec2(0u);
+  uvec4 packed = uvec4(XePack(c, fill), XePack(c + uvec2(1u, 0u), fill),
+                       XePack(c + uvec2(2u, 0u), fill), XePack(c + uvec2(3u, 0u), fill));
+  uvec2 dest_offset =
+      (((uvec2(xe_push.dest_coordinate_info) >> uvec2(20u, 24u)) & 15u) << 3u) * scale;
+  uvec2 host_position = c + dest_offset;
+  // Resolution-scaled addressing of the SDK's resolve shaders: guest groups of
+  // 4x1 blocks, each holding scale.x * scale.y host groups of 4x1 blocks in
+  // column-major order.
+  uvec2 host_group = uvec2(host_position.x >> 2u, host_position.y);
+  uvec2 guest_group = host_group / scale;
+  uvec2 host_group_in_guest_group = host_group - guest_group * scale;
+  uint host_byte_offset =
+      ((((host_group_in_guest_group.x * scale.y + host_group_in_guest_group.y) << 2u) |
+        (host_position.x & 3u))
+       << 2u);
+  uint address = uint(XenosTiledAddress2D(ivec2(guest_group.x << 2u, guest_group.y),
+                                          xe_push.dest_coordinate_info & 0x3FFu, 2u)) *
+                     (scale.x * scale.y) +
+                 host_byte_offset;
+#if !defined(XE_FORWARD) && !defined(XE_STORE_ONLY)
+  // Not in the forwarding and store-only variants (never verified): its dynamic
+  // indexing puts packed on the stack, costing the Mali 3 of 12 load / store
+  // cycles.
+  if (xe_push.verify != 0u) {
+    uint slot = 2u * (xe_push.verify - 1u);
+    atomicAdd(xe_verify[slot + 1u], 4u);
+    uvec4 expected = xe_dest[address >> 4u];
+    bvec4 different = notEqual(expected, packed);
+    if (any(different)) {
+      uint count = uint(different.x) + uint(different.y) + uint(different.z) + uint(different.w);
+      if (atomicAdd(xe_verify[slot], count) == 0u) {
+        // First mismatch: expected (copy) value, fused value, pixel.
+        uint i = different.x ? 0u : (different.y ? 1u : (different.z ? 2u : 3u));
+        xe_verify[8192u + 4u * (xe_push.verify - 1u)] = expected[i];
+        xe_verify[8193u + 4u * (xe_push.verify - 1u)] = packed[i];
+        xe_verify[8194u + 4u * (xe_push.verify - 1u)] = (c.x + i) | (c.y << 16u);
+      }
+    }
+  } else
+#endif
+  {
+    // Forward-only - stored to the buffer later from the texture if needed.
+    if ((xe_push.forward_endian & 0x100u) == 0u) {
+      xe_dest[address >> 4u] = packed;
+    }
+#ifdef XE_FORWARD
+    // What the direct resolved texture load would store for these texels (the
+    // forwarded texture has the same base and pitch, and the resolve has no
+    // destination offset).
+    if (host_position.y < (xe_push.forward_size >> 16u)) {
+      uvec4 v = packed;
+      uint forward_endian = xe_push.forward_endian & 7u;
+      if (forward_endian == 1u || forward_endian == 2u) {
+        v = ((v & 0x00FF00FFu) << 8u) | ((v & 0xFF00FF00u) >> 8u);
+      }
+      if (forward_endian == 2u || forward_endian == 3u) {
+        v = (v << 16u) | (v >> 16u);
+      }
+      for (uint i = 0u; i < 4u; ++i) {
+        uint x = host_position.x + i;
+        if (x >= (xe_push.forward_size & 0xFFFFu)) {
+          break;
+        }
+#ifdef XE_DEPTH
+        uint depth24_forward = v[i] >> 8u;
+        imageStore(xe_forward, ivec2(x, host_position.y),
+                   vec4(float(depth24_forward + (depth24_forward >> 23u)) * (1.0 / 16777216.0)));
+#else
+        imageStore(xe_forward, ivec2(x, host_position.y), unpackUnorm4x8(v[i]));
+#endif
+      }
+    }
+#endif
+  }
+}
+)";
+  for (uint32_t variant = 0; variant < 4; ++variant) {
+    uint32_t depth = variant & 1;
+    bool forward = (variant & 2) != 0;
+    std::string source = "#version 450\n";
+    if (depth) {
+      source += "#define XE_DEPTH 1\n";
+    }
+    if (forward) {
+      source += "#define XE_FORWARD 1\n";
+    }
+    source += kSource;
+    std::vector<uint32_t> spirv;
+    std::string compile_error;
+    if (!command_processor_.CompileGlslToSpirv(VK_SHADER_STAGE_COMPUTE_BIT, source, spirv,
+                                               compile_error)) {
+      REXGPU_ERROR("VulkanRenderTargetCache: Failed to compile the fused resolve shader: {}",
+                   compile_error);
+      return false;
+    }
+    VkPipeline& pipeline = forward ? fused_forward_pipelines_[depth]
+                                   : (depth ? fused_resolve_pipeline_depth_ : fused_resolve_pipeline_);
+    pipeline = ui::vulkan::util::CreateComputePipeline(
+        vulkan_device,
+        forward ? fused_forward_pipeline_layouts_[depth]
+                : (depth ? fused_resolve_pipeline_layout_depth_ : fused_resolve_pipeline_layout_),
+        spirv.data(), sizeof(uint32_t) * spirv.size());
+    if (pipeline == VK_NULL_HANDLE) {
+      REXGPU_ERROR("VulkanRenderTargetCache: Failed to create the fused resolve pipeline");
+      return false;
+    }
+  }
+  // Store-only variants for vulkan_resolve_forward_draw (optional).
+  if (REXCVAR_GET(vulkan_resolve_forward_draw)) {
+    for (uint32_t depth = 0; depth < 2; ++depth) {
+      std::string source = "#version 450\n#define XE_STORE_ONLY 1\n";
+      if (depth) {
+        source += "#define XE_DEPTH 1\n";
+      }
+      source += kSource;
+      std::vector<uint32_t> spirv;
+      std::string compile_error;
+      if (!command_processor_.CompileGlslToSpirv(VK_SHADER_STAGE_COMPUTE_BIT, source, spirv,
+                                                 compile_error)) {
+        REXGPU_ERROR("VulkanRenderTargetCache: Failed to compile the fused resolve store shader: {}",
+                     compile_error);
+        break;
+      }
+      fused_store_pipelines_[depth] = ui::vulkan::util::CreateComputePipeline(
+          vulkan_device,
+          depth ? fused_resolve_pipeline_layout_depth_ : fused_resolve_pipeline_layout_,
+          spirv.data(), sizeof(uint32_t) * spirv.size());
+    }
+  }
+  fused_resolve_pipeline_failed_ = false;
+  REXGPU_INFO("VulkanRenderTargetCache: Fused resolve enabled");
+  return true;
+}
+
+bool VulkanRenderTargetCache::EnsureFusedForwardDrawPipelines() {
+  if (fused_forward_draw_pipelines_[1] != VK_NULL_HANDLE) {
+    return true;
+  }
+  if (fused_forward_draw_failed_ || !REXCVAR_GET(vulkan_resolve_forward_draw) ||
+      fused_store_pipelines_[0] == VK_NULL_HANDLE ||
+      fused_store_pipelines_[1] == VK_NULL_HANDLE) {
+    return false;
+  }
+  fused_forward_draw_failed_ = true;
+  const ui::vulkan::VulkanDevice* const vulkan_device = command_processor_.GetVulkanDevice();
+  // With dynamic rendering, SubmitBarriersAndEnterRenderTargetCacheRenderPass
+  // doesn't use the render pass.
+  if (REXCVAR_GET(vulkan_dynamic_rendering) && vulkan_device->properties().dynamicRendering) {
+    return false;
+  }
+  const ui::vulkan::VulkanDevice::Functions& dfn = vulkan_device->functions();
+  const VkDevice device = vulkan_device->device();
+
+  // A full-screen triangle; the fragment shader writes what the fused resolve
+  // compute shader would have stored to the texture for the pixel (same
+  // packing, red / blue and endian swaps, half-pixel offset gap filling).
+  static const char kVertexSource[] = R"(#version 450
+void main() {
+  vec2 p = vec2(float((gl_VertexIndex << 1) & 2), float(gl_VertexIndex & 2));
+  gl_Position = vec4(p * 2.0 - 1.0, 0.0, 1.0);
+}
+)";
+  static const char kFragmentSource[] = R"(
+#extension GL_EXT_samplerless_texture_functions : require
+layout(set = 0, binding = 0) uniform texture2D xe_source;
+#ifdef XE_DEPTH
+layout(set = 0, binding = 1) uniform utexture2D xe_source_stencil;
+layout(location = 0) out float xe_out;
+#else
+layout(location = 0) out vec4 xe_out;
+#endif
+layout(push_constant) uniform XePush {
+  uint edram_info;
+  uint coordinate_info;
+  uint dest_info;
+  uint dest_coordinate_info;
+  uvec2 origin;
+  uint height_scaled;
+  uint verify;
+  uint forward_endian;
+  uint forward_size;
+} xe_push;
+
+void main() {
+  uvec2 scale = (uvec2(xe_push.coordinate_info) >> uvec2(16u, 19u)) & 7u;
+  uvec2 fill = (xe_push.edram_info & (1u << 29u)) != 0u ? (scale >> 1u) : uvec2(0u);
+  // Forwarding requires no destination offset - the pixel in the texture is
+  // the pixel in the resolve area.
+  ivec2 p = ivec2(xe_push.origin + max(uvec2(gl_FragCoord.xy), fill));
+#ifdef XE_DEPTH
+  uint depth24 = uint(roundEven(texelFetch(xe_source, p, 0).r * 16777215.0));
+  uint packed = bitfieldInsert(texelFetch(xe_source_stencil, p, 0).r, depth24, 8, 24);
+#else
+  vec4 v = texelFetch(xe_source, p, 0);
+  uvec4 b = uvec4(v * 255.0 + 0.5);
+  uint packed = b.r | (b.g << 8u) | (b.b << 16u) | (b.a << 24u);
+#endif
+  if ((xe_push.dest_info & (1u << 24u)) != 0u) {
+    packed = (packed & ~0xFF00FFu) | ((packed & 0xFFu) << 16u) | ((packed >> 16u) & 0xFFu);
+  }
+  uint endian = xe_push.dest_info & 7u;
+  if (endian == 1u || endian == 2u) {
+    packed = ((packed & 0x00FF00FFu) << 8u) | ((packed & 0xFF00FF00u) >> 8u);
+  }
+  if (endian == 2u || endian == 3u) {
+    packed = (packed << 16u) | (packed >> 16u);
+  }
+  uint forward_endian = xe_push.forward_endian & 7u;
+  if (forward_endian == 1u || forward_endian == 2u) {
+    packed = ((packed & 0x00FF00FFu) << 8u) | ((packed & 0xFF00FF00u) >> 8u);
+  }
+  if (forward_endian == 2u || forward_endian == 3u) {
+    packed = (packed << 16u) | (packed >> 16u);
+  }
+#ifdef XE_DEPTH
+  uint depth24_forward = packed >> 8u;
+  xe_out = float(depth24_forward + (depth24_forward >> 23u)) * (1.0 / 16777216.0);
+#else
+  xe_out = unpackUnorm4x8(packed);
+#endif
+}
+)";
+
+  std::vector<uint32_t> vertex_spirv;
+  std::string compile_error;
+  if (!command_processor_.CompileGlslToSpirv(VK_SHADER_STAGE_VERTEX_BIT, kVertexSource,
+                                             vertex_spirv, compile_error)) {
+    REXGPU_ERROR("VulkanRenderTargetCache: Failed to compile the fused forward vertex shader: {}",
+                 compile_error);
+    return false;
+  }
+  VkShaderModule vertex_module = ui::vulkan::util::CreateShaderModule(
+      vulkan_device, vertex_spirv.data(), sizeof(uint32_t) * vertex_spirv.size());
+  if (vertex_module == VK_NULL_HANDLE) {
+    return false;
+  }
+
+  bool succeeded = true;
+  for (uint32_t depth = 0; depth < 2 && succeeded; ++depth) {
+    succeeded = false;
+    VkFormat format = depth ? VK_FORMAT_R32_SFLOAT : VK_FORMAT_R8G8B8A8_UNORM;
+    // The whole attachment is written, the layout is set by barriers outside.
+    VkAttachmentDescription attachment = {};
+    attachment.format = format;
+    attachment.samples = VK_SAMPLE_COUNT_1_BIT;
+    attachment.loadOp = VK_ATTACHMENT_LOAD_OP_DONT_CARE;
+    attachment.storeOp = VK_ATTACHMENT_STORE_OP_STORE;
+    attachment.stencilLoadOp = VK_ATTACHMENT_LOAD_OP_DONT_CARE;
+    attachment.stencilStoreOp = VK_ATTACHMENT_STORE_OP_DONT_CARE;
+    attachment.initialLayout = VK_IMAGE_LAYOUT_COLOR_ATTACHMENT_OPTIMAL;
+    attachment.finalLayout = VK_IMAGE_LAYOUT_COLOR_ATTACHMENT_OPTIMAL;
+    VkAttachmentReference color_reference = {0, VK_IMAGE_LAYOUT_COLOR_ATTACHMENT_OPTIMAL};
+    VkSubpassDescription subpass = {};
+    subpass.pipelineBindPoint = VK_PIPELINE_BIND_POINT_GRAPHICS;
+    subpass.colorAttachmentCount = 1;
+    subpass.pColorAttachments = &color_reference;
+    VkRenderPassCreateInfo render_pass_create_info = {};
+    render_pass_create_info.sType = VK_STRUCTURE_TYPE_RENDER_PASS_CREATE_INFO;
+    render_pass_create_info.attachmentCount = 1;
+    render_pass_create_info.pAttachments = &attachment;
+    render_pass_create_info.subpassCount = 1;
+    render_pass_create_info.pSubpasses = &subpass;
+    if (dfn.vkCreateRenderPass(device, &render_pass_create_info, nullptr,
+                               &fused_forward_draw_render_passes_[depth]) != VK_SUCCESS) {
+      REXGPU_ERROR("VulkanRenderTargetCache: Failed to create the fused forward render pass");
+      break;
+    }
+
+    VkDescriptorSetLayout set_layout =
+        depth ? descriptor_set_layout_sampled_image_x2_ : descriptor_set_layout_sampled_image_;
+    VkPushConstantRange push_constant_range;
+    push_constant_range.stageFlags = VK_SHADER_STAGE_FRAGMENT_BIT;
+    push_constant_range.offset = 0;
+    push_constant_range.size = sizeof(uint32_t) * 10;
+    VkPipelineLayoutCreateInfo pipeline_layout_create_info = {};
+    pipeline_layout_create_info.sType = VK_STRUCTURE_TYPE_PIPELINE_LAYOUT_CREATE_INFO;
+    pipeline_layout_create_info.setLayoutCount = 1;
+    pipeline_layout_create_info.pSetLayouts = &set_layout;
+    pipeline_layout_create_info.pushConstantRangeCount = 1;
+    pipeline_layout_create_info.pPushConstantRanges = &push_constant_range;
+    if (dfn.vkCreatePipelineLayout(device, &pipeline_layout_create_info, nullptr,
+                                   &fused_forward_draw_pipeline_layouts_[depth]) != VK_SUCCESS) {
+      REXGPU_ERROR("VulkanRenderTargetCache: Failed to create the fused forward pipeline layout");
+      break;
+    }
+
+    std::string fragment_source = "#version 450\n";
+    if (depth) {
+      fragment_source += "#define XE_DEPTH 1\n";
+    }
+    fragment_source += kFragmentSource;
+    std::vector<uint32_t> fragment_spirv;
+    if (!command_processor_.CompileGlslToSpirv(VK_SHADER_STAGE_FRAGMENT_BIT, fragment_source,
+                                               fragment_spirv, compile_error)) {
+      REXGPU_ERROR(
+          "VulkanRenderTargetCache: Failed to compile the fused forward fragment shader: {}",
+          compile_error);
+      break;
+    }
+    VkShaderModule fragment_module = ui::vulkan::util::CreateShaderModule(
+        vulkan_device, fragment_spirv.data(), sizeof(uint32_t) * fragment_spirv.size());
+    if (fragment_module == VK_NULL_HANDLE) {
+      break;
+    }
+
+    VkPipelineShaderStageCreateInfo stages[2] = {};
+    stages[0].sType = VK_STRUCTURE_TYPE_PIPELINE_SHADER_STAGE_CREATE_INFO;
+    stages[0].stage = VK_SHADER_STAGE_VERTEX_BIT;
+    stages[0].module = vertex_module;
+    stages[0].pName = "main";
+    stages[1].sType = VK_STRUCTURE_TYPE_PIPELINE_SHADER_STAGE_CREATE_INFO;
+    stages[1].stage = VK_SHADER_STAGE_FRAGMENT_BIT;
+    stages[1].module = fragment_module;
+    stages[1].pName = "main";
+    VkPipelineVertexInputStateCreateInfo vertex_input = {};
+    vertex_input.sType = VK_STRUCTURE_TYPE_PIPELINE_VERTEX_INPUT_STATE_CREATE_INFO;
+    VkPipelineInputAssemblyStateCreateInfo input_assembly = {};
+    input_assembly.sType = VK_STRUCTURE_TYPE_PIPELINE_INPUT_ASSEMBLY_STATE_CREATE_INFO;
+    input_assembly.topology = VK_PRIMITIVE_TOPOLOGY_TRIANGLE_LIST;
+    VkPipelineViewportStateCreateInfo viewport_state = {};
+    viewport_state.sType = VK_STRUCTURE_TYPE_PIPELINE_VIEWPORT_STATE_CREATE_INFO;
+    viewport_state.viewportCount = 1;
+    viewport_state.scissorCount = 1;
+    VkPipelineRasterizationStateCreateInfo rasterization = {};
+    rasterization.sType = VK_STRUCTURE_TYPE_PIPELINE_RASTERIZATION_STATE_CREATE_INFO;
+    rasterization.polygonMode = VK_POLYGON_MODE_FILL;
+    rasterization.cullMode = VK_CULL_MODE_NONE;
+    rasterization.frontFace = VK_FRONT_FACE_CLOCKWISE;
+    rasterization.lineWidth = 1.0f;
+    VkPipelineMultisampleStateCreateInfo multisample = {};
+    multisample.sType = VK_STRUCTURE_TYPE_PIPELINE_MULTISAMPLE_STATE_CREATE_INFO;
+    multisample.rasterizationSamples = VK_SAMPLE_COUNT_1_BIT;
+    VkPipelineColorBlendAttachmentState blend_attachment = {};
+    blend_attachment.colorWriteMask = depth ? VK_COLOR_COMPONENT_R_BIT
+                                            : (VK_COLOR_COMPONENT_R_BIT | VK_COLOR_COMPONENT_G_BIT |
+                                               VK_COLOR_COMPONENT_B_BIT | VK_COLOR_COMPONENT_A_BIT);
+    VkPipelineColorBlendStateCreateInfo blend = {};
+    blend.sType = VK_STRUCTURE_TYPE_PIPELINE_COLOR_BLEND_STATE_CREATE_INFO;
+    blend.attachmentCount = 1;
+    blend.pAttachments = &blend_attachment;
+    static const VkDynamicState kDynamicStates[] = {VK_DYNAMIC_STATE_VIEWPORT,
+                                                    VK_DYNAMIC_STATE_SCISSOR};
+    VkPipelineDynamicStateCreateInfo dynamic_state = {};
+    dynamic_state.sType = VK_STRUCTURE_TYPE_PIPELINE_DYNAMIC_STATE_CREATE_INFO;
+    dynamic_state.dynamicStateCount = uint32_t(rex::countof(kDynamicStates));
+    dynamic_state.pDynamicStates = kDynamicStates;
+    VkGraphicsPipelineCreateInfo pipeline_create_info = {};
+    pipeline_create_info.sType = VK_STRUCTURE_TYPE_GRAPHICS_PIPELINE_CREATE_INFO;
+    pipeline_create_info.stageCount = 2;
+    pipeline_create_info.pStages = stages;
+    pipeline_create_info.pVertexInputState = &vertex_input;
+    pipeline_create_info.pInputAssemblyState = &input_assembly;
+    pipeline_create_info.pViewportState = &viewport_state;
+    pipeline_create_info.pRasterizationState = &rasterization;
+    pipeline_create_info.pMultisampleState = &multisample;
+    pipeline_create_info.pColorBlendState = &blend;
+    pipeline_create_info.pDynamicState = &dynamic_state;
+    pipeline_create_info.layout = fused_forward_draw_pipeline_layouts_[depth];
+    pipeline_create_info.renderPass = fused_forward_draw_render_passes_[depth];
+    VkResult pipeline_result =
+        dfn.vkCreateGraphicsPipelines(device, VK_NULL_HANDLE, 1, &pipeline_create_info, nullptr,
+                                      &fused_forward_draw_pipelines_[depth]);
+    dfn.vkDestroyShaderModule(device, fragment_module, nullptr);
+    if (pipeline_result != VK_SUCCESS) {
+      fused_forward_draw_pipelines_[depth] = VK_NULL_HANDLE;
+      REXGPU_ERROR("VulkanRenderTargetCache: Failed to create the fused forward pipeline");
+      break;
+    }
+    succeeded = true;
+  }
+  dfn.vkDestroyShaderModule(device, vertex_module, nullptr);
+  if (!succeeded) {
+    return false;
+  }
+  fused_forward_draw_failed_ = false;
+  REXGPU_INFO("VulkanRenderTargetCache: Fused resolve forwarding by fragment passes enabled");
+  return true;
+}
+
+bool VulkanRenderTargetCache::PerformFusedResolve(
+    const draw_util::ResolveInfo& resolve_info,
+    const draw_util::ResolveCopyShaderConstants& copy_shader_constants,
+    VkDescriptorSet descriptor_set_dest, VulkanRenderTarget& source_rt, uint32_t origin_x,
+    uint32_t origin_y, bool verify, const VulkanTextureCache::ResolveForwardTarget* forward) {
+  VulkanCommandProcessor::ProfScope prof_scope(command_processor_,
+                                               VulkanCommandProcessor::ProfStage::kResolveDirect);
+  // TEMP: per fused resolve time (vs = 7F + destination, ps = size + depth).
+  command_processor_.ProfTagged(
+      VulkanCommandProcessor::ProfStage::kResolveDirect,
+      0x7F00000000000000ull | resolve_info.copy_dest_base,
+      (uint64_t(resolve_info.coordinate_info.width_div_8 << 3) << 32) |
+          (uint64_t(resolve_info.height_div_8 << 3) << 16) | uint64_t(source_rt.key().is_depth),
+      1);
+  const ui::vulkan::VulkanDevice* const vulkan_device = command_processor_.GetVulkanDevice();
+  const ui::vulkan::VulkanDevice::Functions& dfn = vulkan_device->functions();
+  const VkDevice device = vulkan_device->device();
+
+  VkDescriptorSet descriptor_set_verify = descriptor_set_dest;
+  uint32_t verify_slot = 0;
+  if (verify) {
+    // TEMP: NIER_FUSED_VERIFY=<frame> checks every fused resolve of 2 frames
+    // separately and logs the results 30 frames later.
+    static const uint64_t verify_frame = [] {
+      const char* v = std::getenv("NIER_FUSED_VERIFY");
+      uint64_t frame = v ? uint64_t(std::atoll(v)) : 0;
+      return frame > 1 ? frame : uint64_t(2800);
+    }();
+    struct VerifyRecord {
+      uint64_t frame;
+      uint32_t dest_base, width, height, origin_x, origin_y, rt_base, rt_pitch, edram_base,
+          dest_pitch, endian, swap, fill;
+    };
+    static std::vector<VerifyRecord> verify_records;
+    static bool verify_reported = false;
+    uint64_t frame = command_processor_.GetCurrentFrame();
+    if (!verify_reported && frame >= verify_frame + 30 && fused_verify_mapping_) {
+      verify_reported = true;
+      VkMappedMemoryRange range = {};
+      range.sType = VK_STRUCTURE_TYPE_MAPPED_MEMORY_RANGE;
+      range.memory = fused_verify_memory_;
+      range.size = VK_WHOLE_SIZE;
+      dfn.vkInvalidateMappedMemoryRanges(device, 1, &range);
+      for (size_t i = 0; i < verify_records.size(); ++i) {
+        const VerifyRecord& r = verify_records[i];
+        const uint32_t* first = fused_verify_mapping_ + 8192 + 4 * i;
+        REXGPU_INFO(
+            "FUSEDVERIFY f={} dest={:08X} {}x{} origin={},{} rt_base={} rt_pitch={} edram_base={} "
+            "dest_pitch={} endian={} swap={} fill={} checked={} mismatches={} first: copy={:08X} "
+            "fused={:08X} at {},{}",
+            r.frame, r.dest_base, r.width, r.height, r.origin_x, r.origin_y, r.rt_base,
+            r.rt_pitch, r.edram_base, r.dest_pitch, r.endian, r.swap, r.fill,
+            fused_verify_mapping_[2 * i + 1], fused_verify_mapping_[2 * i], first[0], first[1],
+            first[2] & 0xFFFF, first[2] >> 16);
+      }
+    }
+    if (frame < verify_frame || frame >= verify_frame + 2 || verify_records.size() >= 4096) {
+      return false;
+    }
+    verify_slot = uint32_t(verify_records.size()) + 1;
+    VerifyRecord record;
+    record.frame = frame;
+    record.dest_base = resolve_info.copy_dest_base;
+    record.width = resolve_info.coordinate_info.width_div_8 << 3;
+    record.height = resolve_info.height_div_8 << 3;
+    record.origin_x = origin_x;
+    record.origin_y = origin_y;
+    record.rt_base = source_rt.key().base_tiles;
+    record.rt_pitch = source_rt.key().GetPitchTiles();
+    record.edram_base = resolve_info.color_edram_info.base_tiles;
+    record.dest_pitch = resolve_info.copy_dest_coordinate_info.pitch_aligned_div_32 << 5;
+    record.endian = uint32_t(resolve_info.copy_dest_info.copy_dest_endian);
+    record.swap = resolve_info.copy_dest_info.copy_dest_swap;
+    record.fill = resolve_info.color_edram_info.fill_half_pixel_offset;
+    verify_records.push_back(record);
+    if (fused_verify_buffer_ == VK_NULL_HANDLE) {
+      uint32_t memory_type;
+      VkDeviceSize memory_size;
+      if (!ui::vulkan::util::CreateDedicatedAllocationBuffer(
+              vulkan_device, sizeof(uint32_t) * (8192 + 4 * 4096),
+              VK_BUFFER_USAGE_STORAGE_BUFFER_BIT,
+              ui::vulkan::util::MemoryPurpose::kReadback, fused_verify_buffer_,
+              fused_verify_memory_, &memory_type, &memory_size) ||
+          dfn.vkMapMemory(device, fused_verify_memory_, 0, VK_WHOLE_SIZE, 0,
+                          reinterpret_cast<void**>(&fused_verify_mapping_)) != VK_SUCCESS) {
+        REXGPU_ERROR("VulkanRenderTargetCache: Failed to create the fused resolve verify buffer");
+        return false;
+      }
+      std::memset(fused_verify_mapping_, 0, sizeof(uint32_t) * (8192 + 4 * 4096));
+      VkMappedMemoryRange range = {};
+      range.sType = VK_STRUCTURE_TYPE_MAPPED_MEMORY_RANGE;
+      range.memory = fused_verify_memory_;
+      range.size = VK_WHOLE_SIZE;
+      dfn.vkFlushMappedMemoryRanges(device, 1, &range);
+    }
+    descriptor_set_verify = command_processor_.AllocateSingleTransientDescriptor(
+        VulkanCommandProcessor::SingleTransientDescriptorLayout::kStorageBufferCompute);
+    if (descriptor_set_verify == VK_NULL_HANDLE) {
+      return false;
+    }
+    VkDescriptorBufferInfo verify_buffer_info;
+    verify_buffer_info.buffer = fused_verify_buffer_;
+    verify_buffer_info.offset = 0;
+    verify_buffer_info.range = VK_WHOLE_SIZE;
+    VkWriteDescriptorSet write_descriptor_set = {};
+    write_descriptor_set.sType = VK_STRUCTURE_TYPE_WRITE_DESCRIPTOR_SET;
+    write_descriptor_set.dstSet = descriptor_set_verify;
+    write_descriptor_set.descriptorCount = 1;
+    write_descriptor_set.descriptorType = VK_DESCRIPTOR_TYPE_STORAGE_BUFFER;
+    write_descriptor_set.pBufferInfo = &verify_buffer_info;
+    dfn.vkUpdateDescriptorSets(device, 1, &write_descriptor_set, 0, nullptr);
+    ++fused_verify_dispatches_;
+  }
+
+  // Same as for the dump (also read by the fragment pass writing the texture
+  // with vulkan_resolve_forward_draw).
+  bool is_depth = source_rt.key().is_depth;
+  bool forward_draw = !verify && forward && forward->draw &&
+                      fused_forward_draw_pipelines_[is_depth] != VK_NULL_HANDLE &&
+                      fused_store_pipelines_[is_depth] != VK_NULL_HANDLE;
+  VkPipelineStageFlags source_read_stages =
+      VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT |
+      (forward_draw ? VK_PIPELINE_STAGE_FRAGMENT_SHADER_BIT : VkPipelineStageFlags(0));
+  command_processor_.PushImageMemoryBarrier(
+      source_rt.image(),
+      ui::vulkan::util::InitializeSubresourceRange(
+          is_depth ? (VK_IMAGE_ASPECT_DEPTH_BIT | VK_IMAGE_ASPECT_STENCIL_BIT)
+                   : VK_IMAGE_ASPECT_COLOR_BIT),
+      source_rt.current_stage_mask(), source_read_stages, source_rt.current_access_mask(),
+      VK_ACCESS_SHADER_READ_BIT, source_rt.current_layout(),
+      VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL);
+  source_rt.SetUsage(source_read_stages, VK_ACCESS_SHADER_READ_BIT,
+                     VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL);
+  if (forward_draw) {
+    return PerformFusedResolveForwardDraw(resolve_info, copy_shader_constants,
+                                          descriptor_set_dest, source_rt, origin_x, origin_y,
+                                          *forward);
+  }
+  if (verify || (forward && (forward->draw || fused_forward_pipelines_[is_depth] == VK_NULL_HANDLE))) {
+    // A target prepared for drawing can't be written by the compute shader.
+    forward = nullptr;
+  }
+  // TEMP (cost split measurement, breaks the image): NIER_FUSED_COST=1 skips
+  // the memory store of forwarded resolves, 2 skips the texture write.
+  static const int fused_cost = [] {
+    const char* v = std::getenv("NIER_FUSED_COST");
+    return v ? std::atoi(v) : 0;
+  }();
+  if ((fused_cost & 2) && forward) {
+    forward = nullptr;
+  }
+  VkPipelineLayout pipeline_layout =
+      forward ? fused_forward_pipeline_layouts_[is_depth]
+              : (is_depth ? fused_resolve_pipeline_layout_depth_ : fused_resolve_pipeline_layout_);
+
+  DeferredCommandBuffer& command_buffer = command_processor_.deferred_command_buffer();
+  command_processor_.BindExternalComputePipeline(
+      forward ? fused_forward_pipelines_[is_depth]
+              : (is_depth ? fused_resolve_pipeline_depth_ : fused_resolve_pipeline_));
+  VkDescriptorSet descriptor_sets[4] = {
+      descriptor_set_dest, source_rt.GetDescriptorSetTransferSource(), descriptor_set_verify,
+      forward ? forward->image_descriptor_set : VK_NULL_HANDLE};
+  command_buffer.CmdVkBindDescriptorSets(VK_PIPELINE_BIND_POINT_COMPUTE, pipeline_layout, 0,
+                                         forward ? 4 : 3, descriptor_sets, 0, nullptr);
+  uint32_t width_scaled = (resolve_info.coordinate_info.width_div_8 << 3) * draw_resolution_scale_x();
+  uint32_t height_scaled = (resolve_info.height_div_8 << 3) * draw_resolution_scale_y();
+  // TEMP: NIER_FWDONLY_VERIFY - also stores forward-only resolves, to compare.
+  static const bool fwdonly_verify = std::getenv("NIER_FWDONLY_VERIFY") != nullptr;
+  const draw_util::ResolveCopyShaderConstants::DestRelative& dest_relative =
+      copy_shader_constants.dest_relative;
+  uint32_t push_constants[10] = {
+      dest_relative.edram_info.packed,
+      dest_relative.coordinate_info.packed,
+      dest_relative.dest_info.value,
+      dest_relative.dest_coordinate_info.packed,
+      origin_x,
+      origin_y,
+      height_scaled,
+      verify_slot,
+      forward ? forward->endian |
+                    (uint32_t((forward->forward_only && !fwdonly_verify) || (fused_cost & 1)) << 8)
+              : 0,
+      forward ? forward->width_scaled | (forward->height_scaled << 16) : 0};
+  command_buffer.CmdVkPushConstants(pipeline_layout, VK_SHADER_STAGE_COMPUTE_BIT, 0,
+                                    sizeof(push_constants), push_constants);
+  command_processor_.SubmitBarriers(true);
+  command_buffer.CmdVkDispatch((width_scaled + 31) / 32, (height_scaled + 7) / 8, 1);
+  ++fused_resolve_count_;
+  return forward != nullptr;
+}
+
+bool VulkanRenderTargetCache::PerformFusedResolveForwardDraw(
+    const draw_util::ResolveInfo& resolve_info,
+    const draw_util::ResolveCopyShaderConstants& copy_shader_constants,
+    VkDescriptorSet descriptor_set_dest, VulkanRenderTarget& source_rt, uint32_t origin_x,
+    uint32_t origin_y, const VulkanTextureCache::ResolveForwardTarget& forward) {
+  const ui::vulkan::VulkanDevice* const vulkan_device = command_processor_.GetVulkanDevice();
+  const ui::vulkan::VulkanDevice::Functions& dfn = vulkan_device->functions();
+  const VkDevice device = vulkan_device->device();
+  bool is_depth = source_rt.key().is_depth;
+  DeferredCommandBuffer& command_buffer = command_processor_.deferred_command_buffer();
+
+  // The framebuffer of the texture's base level.
+  if (*forward.framebuffer == VK_NULL_HANDLE) {
+    VkFramebufferCreateInfo framebuffer_create_info = {};
+    framebuffer_create_info.sType = VK_STRUCTURE_TYPE_FRAMEBUFFER_CREATE_INFO;
+    framebuffer_create_info.renderPass = fused_forward_draw_render_passes_[is_depth];
+    framebuffer_create_info.attachmentCount = 1;
+    framebuffer_create_info.pAttachments = &forward.view;
+    framebuffer_create_info.width = forward.width_scaled;
+    framebuffer_create_info.height = forward.height_scaled;
+    framebuffer_create_info.layers = 1;
+    if (dfn.vkCreateFramebuffer(device, &framebuffer_create_info, nullptr, forward.framebuffer) !=
+        VK_SUCCESS) {
+      *forward.framebuffer = VK_NULL_HANDLE;
+      REXGPU_ERROR("VulkanRenderTargetCache: Failed to create a fused forward framebuffer");
+      return false;
+    }
+  }
+  // Handles may be reused after a texture is destroyed - always updated.
+  Framebuffer& framebuffer = fused_forward_draw_framebuffers_[*forward.framebuffer];
+  framebuffer.framebuffer = *forward.framebuffer;
+  framebuffer.host_extent.width = forward.width_scaled;
+  framebuffer.host_extent.height = forward.height_scaled;
+
+  uint32_t height_scaled = (resolve_info.height_div_8 << 3) * draw_resolution_scale_y();
+  const draw_util::ResolveCopyShaderConstants::DestRelative& dest_relative =
+      copy_shader_constants.dest_relative;
+  uint32_t push_constants[10] = {dest_relative.edram_info.packed,
+                                 dest_relative.coordinate_info.packed,
+                                 dest_relative.dest_info.value,
+                                 dest_relative.dest_coordinate_info.packed,
+                                 origin_x,
+                                 origin_y,
+                                 height_scaled,
+                                 0,
+                                 forward.endian,
+                                 forward.width_scaled | (forward.height_scaled << 16)};
+
+  // Memory, unless the texture is the only copy.
+  // TEMP (ceiling measurement, may break the image): NIER_FUSED_COST=1 skips it.
+  static const bool skip_store = [] {
+    const char* v = std::getenv("NIER_FUSED_COST");
+    return v && (std::atoi(v) & 1);
+  }();
+  if (!forward.forward_only && !skip_store) {
+    VulkanCommandProcessor::ProfScope prof_scope(command_processor_,
+                                                 VulkanCommandProcessor::ProfStage::kResolveDirect);
+    VkPipelineLayout pipeline_layout =
+        is_depth ? fused_resolve_pipeline_layout_depth_ : fused_resolve_pipeline_layout_;
+    command_processor_.BindExternalComputePipeline(fused_store_pipelines_[is_depth]);
+    // Set 2 (verification) is unused by the store-only shader.
+    VkDescriptorSet descriptor_sets[3] = {descriptor_set_dest,
+                                          source_rt.GetDescriptorSetTransferSource(),
+                                          descriptor_set_dest};
+    command_buffer.CmdVkBindDescriptorSets(VK_PIPELINE_BIND_POINT_COMPUTE, pipeline_layout, 0, 3,
+                                           descriptor_sets, 0, nullptr);
+    command_buffer.CmdVkPushConstants(pipeline_layout, VK_SHADER_STAGE_COMPUTE_BIT, 0,
+                                      sizeof(push_constants), push_constants);
+    command_processor_.SubmitBarriers(true);
+    uint32_t width_scaled =
+        (resolve_info.coordinate_info.width_div_8 << 3) * draw_resolution_scale_x();
+    command_buffer.CmdVkDispatch((width_scaled + 31) / 32, (height_scaled + 7) / 8, 1);
+  }
+
+  // The texture, all of it (the resolve covers the whole base level).
+  VkRect2D area;
+  area.offset = {0, 0};
+  area.extent = framebuffer.host_extent;
+  command_processor_.SubmitBarriersAndEnterRenderTargetCacheRenderPass(
+      fused_forward_draw_render_passes_[is_depth], &framebuffer, forward.view, false, &area);
+  command_processor_.BindExternalGraphicsPipeline(fused_forward_draw_pipelines_[is_depth]);
+  VkDescriptorSet source_descriptor_set = source_rt.GetDescriptorSetTransferSource();
+  command_buffer.CmdVkBindDescriptorSets(VK_PIPELINE_BIND_POINT_GRAPHICS,
+                                         fused_forward_draw_pipeline_layouts_[is_depth], 0, 1,
+                                         &source_descriptor_set, 0, nullptr);
+  command_buffer.CmdVkPushConstants(fused_forward_draw_pipeline_layouts_[is_depth],
+                                    VK_SHADER_STAGE_FRAGMENT_BIT, 0, sizeof(push_constants),
+                                    push_constants);
+  VkViewport viewport;
+  viewport.x = 0.0f;
+  viewport.y = 0.0f;
+  viewport.width = float(area.extent.width);
+  viewport.height = float(area.extent.height);
+  viewport.minDepth = 0.0f;
+  viewport.maxDepth = 1.0f;
+  command_processor_.SetViewport(viewport);
+  command_processor_.SetScissor(area);
+  command_buffer.CmdVkDraw(3, 1, 0, 0);
+  command_processor_.EndRenderPass();
+  ++fused_resolve_count_;
+  return true;
+}
+
+bool VulkanRenderTargetCache::EnsureStencilTransferPipelines() {
+  if (stencil_transfer_pipelines_[0] != VK_NULL_HANDLE) {
+    return true;
+  }
+  if (stencil_transfer_pipelines_failed_) {
+    return false;
+  }
+  stencil_transfer_pipelines_failed_ = true;
+  const ui::vulkan::VulkanDevice* const vulkan_device = command_processor_.GetVulkanDevice();
+  const ui::vulkan::VulkanDevice::Functions& dfn = vulkan_device->functions();
+  const VkDevice device = vulkan_device->device();
+
+  VkDescriptorSetLayout set_layouts[2] = {
+      command_processor_.GetSingleTransientDescriptorLayout(
+          VulkanCommandProcessor::SingleTransientDescriptorLayout::kStorageBufferCompute),
+      VK_NULL_HANDLE};
+  VkPushConstantRange push_constant_range;
+  push_constant_range.stageFlags = VK_SHADER_STAGE_COMPUTE_BIT;
+  push_constant_range.offset = 0;
+  push_constant_range.size = sizeof(uint32_t) * 5;
+  VkPipelineLayoutCreateInfo pipeline_layout_create_info = {};
+  pipeline_layout_create_info.sType = VK_STRUCTURE_TYPE_PIPELINE_LAYOUT_CREATE_INFO;
+  pipeline_layout_create_info.setLayoutCount = 2;
+  pipeline_layout_create_info.pSetLayouts = set_layouts;
+  pipeline_layout_create_info.pushConstantRangeCount = 1;
+  pipeline_layout_create_info.pPushConstantRanges = &push_constant_range;
+
+  // One invocation per 4 destination pixels of a row of a rectangle, writing
+  // their stencil bytes as one dword. The source pixel is found like in the
+  // transfer shaders for 1x 32bpp: the destination 32bpp tile and the pixel
+  // in it, the tile moved to the source by the EDRAM base difference, and the
+  // 40-sample halves of the tile swapped between color and depth. The value is
+  // like for the stencil bit draws: the stencil of a depth source, or red * 255
+  // of an 8888 color source.
+  std::string source = fmt::format(
+      "#extension GL_EXT_samplerless_texture_functions : require\n"
+      "#define XE_PITCH_BITS {}u\n"
+      "#define XE_BASE_BITS {}\n"
+      "#define XE_TILE_COUNT {}u\n"
+      "#define XE_TILE_WIDTH {}u\n"
+      "#define XE_TILE_HEIGHT {}u\n",
+      xenos::kEdramPitchTilesBits, xenos::kEdramBaseTilesBits, xenos::kEdramTileCount,
+      xenos::kEdramTileWidthSamples, xenos::kEdramTileHeightSamples);
+  source += R"(
+layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;
+layout(std430, set = 0, binding = 0) buffer XeDest { uint xe_dest[]; };
+#ifdef XE_SOURCE_DEPTH
+layout(set = 1, binding = 1) uniform utexture2D xe_source_stencil;
+#else
+layout(set = 1, binding = 0) uniform texture2D xe_source_color;
+#endif
+layout(push_constant) uniform XePush {
+  uint address;
+  uint rect_origin;
+  uint rect_size;
+  uint dest_offset_dwords;
+  uint row_dwords;
+} xe_push;
+
+uint XeStencil(uvec2 p) {
+  uint dest_pitch = bitfieldExtract(xe_push.address, 0, int(XE_PITCH_BITS));
+  uint source_pitch = bitfieldExtract(xe_push.address, int(XE_PITCH_BITS), int(XE_PITCH_BITS));
+  int source_to_dest =
+      bitfieldExtract(int(xe_push.address), int(XE_PITCH_BITS) * 2, XE_BASE_BITS + 1);
+  uint tile_pixel_x = p.x % XE_TILE_WIDTH;
+  uint tile_pixel_y = p.y % XE_TILE_HEIGHT;
+  uint dest_tile = dest_pitch * (p.y / XE_TILE_HEIGHT) + p.x / XE_TILE_WIDTH;
+#ifndef XE_SOURCE_DEPTH
+  tile_pixel_x = tile_pixel_x < (XE_TILE_WIDTH >> 1u) ? tile_pixel_x + (XE_TILE_WIDTH >> 1u)
+                                                       : tile_pixel_x - (XE_TILE_WIDTH >> 1u);
+#endif
+  uint source_tile = uint(int(dest_tile) + source_to_dest) & (XE_TILE_COUNT - 1u);
+  ivec2 source_pixel = ivec2((source_tile % source_pitch) * XE_TILE_WIDTH + tile_pixel_x,
+                             (source_tile / source_pitch) * XE_TILE_HEIGHT + tile_pixel_y);
+#ifdef XE_SOURCE_DEPTH
+  return texelFetch(xe_source_stencil, source_pixel, 0).r & 0xFFu;
+#else
+  return uint(texelFetch(xe_source_color, source_pixel, 0).r * 255.0 + 0.5) & 0xFFu;
+#endif
+}
+
+void main() {
+  uvec2 size = uvec2(xe_push.rect_size & 0xFFFFu, xe_push.rect_size >> 16u);
+  uvec2 c = gl_GlobalInvocationID.xy;
+  if (c.y >= size.y || c.x >= xe_push.row_dwords) {
+    return;
+  }
+  uvec2 origin = uvec2(xe_push.rect_origin & 0xFFFFu, xe_push.rect_origin >> 16u);
+  uint packed = 0u;
+  for (uint i = 0u; i < 4u; ++i) {
+    uint x = c.x * 4u + i;
+    if (x < size.x) {
+      packed |= XeStencil(origin + uvec2(x, c.y)) << (8u * i);
+    }
+  }
+  xe_dest[xe_push.dest_offset_dwords + c.y * xe_push.row_dwords + c.x] = packed;
+}
+)";
+  for (uint32_t depth = 0; depth < 2; ++depth) {
+    set_layouts[1] =
+        depth ? descriptor_set_layout_sampled_image_x2_ : descriptor_set_layout_sampled_image_;
+    if (dfn.vkCreatePipelineLayout(device, &pipeline_layout_create_info, nullptr,
+                                   &stencil_transfer_pipeline_layouts_[depth]) != VK_SUCCESS) {
+      REXGPU_ERROR("VulkanRenderTargetCache: Failed to create the stencil transfer layout");
+      return false;
+    }
+    std::vector<uint32_t> spirv;
+    std::string compile_error;
+    if (!command_processor_.CompileGlslToSpirv(
+            VK_SHADER_STAGE_COMPUTE_BIT,
+            std::string("#version 450\n") + (depth ? "#define XE_SOURCE_DEPTH 1\n" : "") + source,
+            spirv, compile_error)) {
+      REXGPU_ERROR("VulkanRenderTargetCache: Failed to compile the stencil transfer shader: {}",
+                   compile_error);
+      return false;
+    }
+    stencil_transfer_pipelines_[depth] = ui::vulkan::util::CreateComputePipeline(
+        vulkan_device, stencil_transfer_pipeline_layouts_[depth], spirv.data(),
+        sizeof(uint32_t) * spirv.size());
+    if (stencil_transfer_pipelines_[depth] == VK_NULL_HANDLE) {
+      REXGPU_ERROR("VulkanRenderTargetCache: Failed to create the stencil transfer pipeline");
+      return false;
+    }
+  }
+  stencil_transfer_pipelines_failed_ = false;
+  REXGPU_INFO("VulkanRenderTargetCache: Stencil transfer with compute enabled");
+  return true;
+}
+
+bool VulkanRenderTargetCache::TransferStencilWithCompute(VulkanRenderTarget& dest_rt,
+                                                         const std::vector<Transfer>& transfers,
+                                                         const Transfer::Rectangle* cutout) {
+  if (!REXCVAR_GET(vulkan_transfer_stencil_compute) || transfers.empty()) {
+    return false;
+  }
+  RenderTargetKey dest_key = dest_rt.key();
+  if (dest_key.msaa_samples != xenos::MsaaSamples::k1X || draw_resolution_scale_x() != 1 ||
+      draw_resolution_scale_y() != 1) {
+    return false;
+  }
+  for (const Transfer& transfer : transfers) {
+    RenderTargetKey source_key = transfer.source->key();
+    if (source_key.msaa_samples != xenos::MsaaSamples::k1X ||
+        (!source_key.is_depth &&
+         source_key.GetColorFormat() != xenos::ColorRenderTargetFormat::k_8_8_8_8)) {
+      return false;
+    }
+  }
+  if (!EnsureStencilTransferPipelines()) {
+    return false;
+  }
+
+  // TEMP: NIER_STENCIL_VERIFY=<frame> - for 2 frames, the per-bit draws still
+  // write the stencil, and both results are compared 30 frames later.
+  static const uint64_t verify_frame = [] {
+    const char* v = std::getenv("NIER_STENCIL_VERIFY");
+    return v ? uint64_t(std::atoll(v)) : uint64_t(0);
+  }();
+  constexpr uint32_t kVerifyBufferSize = 64 << 20;
+  struct VerifyRecord {
+    uint32_t offset, size;
+    uint32_t source_is_depth, x, y, width, height, address;
+  };
+  static std::vector<VerifyRecord> verify_records;
+  const ui::vulkan::VulkanDevice* const vulkan_device = command_processor_.GetVulkanDevice();
+  const ui::vulkan::VulkanDevice::Functions& dfn = vulkan_device->functions();
+  const VkDevice device = vulkan_device->device();
+  uint64_t frame = command_processor_.GetCurrentFrame();
+  if (verify_frame && !stencil_verify_reported_ && frame >= verify_frame + 30 &&
+      stencil_verify_mapping_) {
+    stencil_verify_reported_ = true;
+    VkMappedMemoryRange range = {};
+    range.sType = VK_STRUCTURE_TYPE_MAPPED_MEMORY_RANGE;
+    range.memory = stencil_verify_memory_;
+    range.size = VK_WHOLE_SIZE;
+    dfn.vkInvalidateMappedMemoryRanges(device, 1, &range);
+    uint64_t checked = 0, mismatches = 0;
+    for (const VerifyRecord& record : verify_records) {
+      const uint8_t* compute = stencil_verify_mapping_ + record.offset;
+      const uint8_t* draws = compute + (kVerifyBufferSize >> 1);
+      uint32_t record_mismatches = 0;
+      int32_t first = -1;
+      for (uint32_t i = 0; i < record.size; ++i) {
+        if (compute[i] != draws[i]) {
+          if (first < 0) {
+            first = int32_t(i);
+          }
+          ++record_mismatches;
+        }
+      }
+      checked += record.size;
+      mismatches += record_mismatches;
+      uint32_t compute_values[256] = {}, draw_values[256] = {};
+      for (uint32_t i = 0; i < record.size; ++i) {
+        ++compute_values[compute[i]];
+        ++draw_values[draws[i]];
+      }
+      auto top = [](const uint32_t* values) {
+        std::string s;
+        for (uint32_t n = 0; n < 3; ++n) {
+          uint32_t best = 0;
+          for (uint32_t v = 1; v < 256; ++v) {
+            if (values[v] > values[best]) {
+              best = v;
+            }
+          }
+          if (!values[best]) {
+            break;
+          }
+          s += fmt::format(" {:02X}x{}", best, values[best]);
+          const_cast<uint32_t*>(values)[best] = 0;
+        }
+        return s;
+      };
+      REXGPU_INFO("STENCILVERIFY {} rect {},{} {}x{} address {:08X}: {} mismatches of {}, first "
+                  "at {}; compute{} | draws{}",
+                  record.source_is_depth ? "depth" : "color", record.x, record.y, record.width,
+                  record.height, record.address, record_mismatches, record.size, first,
+                  top(compute_values), top(draw_values));
+    }
+    REXGPU_INFO("STENCILVERIFY regions={} bytes checked={} mismatches={}", verify_records.size(),
+                checked, mismatches);
+  }
+  bool verify = verify_frame && frame >= verify_frame && frame < verify_frame + 2;
+
+  // Gather the rectangles: each tightly packed in dwords of 4 stencil bytes.
+  struct Item {
+    VulkanRenderTarget* source;
+    Transfer::Rectangle rectangle;
+    uint32_t offset_dwords;
+    uint32_t row_dwords;
+  };
+  static std::vector<Item> items;
+  items.clear();
+  uint32_t total_dwords = 0;
+  for (const Transfer& transfer : transfers) {
+    Transfer::Rectangle rectangles[Transfer::kMaxRectanglesWithCutout];
+    uint32_t rectangle_count =
+        transfer.GetRectangles(dest_key.base_tiles, dest_key.GetPitchTiles(),
+                               dest_key.msaa_samples, false, rectangles, cutout);
+    for (uint32_t i = 0; i < rectangle_count; ++i) {
+      if (!rectangles[i].width_pixels || !rectangles[i].height_pixels) {
+        continue;
+      }
+      Item& item = items.emplace_back();
+      item.source = static_cast<VulkanRenderTarget*>(transfer.source);
+      item.rectangle = rectangles[i];
+      item.offset_dwords = total_dwords;
+      item.row_dwords = (rectangles[i].width_pixels + 3) / 4;
+      total_dwords += item.row_dwords * rectangles[i].height_pixels;
+    }
+  }
+  if (items.empty()) {
+    return true;
+  }
+  if (verify) {
+    if (stencil_verify_buffer_ == VK_NULL_HANDLE) {
+      uint32_t memory_type;
+      VkDeviceSize memory_size;
+      if (!ui::vulkan::util::CreateDedicatedAllocationBuffer(
+              vulkan_device, kVerifyBufferSize, VK_BUFFER_USAGE_TRANSFER_DST_BIT,
+              ui::vulkan::util::MemoryPurpose::kReadback, stencil_verify_buffer_,
+              stencil_verify_memory_, &memory_type, &memory_size) ||
+          dfn.vkMapMemory(device, stencil_verify_memory_, 0, VK_WHOLE_SIZE, 0,
+                          reinterpret_cast<void**>(&stencil_verify_mapping_)) != VK_SUCCESS) {
+        return false;
+      }
+    }
+    if (stencil_verify_used_ + total_dwords * 4 > (kVerifyBufferSize >> 1)) {
+      verify = false;
+    }
+  }
+
+  VulkanCommandProcessor::ScratchBufferAcquisition scratch =
+      command_processor_.AcquireScratchGpuBuffer(VkDeviceSize(total_dwords) * 4,
+                                                 VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT,
+                                                 VK_ACCESS_SHADER_WRITE_BIT);
+  if (scratch.buffer() == VK_NULL_HANDLE) {
+    return false;
+  }
+  VkDescriptorSet descriptor_set_dest = command_processor_.AllocateSingleTransientDescriptor(
+      VulkanCommandProcessor::SingleTransientDescriptorLayout::kStorageBufferCompute);
+  if (descriptor_set_dest == VK_NULL_HANDLE) {
+    return false;
+  }
+  VkDescriptorBufferInfo dest_buffer_info;
+  dest_buffer_info.buffer = scratch.buffer();
+  dest_buffer_info.offset = 0;
+  dest_buffer_info.range = VkDeviceSize(total_dwords) * 4;
+  VkWriteDescriptorSet write_descriptor_set = {};
+  write_descriptor_set.sType = VK_STRUCTURE_TYPE_WRITE_DESCRIPTOR_SET;
+  write_descriptor_set.dstSet = descriptor_set_dest;
+  write_descriptor_set.descriptorCount = 1;
+  write_descriptor_set.descriptorType = VK_DESCRIPTOR_TYPE_STORAGE_BUFFER;
+  write_descriptor_set.pBufferInfo = &dest_buffer_info;
+  dfn.vkUpdateDescriptorSets(device, 1, &write_descriptor_set, 0, nullptr);
+
+  for (const Item& item : items) {
+    VulkanRenderTarget& source_rt = *item.source;
+    if (source_rt.current_stage_mask() & VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT &&
+        source_rt.current_layout() == VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL &&
+        !(source_rt.current_access_mask() & ~VK_ACCESS_SHADER_READ_BIT)) {
+      continue;
+    }
+    command_processor_.PushImageMemoryBarrier(
+        source_rt.image(),
+        ui::vulkan::util::InitializeSubresourceRange(
+            source_rt.key().is_depth ? (VK_IMAGE_ASPECT_DEPTH_BIT | VK_IMAGE_ASPECT_STENCIL_BIT)
+                                     : VK_IMAGE_ASPECT_COLOR_BIT),
+        source_rt.current_stage_mask(), VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT,
+        source_rt.current_access_mask(), VK_ACCESS_SHADER_READ_BIT, source_rt.current_layout(),
+        VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL);
+    source_rt.SetUsage(VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT, VK_ACCESS_SHADER_READ_BIT,
+                       VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL);
+  }
+  command_processor_.SubmitBarriers(true);
+
+  DeferredCommandBuffer& command_buffer = command_processor_.deferred_command_buffer();
+  int32_t bound_depth = -1;
+  VkDescriptorSet bound_source = VK_NULL_HANDLE;
+  for (const Item& item : items) {
+    RenderTargetKey source_key = item.source->key();
+    int32_t depth = int32_t(source_key.is_depth);
+    if (depth != bound_depth) {
+      bound_depth = depth;
+      bound_source = VK_NULL_HANDLE;
+      command_processor_.BindExternalComputePipeline(stencil_transfer_pipelines_[depth]);
+      command_buffer.CmdVkBindDescriptorSets(VK_PIPELINE_BIND_POINT_COMPUTE,
+                                             stencil_transfer_pipeline_layouts_[depth], 0, 1,
+                                             &descriptor_set_dest, 0, nullptr);
+    }
+    VkDescriptorSet source_set = item.source->GetDescriptorSetTransferSource();
+    if (source_set != bound_source) {
+      bound_source = source_set;
+      command_buffer.CmdVkBindDescriptorSets(VK_PIPELINE_BIND_POINT_COMPUTE,
+                                             stencil_transfer_pipeline_layouts_[depth], 1, 1,
+                                             &source_set, 0, nullptr);
+    }
+    TransferAddressConstant address_constant;
+    address_constant.constant = 0;
+    address_constant.dest_pitch = dest_key.GetPitchTiles();
+    address_constant.source_pitch = source_key.GetPitchTiles();
+    address_constant.source_to_dest = int32_t(dest_key.base_tiles) - int32_t(source_key.base_tiles);
+    uint32_t push[5] = {
+        address_constant.constant,
+        item.rectangle.x_pixels | (item.rectangle.y_pixels << 16),
+        item.rectangle.width_pixels | (item.rectangle.height_pixels << 16),
+        item.offset_dwords,
+        item.row_dwords,
+    };
+    command_buffer.CmdVkPushConstants(stencil_transfer_pipeline_layouts_[depth],
+                                      VK_SHADER_STAGE_COMPUTE_BIT, 0, sizeof(push), push);
+    command_buffer.CmdVkDispatch((item.row_dwords + 7) / 8,
+                                 (item.rectangle.height_pixels + 7) / 8, 1);
+  }
+
+  command_processor_.PushBufferMemoryBarrier(
+      scratch.buffer(), 0, VK_WHOLE_SIZE, VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT,
+      VK_PIPELINE_STAGE_TRANSFER_BIT, VK_ACCESS_SHADER_WRITE_BIT, VK_ACCESS_TRANSFER_READ_BIT);
+  scratch.SetStageMask(VK_PIPELINE_STAGE_TRANSFER_BIT);
+  scratch.SetAccessMask(VK_ACCESS_TRANSFER_READ_BIT);
+
+  // The copy regions, also used by the verification for reading back what the
+  // per-bit draws write, at the same offsets in the second half of its buffer.
+  stencil_transfer_regions_.clear();
+  uint32_t region_base = verify ? (kVerifyBufferSize >> 1) + stencil_verify_used_ : 0;
+  for (const Item& item : items) {
+    VkBufferImageCopy& region = stencil_transfer_regions_.emplace_back();
+    region.bufferOffset = region_base + VkDeviceSize(item.offset_dwords) * 4;
+    region.bufferRowLength = item.row_dwords * 4;
+    region.bufferImageHeight = 0;
+    region.imageSubresource.aspectMask = VK_IMAGE_ASPECT_STENCIL_BIT;
+    region.imageSubresource.mipLevel = 0;
+    region.imageSubresource.baseArrayLayer = 0;
+    region.imageSubresource.layerCount = 1;
+    region.imageOffset.x = int32_t(item.rectangle.x_pixels);
+    region.imageOffset.y = int32_t(item.rectangle.y_pixels);
+    region.imageOffset.z = 0;
+    region.imageExtent.width = item.rectangle.width_pixels;
+    region.imageExtent.height = item.rectangle.height_pixels;
+    region.imageExtent.depth = 1;
+  }
+
+  if (verify) {
+    // Keep the compute bytes, and let the per-bit draws do the transfer.
+    command_processor_.SubmitBarriers(true);
+    VkBufferCopy copy;
+    copy.srcOffset = 0;
+    copy.dstOffset = stencil_verify_used_;
+    copy.size = VkDeviceSize(total_dwords) * 4;
+    command_buffer.CmdVkCopyBuffer(scratch.buffer(), stencil_verify_buffer_, 1, &copy);
+    for (const Item& item : items) {
+      TransferAddressConstant address_constant;
+      address_constant.constant = 0;
+      address_constant.dest_pitch = dest_key.GetPitchTiles();
+      address_constant.source_pitch = item.source->key().GetPitchTiles();
+      address_constant.source_to_dest =
+          int32_t(dest_key.base_tiles) - int32_t(item.source->key().base_tiles);
+      verify_records.push_back({stencil_verify_used_ + item.offset_dwords * 4,
+                                item.row_dwords * 4 * item.rectangle.height_pixels,
+                                uint32_t(item.source->key().is_depth), item.rectangle.x_pixels,
+                                item.rectangle.y_pixels, item.rectangle.width_pixels,
+                                item.rectangle.height_pixels, address_constant.constant});
+    }
+    stencil_verify_used_ += total_dwords * 4;
+    return false;
+  }
+
+  VkImageSubresourceRange both_aspects = ui::vulkan::util::InitializeSubresourceRange(
+      VK_IMAGE_ASPECT_DEPTH_BIT | VK_IMAGE_ASPECT_STENCIL_BIT);
+  command_processor_.PushImageMemoryBarrier(
+      dest_rt.image(), both_aspects, dest_rt.current_stage_mask(), VK_PIPELINE_STAGE_TRANSFER_BIT,
+      dest_rt.current_access_mask(), VK_ACCESS_TRANSFER_WRITE_BIT, dest_rt.current_layout(),
+      VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL);
+  command_processor_.SubmitBarriers(true);
+  command_buffer.CmdVkCopyBufferToImage(scratch.buffer(), dest_rt.image(),
+                                        VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL,
+                                        uint32_t(stencil_transfer_regions_.size()),
+                                        stencil_transfer_regions_.data());
+  stencil_transfer_regions_.clear();
+  VkPipelineStageFlags draw_stage_mask;
+  VkAccessFlags draw_access_mask;
+  VkImageLayout draw_layout;
+  dest_rt.GetDrawUsage(&draw_stage_mask, &draw_access_mask, &draw_layout);
+  command_processor_.PushImageMemoryBarrier(
+      dest_rt.image(), both_aspects, VK_PIPELINE_STAGE_TRANSFER_BIT, draw_stage_mask,
+      VK_ACCESS_TRANSFER_WRITE_BIT, draw_access_mask, VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL,
+      draw_layout);
+  dest_rt.SetUsage(draw_stage_mask, draw_access_mask, draw_layout);
+  return true;
+}
