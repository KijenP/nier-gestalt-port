-      a_.OpMovC(ps_dest, dxbc::Src::R(system_temp_ps_pc_p0_a0_, dxbc::Src::kZZZZ),
-                dxbc::Src::LF(0.0f), operand_0_a);
-      break;
-
-    case AluScalarOpcode::kKillsEq:
-      a_.OpEq(ps_dest, operand_0_a, dxbc::Src::LF(0.0f));
