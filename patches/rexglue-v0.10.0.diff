+// Texture replacement hook (mods): before a texture is uploaded from guest memory, its
+// identity key is computed from the first bytes of its data plus width/height/format. If the
+// provider returns replacement bytes for that key, they are copied over the guest memory
+// (same layout as the original data, base level followed by mips) before the GPU upload.
+inline uint64_t GuestTextureKey(const uint8_t* data, uint32_t width, uint32_t height,
+                                uint32_t format) {
+  uint64_t h = 1469598103934665603ull;
+  for (uint32_t i = 0; i < 256; ++i) {
+    h ^= data[i];
+    h *= 1099511628211ull;
+  }
+  h ^= (uint64_t(width) << 32) | (uint64_t(height) << 8) | format;
+  h *= 1099511628211ull;
+  return h;
+}
+constexpr uint32_t kGuestTextureKeyBytes = 256;
+// The hook itself lives in the runtime library (it is shared between the game and the GPU plugin).
